#!/usr/bin/env python3
"""check-discovery-claim (CB-142, F-08) — discovery is carried, never
fired, and the tree must keep saying so.

`policies/skill-selection.yaml` declares 94 `discovery` triggers. They
name evidence a specialist can only see once it opens a file: `@Entity`
in a source file means the hibernate-jpa skill is the one this task
needs, and no amount of reading the request text could have said so.

The tree therefore does exactly one thing with them. `select-agents`
carries the pairs belonging to the rules that matched into the Task
Block of each role that owns them, one hop, so the trigger is in the
specialist's window before it starts reading. Whether a trigger fires
is decided by the file, and loading the skill is the specialist's act.
No hook watches for the token. No script loads a skill.

That distinction is the design, and it is only honest while both halves
agree:

  the tree carries but does not fire  <->  the policy claims no more

This checker holds those two halves together.

  C-1  one emitter, no firing. Nothing under `scripts/`,
       `plugins/cereblnk/scripts/` or `plugins/cereblnk/hooks/` touches
       `discovery` except the parser, the validators in VALIDATORS, and
       the emitters in EMITTERS. A hook is refused outright, whatever it
       is added to: hooks run on events, so a hook reading these
       triggers would be firing them, which is the one thing this design
       does not do.
  C-2  the map declares its own status — the schema header carries the
       marker verbatim, so the reader of the data learns it from the
       data.
  C-3  `agent-selection-policy.md` §4c carries the same marker, so the
       prose and the data cannot drift apart silently.

C-1 stays the forcing function. Adding automatic loading fails it by
name, and the only way back to green is to change what C-2 and C-3
oblige the map and the policy to say — which is the honest edit that
such a mechanism would owe its readers. A rule without a checker is a
wish; so is a non-rule that reads like one.

Exit: 0 the tree and the claim agree · 1 they do not (each printed
with its C-id).
"""
import pathlib
import sys

ROOT = pathlib.Path(__file__).resolve().parents[3]
PLUGIN = ROOT / "plugins/cereblnk"
MAP = PLUGIN / "policies/skill-selection.yaml"
POLICY = PLUGIN / "policies/agent-selection-policy.md"

# The one sentence both files must carry. Deliberately a full clause and
# not a bare adjective, which survives an edit that guts the meaning
# around it.
MARKER = "carried into the Task Block; loading remains an agent decision on evidence"

# Files permitted to read `discovery` to judge the triggers, never to act
# on them.
VALIDATORS = {
    "plugins/cereblnk/scripts/lib/cbmap.py",         # the parser itself
    "plugins/cereblnk/scripts/check-agent-skills",   # A-5: targets resolve
    "scripts/test-discovery",                        # D-1..D-4: tokens occur
    "plugins/cereblnk/scripts/check-discovery-claim",  # this checker
}

# Files permitted to put the triggers in front of a specialist. Carrying
# a pair into a Task Block is not firing it — the file decides that, and
# the specialist decides what to load.
EMITTERS = {
    "plugins/cereblnk/scripts/select-agents",        # one hop, matched rules only
}

SCAN_ROOTS = ("scripts", "plugins/cereblnk/scripts", "plugins/cereblnk/hooks")
CONSUMES = ("discovery_pairs", '"discovery"', "'discovery'", "discovery:")


def main():
    bad = 0

    for name, path in (("map", MAP), ("policy", POLICY)):
        if not path.is_file():
            print(f"check-discovery-claim: {name} missing at {path}", file=sys.stderr)
            return 1

    # C-1 -------------------------------------------------------------
    for root in SCAN_ROOTS:
        base = ROOT / root
        if not base.is_dir():
            continue
        for p in sorted(base.rglob("*")):
            if not p.is_file():
                continue
            rel = p.relative_to(ROOT).as_posix()
            is_hook = rel.startswith("plugins/cereblnk/hooks/")
            if rel in VALIDATORS or (rel in EMITTERS and not is_hook):
                continue
            try:
                text = p.read_text(encoding="utf-8")
            except (OSError, UnicodeDecodeError):
                continue
            hit = next((c for c in CONSUMES if c in text), None)
            if hit is None:
                continue
            if is_hook:
                print(f"C-1 {rel}: a hook reads discovery ({hit!r}). Hooks run on "
                      f"events, so this fires the trigger instead of carrying it, "
                      f"and no declaration makes that allowed — the map and §4c "
                      f"say the load is the agent decision")
            else:
                print(f"C-1 {rel}: script touches discovery ({hit!r}) and is "
                      f"declared neither validator nor emitter — add it to "
                      f"VALIDATORS if it only judges the triggers, to EMITTERS if "
                      f"it carries them to a specialist, and if it loads a skill "
                      f"by itself change what C-2/C-3 oblige the map and §4c to say")
            bad += 1

    # C-2 / C-3 -------------------------------------------------------
    if MARKER not in MAP.read_text(encoding="utf-8"):
        print(f"C-2 {MAP.relative_to(ROOT)}: schema header does not carry the "
              f"marker {MARKER!r} — the data must state its own status")
        bad += 1

    ptext = POLICY.read_text(encoding="utf-8")
    section = ptext.split("## 4c.", 1)[-1].split("\n## ", 1)[0] if "## 4c." in ptext else ""
    if not section:
        print(f"C-3 {POLICY.relative_to(ROOT)}: no §4c section found")
        bad += 1
    elif MARKER not in section:
        print(f"C-3 {POLICY.relative_to(ROOT)}: §4c does not carry the marker "
              f"{MARKER!r} — the prose still lets discovery read as a step that "
              f"fires on its own")
        bad += 1

    print("check-discovery-claim: triggers are carried, not fired; "
          f"{len(VALIDATORS)} validator(s), {len(EMITTERS)} emitter(s), "
          + ("tree and claim agree" if bad == 0 else f"{bad} VIOLATIONS"))
    return 1 if bad else 0


if __name__ == "__main__":
    sys.exit(main())
