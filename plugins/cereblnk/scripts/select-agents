#!/usr/bin/env bash
# select-agents (CB-081/CB-097) emits the deterministic routing floor; policy handles semantics paths lack.
# CB-143: stack tokens once only vetoed skills, so confirmed stacks added nothing to routed roles.
# Usage: select-agents <file>...
#        git diff --name-only main... | select-agents
#        select-agents --text "add idempotency to the payment service"
#        select-agents --text "<request>" -- <file>...
#        select-agents --roster   # spawnable names + declared decision
#                                  # domains; no selection is run
# Output: YAML (specialists, gate_level, skills_required, signals).
# Exit: 0 resolved · 2 usage error · 3 unresolved (no signal matched —
#       stdout carries `unresolved: true` and the roster in place of a
#       specialist; the conductor picks a role from it and cites the
#       roster line, rather than receiving a silent default).
set -euo pipefail
CB_SCRIPTS="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/cbenv.sh
. "$CB_SCRIPTS/lib/cbenv.sh"
cb_require_python
CB_LIB="$CB_SCRIPTS/lib"

CB_EMIT=""
if [ "${1:-}" = "--emit-floor" ]; then CB_EMIT=1; shift; fi

# --roster exposes spawnable names and decision domains without running selection.
CB_ROSTER=""
if [ "${1:-}" = "--roster" ]; then CB_ROSTER=1; shift; fi

CB_TEXT=""
if [ "${1:-}" = "--text" ]; then
  [ $# -ge 2 ] || { echo "select-agents: --text needs a request string" >&2; exit 2; }
  CB_TEXT="$2"; shift 2
  [ "${1:-}" = "--" ] && shift
fi
if [ $# -ge 1 ]; then CB_PATHS="$(printf '%s\n' "$@")"
elif [ -n "$CB_TEXT" ]; then CB_PATHS=""
elif [ -n "$CB_ROSTER" ]; then CB_PATHS=""
else CB_PATHS="$(cat)"; fi
# Persist floors only to a pinned run; guessing the judge's destination splits ledgers.
CB_RUN=""
if [ -n "$CB_EMIT" ] && [ -n "${CB_DIR:-}" ] && [ -s "$CB_DIR/flags/run-active" ]; then
  CB_RUN="$(cb_run_dir)"
fi
export CB_PATHS CB_TEXT CB_LIB CB_EMIT CB_RUN CB_ROSTER
$PYBIN << 'PY'
import os, pathlib, re, sys

sys.path.insert(0, os.environ["CB_LIB"])
import cbmap  # noqa: E402


# Keep only each description's decision-domain opening; all 27 full fields total ~830 words.
def _agent_description(path):
    """First sentence of the frontmatter `description:`, or '' if none.

    The value may fold across lines with no extra indent; those lines
    are joined with spaces before the first sentence is taken.
    """
    try:
        text = path.read_text(encoding="utf-8")
    except OSError:
        return ""
    if not text.startswith("---"):
        return ""
    end = text.find("\n---", 3)
    fm = text[3:end] if end != -1 else text[3:]
    desc_lines, capture = [], False
    for line in fm.splitlines():
        if capture:
            if re.match(r'^[A-Za-z_][\w-]*:\s', line):
                break
            desc_lines.append(line)
            continue
        m = re.match(r'^description:\s*(.*)$', line)
        if m:
            capture = True
            desc_lines.append(m.group(1))
    desc = " ".join(d.strip() for d in desc_lines).strip()
    if not desc:
        return ""
    cut = desc.find(". ")
    return desc[:cut + 1] if cut != -1 else desc


def _build_roster():
    """[(stem, qualified_name, decision_domain), ...], sorted by stem.

    Shared by --roster and the unresolved path below: both hand the
    conductor what select-agents already knows how to spawn, next to
    what each role decides, so a job is matched to a role without
    opening 27 agent files.
    """
    agent_dir = pathlib.Path(os.environ["CB_LIB"]).resolve().parent.parent / "agents"
    roster = []
    if agent_dir.is_dir():
        for f in agent_dir.rglob("*-agent.md"):
            qname = "cereblnk:%s:%s" % (f.parent.name, f.stem)
            desc = _agent_description(f) or "(no description declared in frontmatter)"
            roster.append((f.stem, qname, desc))
    return sorted(roster)


ROSTER = None


def _roster():
    """Build the shared roster only for paths that need its domains."""
    global ROSTER
    if ROSTER is None:
        ROSTER = _build_roster()
    return ROSTER


def _print_roster():
    print("roster:")
    for _stem, _qname, _desc in _roster():
        _esc = _desc.replace("\\", "\\\\").replace('"', '\\"')
        print('  %s: "%s"' % (_qname, _esc))


if os.environ.get("CB_ROSTER"):
    print("# select-agents --roster — spawnable name and declared decision "
          "domain, no selection performed")
    _print_roster()
    raise SystemExit(0)


RULES = [
    # (name, path regex, agents, gate floor)
    ("auth/security surface", r'(?i)(auth|security|jwt|oauth|token|session|crypt|secret|login|permission|acl|filterchain)',
     ["security-agent"], 3),
    ("schema/migration",      r'(?i)(\.sql$|liquibase|migration|flyway|changelog.*\.(xml|ya?ml)$)',
     ["database-agent", "security-agent"], 3),
    ("terraform state",       r'\.tf(vars)?$',
     ["infra-agent", "security-agent"], 3),
    ("container/orchestration", r'(?i)(dockerfile|docker-compose|/k8s/|kubernetes|/helm/|chart\.ya?ml$|nginx.*\.conf$)',
     ["infra-agent"], 2),
    ("ci/cd pipeline",        r'(?i)(jenkinsfile|\.github/workflows/|bitbucket-pipelines\.ya?ml$|\.gitlab-ci)',
     ["infra-agent"], 2),
    ("ui surface",            r'(?i)(\.(tsx|jsx|vue|svelte|css|scss|less|html)$|/components?/|/pages?/|/frontend/)',
     ["frontend-agent"], 1),
    ("server-side code",      r'(?i)(\.(java|kt|kts|go|py|rb|cs|scala)$|/src/main/|/server/|/api/)',
     ["backend-agent"], 1),
    ("plain js/ts backend",   r'(?i)\.(js|ts|mjs|cjs)$',
     ["backend-agent"], 1),   # only if no UI rule matched the same file (handled below)
    ("test surface",          r'(?i)(/tests?/|\.test\.|\.spec\.|_test\.(go|py)$|Test\.java$)',
     ["qa-agent"], 1),
    # F-21: shell, YAML, and XML had skill rows but no role-routing rows, so resolved to nothing.
    ("shell/automation",      r'(?i)(\.(sh|bash|zsh)$|(^|/)Makefile$|(^|/)Justfile$)',
     ["infra-agent"], 2),
    ("config/serialisation",  r'(?i)\.(ya?ml|toml|ini|properties|xml)$',
     ["infra-agent"], 2),
    # F-21: AI configuration is an authored-document surface, not a code surface.
    ("ai configuration",      r'(?i)((^|[/\\])\.claude([/\\]|$)|(^|[/\\])CLAUDE\.md$|(^|[/\\])GUIDELINES\.md$|(^|[/\\])(agents|skills)[/\\].*\.md$)',
     ["technicalwriter-agent"], 1),
    ("documentation",         r'(?i)\.md$',
     ["docs-agent"], 1),
    # Documentation routes by ownership: docs-agent reviews; technicalwriter-agent authors.
    # Match both separators because host payloads preserve platform paths.
    ("authored documentation", r'(?i)(?:^|[/\\])memory[/\\](specs|briefs)[/\\]',
     ["technicalwriter-agent"], 1),
]
# Adding three rules silently repointed former indexes 5 and 10; address growing tables by name.
def _rx(name):
    for n, rx, _ag, _gl in RULES:
        if n == name:
            return re.compile(rx)
    raise SystemExit("select-agents: no rule named %r" % name)


UI = _rx("ui surface")
AUTHORED = _rx("authored documentation")

# Signals a path cannot carry. Text RAISES the floor, never lowers it —
# "just a small expiry bump" is still auth.

TEXT_RULES = [
    ("money/payment",  r'(?i)(payment|billing|invoic|charge|refund|checkout)',
     ["backend-agent", "security-agent"], 3),
    ("auth/session",   r'(?i)(auth|login|token|session|permission|secret|credential|crypt'
                       r'|password|passwd|plaintext'
                       r'|\bhashed\b|\bhashing\b|\bsalted\b)',
     ["security-agent"], 3),
    ("deletion/retention", r'(?i)(delete|purge|retention|drop table)',
     ["database-agent", "security-agent"], 3),
    ("schema/migration", r'(?i)(migration|schema|changeset|liquibase|flyway)',
     ["database-agent"], 3),
    ("ui/experience",  r'(?i)(\bui\b|screen|page|component|form)',
     ["frontend-agent"], 1),
    ("api contract",   r'(?i)(\bapi\b|endpoint|contract|versioning)',
     ["apidesign-agent"], 2),
    # CB-143/F-07: endpoint requests selected the designer but omitted the backend implementer.
    # This work-semantic row unions both roles; bare "repository" stays configuration.
    ("server-side behavior",
     r'(?i)(endpoint|\bhandler\b|controller|[A-Za-z]*[Ss]ervices?\b|\bbackend\b|server-?side|business logic|persist|background job|\bworker\b|\bcron\b|webhook|\bmiddleware\b)',
     ["backend-agent"], 2),
    ("infrastructure", r'(?i)(deploy|cluster|container|pipeline|terraform|helm|kubernetes)',
     ["infra-agent"], 2),
    ("performance",    r'(?i)(slow|latency|throughput|performance)',
     ["performance-agent"], 2),
    ("restructure",    r'(?i)(refactor|restructur|clean\s*up|\bcleanup\b'
                       r'|simplif|extract\s+(a\s+)?(method|class|function|module))',
     ["refactoring-agent"], 1),
    ("tests",          r'(?i)(\btests?\b|\btesting\b|coverage|regression)',
     ["qa-agent"], 1),
    ("documentation",  r'(?i)(\bdocs?\b|documentation|readme|changelog|docstring'
                       r'|\bguide\b|tutorial)',
     ["docs-agent"], 1),
    # Rewrites select the analyst from request text because no diff exists yet.
    ("rewrite/legacy", r'(?i)(rewrite|re-?write|legacy|modernis|moderniz|from scratch|redesign)',
     ["legacy-analyst-agent", "architect-agent"], 3),
]

paths = [l.strip() for l in os.environ.get("CB_PATHS", "").splitlines() if l.strip()]
text = os.environ.get("CB_TEXT", "")
if not paths and not text:
    print("select-agents: no paths on stdin/argv and no --text", file=sys.stderr)
    raise SystemExit(2)

agents, level, signals, domains = [], 1, [], set()


def add(agent_list, gl, signal):
    global level
    for a in agent_list:
        if a not in agents:
            agents.append(a)
    domains.add(agent_list[0])
    level = max(level, gl)
    signals.append(signal)


for p in paths:
    for name, rx, ag, gl in RULES:
        if name == "plain js/ts backend" and UI.search(p):
            continue
        # An authored spec is not also a diff-driven documentation review.
        if name == "documentation" and AUTHORED.search(p):
            continue
        if re.search(rx, p):
            add(ag, gl, "%s -> %s" % (p, name))
if text:
    for name, rx, ag, gl in TEXT_RULES:
        if re.search(rx, text):
            add(ag, gl, "text -> %s" % name)

# multi-domain work is at least level 2 even without an L3 signal
if len(domains) >= 2:
    level = max(level, 2)

# ---- stack profile: absent means no stack gate, never a wrong guess ----
stack, stack_note = None, "none — stack gate not applied (run scripts/detect-stack)"
cbdir = os.environ.get("CB_DIR") or ""
if cbdir:
    sp = pathlib.Path(cbdir) / "context/stack-profile.yaml"
    if sp.exists():
        head = sp.read_text(encoding="utf-8").split("manifests:")[0]
        stack = set(re.findall(r"^\s+-\s+(\S+)\s*$", head, re.M))
        stack_note = "stack-profile.yaml (%d tokens)" % len(stack)

rules, errors = cbmap.load()
if errors:
    for e in errors[:5]:
        print("select-agents: skill-selection.yaml: %s" % e, file=sys.stderr)
    raise SystemExit(2)

skills, skill_why = {}, []
# Discovery is one hop; transitive closure from Java reaches 29 unrelated pairs via generic hubs.
watch = {}


def watch_add(rule):
    for role in rule["roles"]:
        seen = watch.setdefault(role, [])
        for pair in cbmap.discovery_pairs(rule):
            if pair not in seen:
                seen.append(pair)


for r in rules:
    if stack is not None and r["stack"] and r["stack"] not in stack:
        continue                      # declared for a stack this project does not have
    hit = None
    for rx in r["paths"]:
        for p in paths:
            if re.search(rx, p):
                hit = "path %s" % p
                break
        if hit:
            break
    if not hit and text:
        low = text.lower()
        for t in r["topics"]:
            # Word-bounded; the topic is escaped, not a pattern.
            if re.search(r'(?<!\w)%s(?!\w)' % re.escape(t.lower()), low):
                hit = "topic '%s'" % t
                break
    if not hit:
        continue
    # The head of `roles:` owns the skill; the rest only receive it.
    if not any(role in agents for role in r["roles"]):
        add(r["roles"][:1], 1, "%s -> %s (skill map)" % (hit, r["roles"][0]))
    for role in r["roles"]:
        skills.setdefault(role, [])
        if r["skill"] not in skills[role]:
            skills[role].append(r["skill"])
    skill_why.append("%s <- %s" % (r["skill"], hit))
    watch_add(r)

# CB-143/F-07: confirmed stack skills complete roles already routed; they never add roles.
# Absent profiles disable completion, and unresolved requests remain unresolved.
if stack:
    for r in rules:
        if not r["stack"] or r["stack"] not in stack:
            continue
        for role in r["roles"]:
            if role not in agents:
                continue
            skills.setdefault(role, [])
            if r["skill"] not in skills[role]:
                skills[role].append(r["skill"])
                skill_why.append("%s <- stack token '%s' in profile, for %s"
                                 % (r["skill"], r["stack"], role))
                watch_add(r)

if not agents:
    # No path/text rule matched: emit no guess, hand off the roster, and require a cited choice.
    # Mandatory risk signals match before this branch or are absent from the request.
    print("unresolved: true   # no rule matched")
    if text:
        print("reason: --text was supplied and no rule matched it — the "
              "request names no surface")
    else:
        print("reason: no path rule matched")
    print("next: name a repository path and re-run (select-agents <path>) "
          "if the request has one — a path carries the surface a verb "
          "cannot. Otherwise pick a role from the roster below and record "
          "the roster line your choice rests on.")
    _print_roster()
    raise SystemExit(3)

print("# select-agents — floor, never a ceiling (policy §1/§3b/§4c authoritative)")
# CB-132: bare names caused four failed spawns; emit plugin:directory:file names.
# The heredoc makes __file__ caller-relative, so derive the plugin root from exported CB_LIB.
AGENT_DIR = pathlib.Path(os.environ["CB_LIB"]).resolve().parent.parent / "agents"
_QUALIFIED = {}
if AGENT_DIR.is_dir():
    for _f in AGENT_DIR.rglob("*-agent.md"):
        _QUALIFIED[_f.stem] = "cereblnk:%s:%s" % (_f.parent.name, _f.stem)


def qualify(name):
    """docs-agent -> cereblnk:engineering:docs-agent, or unchanged."""
    return _QUALIFIED.get(name, name)


print("specialists:")
mandated_agents = list(agents)
if level == 3:
    mandated_agents.append("challenger-agent")
for a in mandated_agents:
    if a == "challenger-agent" and level == 3:
        print("  - %s   # mandatory at gate level 3" % qualify(a))
    else:
        print("  - %s" % qualify(a))
print("gate_level: %d" % level)
print("stack_source: %s" % stack_note)
floor_lines = []
for role in agents:
    got = skills.get(role) or []
    if got:
        floor_lines.append("  %s: [%s]" % (qualify(role), ", ".join(got)))
    else:
        floor_lines.append("  %s: []   # no skill signal for this role" % qualify(role))
print("skills_required:")
for line in floor_lines:
    print(line)

# --emit-floor is opt-in and silent without a pinned destination; queries create no files.
if os.environ.get("CB_EMIT"):
    run = (os.environ.get("CB_RUN") or "").rstrip("/")
    if not run:
        print("emit_floor: skipped — no run is armed with an id "
              "(scripts/run-flag arm \"\" <run_id>). The floor is not "
              "written to a guessed directory.", file=sys.stderr)
    else:
        skill_dest = pathlib.Path(run) / "skills-required.yaml"
        agent_dest = pathlib.Path(run) / "agents-required.yaml"
        roster_domains = {stem: desc for stem, _qname, desc in _roster()}
        agent_lines = []
        for role in mandated_agents:
            desc = (roster_domains.get(role)
                    or "(no description declared in frontmatter)")
            escaped = desc.replace("\\", "\\\\").replace('"', '\\"')
            agent_lines.append("  - agent: %s" % qualify(role))
            agent_lines.append('    domain: "%s"' % escaped)
        try:
            skill_dest.parent.mkdir(parents=True, exist_ok=True)
            skill_dest.write_text(
                "skills_required:\n" + "\n".join(floor_lines) + "\n",
                encoding="utf-8")
            # A plan-less run has no other on-disk risk signal; GateFloor
            # reads this when there is no plan.md to take it from.
            agent_dest.write_text(
                "agents_required:\n" + "\n".join(agent_lines) + "\n"
                + "gate_level: %d\n" % level,
                encoding="utf-8")
            print("emit_floor: %s" % skill_dest)
            print("emit_agents: %s" % agent_dest)
        except OSError as e:
            print("emit_floor: could NOT write required run inputs (%s) — "
                  "the selection has no durable floor." % e,
                  file=sys.stderr)
            raise SystemExit(1)
# File-content triggers travel in the Task Block; selection cannot resolve them before reading.
watch_lines = []
for role in agents:
    got = watch.get(role) or []
    if got:
        watch_lines.append("  %s:" % qualify(role))
        for tok, tgt in got:
            watch_lines.append("    - \"%s -> %s\"" % (tok, tgt))
if watch_lines:
    print("discovery_watch:   # one hop from the matched rule, not the full cascade; seen while reading -> load that skill")
    for line in watch_lines:
        print(line)

print("signals:")
for s in signals:
    print("  - \"%s\"" % s)
for s in skill_why:
    print("  - \"%s\"" % s)
PY
