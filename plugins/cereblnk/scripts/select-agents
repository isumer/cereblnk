#!/usr/bin/env bash
# select-agents (CB-081, extended CB-097) — deterministic specialist AND
# skill selection, the scriptable subset of agent-selection-policy.md
# §1 + §3b + §4c.
#
# A weak conductor pipes `git diff --name-only <range>` in and reads the
# answer instead of reasoning about the routing table. The policy stays
# authoritative for signals a path cannot carry (task semantics, money,
# prod-config intent); this script never DOWNGRADES — it emits the floor.
#
# CB-097 adds two things paths alone could not do:
#   --text  route from the REQUEST when nothing has changed yet (design,
#           new build). A path-only selector is blind at exactly the
#           moment a spec is being written.
#   skills_required  per role, from policies/skill-selection.yaml, gated
#           by the stack profile. The agent loads these at run start;
#           SubagentStop blocks the run if it did not.
#
# CB-143 adds the missing direction. A stack token was a veto only, so
# a project being a Spring Boot project never PUT a skill on a role. A
# role already routed now also receives the stack-declared skills its
# own map rules own (bounded stack completion, below), and a TEXT rule
# names server-side behaviour so the implementer is routed at all.
#
# Usage: select-agents <file>...
#        git diff --name-only main... | select-agents
#        select-agents --text "add idempotency to the payment service"
#        select-agents --text "<request>" -- <file>...
# Output: YAML (specialists, gate_level, skills_required, signals).
# Exit: 0 resolved · 2 usage error · 3 unresolved (no signal matched —
#       the conductor must supply --text or name the surface; silently
#       defaulting to one agent is how a run gets the wrong specialist).
set -euo pipefail
CB_SCRIPTS="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/cbenv.sh
. "$CB_SCRIPTS/lib/cbenv.sh"
cb_require_python
CB_LIB="$CB_SCRIPTS/lib"

CB_EMIT=""
if [ "${1:-}" = "--emit-floor" ]; then CB_EMIT=1; shift; fi

CB_TEXT=""
if [ "${1:-}" = "--text" ]; then
  [ $# -ge 2 ] || { echo "select-agents: --text needs a request string" >&2; exit 2; }
  CB_TEXT="$2"; shift 2
  [ "${1:-}" = "--" ] && shift
fi
if [ $# -ge 1 ]; then CB_PATHS="$(printf '%s\n' "$@")"
elif [ -n "$CB_TEXT" ]; then CB_PATHS=""
else CB_PATHS="$(cat)"; fi
# The floor is what judges the subagent, so it is written only to a
# PINNED run — cb_run_dir falls back to a newest-directory guess, and a
# guessed destination for the judge's own input is how a ledger splits.
CB_RUN=""
if [ -n "$CB_EMIT" ] && [ -n "${CB_DIR:-}" ] && [ -s "$CB_DIR/flags/run-active" ]; then
  CB_RUN="$(cb_run_dir)"
fi
export CB_PATHS CB_TEXT CB_LIB CB_EMIT CB_RUN
$PYBIN << 'PY'
import os, pathlib, re, sys

sys.path.insert(0, os.environ["CB_LIB"])
import cbmap  # noqa: E402

RULES = [
    # (name, path regex, agents, gate floor)
    ("auth/security surface", r'(?i)(auth|security|jwt|oauth|token|session|crypt|secret|login|permission|acl|filterchain)',
     ["security-agent"], 3),
    ("schema/migration",      r'(?i)(\.sql$|liquibase|migration|flyway|changelog.*\.(xml|ya?ml)$)',
     ["database-agent", "security-agent"], 3),
    ("terraform state",       r'\.tf(vars)?$',
     ["infra-agent", "security-agent"], 3),
    ("container/orchestration", r'(?i)(dockerfile|docker-compose|/k8s/|kubernetes|/helm/|chart\.ya?ml$|nginx.*\.conf$)',
     ["infra-agent"], 2),
    ("ci/cd pipeline",        r'(?i)(jenkinsfile|\.github/workflows/|bitbucket-pipelines\.ya?ml$|\.gitlab-ci)',
     ["infra-agent"], 2),
    ("ui surface",            r'(?i)(\.(tsx|jsx|vue|svelte|css|scss|less|html)$|/components?/|/pages?/|/frontend/)',
     ["frontend-agent"], 1),
    ("server-side code",      r'(?i)(\.(java|kt|kts|go|py|rb|cs|scala)$|/src/main/|/server/|/api/)',
     ["backend-agent"], 1),
    ("plain js/ts backend",   r'(?i)\.(js|ts|mjs|cjs)$',
     ["backend-agent"], 1),   # only if no UI rule matched the same file (handled below)
    ("test surface",          r'(?i)(/tests?/|\.test\.|\.spec\.|_test\.(go|py)$|Test\.java$)',
     ["qa-agent"], 1),
    # F-21: shell, YAML and XML resolved to nothing. The journal read
    # this as a regex-compilation fault because skill-selection.yaml
    # defines a shell rule; it does not. That table attaches SKILLS to
    # an agent already chosen. This table CHOOSES the agent, and it had
    # no row for any of the three — so the shell skill could never fire,
    # because nothing was selected for it to attach to.
    #
    # The surfaces that went missing were not arbitrary: infrastructure,
    # configuration and schema. Cereblnk's own tree is mostly shell.
    ("shell/automation",      r'(?i)(\.(sh|bash|zsh)$|(^|/)Makefile$|(^|/)Justfile$)',
     ["infra-agent"], 2),
    ("config/serialisation",  r'(?i)\.(ya?ml|toml|ini|properties|xml)$',
     ["infra-agent"], 2),
    # F-21 second effect, and the gap that started it: a request to
    # restructure the AI configuration itself resolved to nothing, and
    # the two failure messages sent the caller back and forth. Agent,
    # skill and rule files are authored documents about how work is
    # done — the technical writer's surface, not a code surface.
    ("ai configuration",      r'(?i)((^|[/\\])\.claude([/\\]|$)|(^|[/\\])CLAUDE\.md$|(^|[/\\])GUIDELINES\.md$|(^|[/\\])(agents|skills)[/\\].*\.md$)',
     ["technicalwriter-agent"], 1),
    ("documentation",         r'(?i)\.md$',
     ["docs-agent"], 1),
    # Documentation splits by WHO owns the artifact, not by extension.
    # docs-agent reviews docs against a diff inside a code workflow;
    # technicalwriter-agent owns the document when the document IS the
    # deliverable. memory/specs and memory/briefs only exist while one
    # is being authored, so the path settles it. Both separators: the
    # blocked path arrives as the platform wrote it.
    ("authored documentation", r'(?i)(?:^|[/\\])memory[/\\](specs|briefs)[/\\]',
     ["technicalwriter-agent"], 1),
]
# By name, not by index. These were RULES[5] and RULES[10]; adding three
# rows above them silently repointed both at the wrong pattern, and the
# only thing that noticed was a fixture two suites away. A table meant
# to grow must not be addressed by position.
def _rx(name):
    for n, rx, _ag, _gl in RULES:
        if n == name:
            return re.compile(rx)
    raise SystemExit("select-agents: no rule named %r" % name)


UI = _rx("ui surface")
AUTHORED = _rx("authored documentation")

# Signals a path cannot carry. Text RAISES the floor, never lowers it —
# "just a small expiry bump" is still auth.
# When nothing matches, this is the specialist the run gets. architect
# because a request that names no code surface is, by elimination,
# about structure, boundaries or setup — the architect's declared
# domain — and because it decides rather than implements, so an
# inferred choice does the least damage if it is wrong.
FALLBACK_AGENT = "architect-agent"

TEXT_RULES = [
    ("money/payment",  r'(?i)(payment|billing|invoic|charge|refund|checkout)',
     ["backend-agent", "security-agent"], 3),
    ("auth/session",   r'(?i)(auth|login|token|session|permission|secret|credential|crypt'
                       r'|password|passwd|plaintext'
                       r'|\bhashed\b|\bhashing\b|\bsalted\b)',
     ["security-agent"], 3),
    ("deletion/retention", r'(?i)(delete|purge|retention|drop table)',
     ["database-agent", "security-agent"], 3),
    ("schema/migration", r'(?i)(migration|schema|changeset|liquibase|flyway)',
     ["database-agent"], 3),
    ("ui/experience",  r'(?i)(\bui\b|screen|page|component|form)',
     ["frontend-agent"], 1),
    ("api contract",   r'(?i)(\bapi\b|endpoint|contract|versioning)',
     ["apidesign-agent"], 2),
    # CB-143 / F-07. Twenty map rules carry backend-agent and every one
    # of them is a LANGUAGE or FRAMEWORK rule whose topics are
    # technology names -- java, spring boot, jpa. None carries request
    # semantics. So "add a REST endpoint for user registration" matched
    # the contract row and nothing else: the surface's designer was
    # selected and its implementer never was, which §1 (server-side
    # logic -> backend-agent, mandatory) and §3b (the owner of a surface
    # is in every stage that shapes it) both forbid.
    #
    # This row names the WORK, not the stack. It pairs with the contract
    # row rather than replacing it -- union, never max-only (§2.1): the
    # designer owns the contract, the implementer owns the behaviour
    # behind it, and a request for an endpoint asks for both. Level 2 is
    # §1's floor for server-side logic.
    #
    # Deliberately excluded: bare "repository". A request to restructure
    # the repository is configuration, not persistence, and CB-132
    # already paid for routing that case wrongly.
    ("server-side behavior",
     r'(?i)(endpoint|\bhandler\b|controller|[A-Za-z]*[Ss]ervices?\b|\bbackend\b|server-?side|business logic|persist|background job|\bworker\b|\bcron\b|webhook|\bmiddleware\b)',
     ["backend-agent"], 2),
    ("infrastructure", r'(?i)(deploy|cluster|container|pipeline|terraform|helm|kubernetes)',
     ["infra-agent"], 2),
    ("performance",    r'(?i)(slow|latency|throughput|performance)',
     ["performance-agent"], 2),
    ("restructure",    r'(?i)(refactor|restructur|clean\s*up|\bcleanup\b'
                       r'|simplif|extract\s+(a\s+)?(method|class|function|module))',
     ["refactoring-agent"], 1),
    ("tests",          r'(?i)(\btests?\b|\btesting\b|coverage|regression)',
     ["qa-agent"], 1),
    ("documentation",  r'(?i)(\bdocs?\b|documentation|readme|changelog|docstring'
                       r'|\bguide\b|tutorial)',
     ["docs-agent"], 1),
    # A rewrite reads the old code before anything is designed, so the
    # analyst is selected from the request rather than from a diff --
    # there is no diff yet. Level 3: the blast radius is the module.
    ("rewrite/legacy", r'(?i)(rewrite|re-?write|legacy|modernis|moderniz|from scratch|redesign)',
     ["legacy-analyst-agent", "architect-agent"], 3),
]

paths = [l.strip() for l in os.environ.get("CB_PATHS", "").splitlines() if l.strip()]
text = os.environ.get("CB_TEXT", "")
if not paths and not text:
    print("select-agents: no paths on stdin/argv and no --text", file=sys.stderr)
    raise SystemExit(2)

agents, level, signals, domains = [], 1, [], set()


def add(agent_list, gl, signal):
    global level
    for a in agent_list:
        if a not in agents:
            agents.append(a)
    domains.add(agent_list[0])
    level = max(level, gl)
    signals.append(signal)


for p in paths:
    for name, rx, ag, gl in RULES:
        if name == "plain js/ts backend" and UI.search(p):
            continue
        # An authored spec is not also a diff-driven doc review. Adding
        # docs-agent here would not raise a floor, it would name the
        # wrong specialist alongside the right one.
        if name == "documentation" and AUTHORED.search(p):
            continue
        if re.search(rx, p):
            add(ag, gl, "%s -> %s" % (p, name))
if text:
    for name, rx, ag, gl in TEXT_RULES:
        if re.search(rx, text):
            add(ag, gl, "text -> %s" % name)

# multi-domain work is at least level 2 even without an L3 signal
if len(domains) >= 2:
    level = max(level, 2)

# ---- stack profile: absent means no stack gate, never a wrong guess ----
stack, stack_note = None, "none — stack gate not applied (run scripts/detect-stack)"
cbdir = os.environ.get("CB_DIR") or ""
if cbdir:
    sp = pathlib.Path(cbdir) / "context/stack-profile.yaml"
    if sp.exists():
        head = sp.read_text(encoding="utf-8").split("manifests:")[0]
        stack = set(re.findall(r"^\s+-\s+(\S+)\s*$", head, re.M))
        stack_note = "stack-profile.yaml (%d tokens)" % len(stack)

rules, errors = cbmap.load()
if errors:
    for e in errors[:5]:
        print("select-agents: skill-selection.yaml: %s" % e, file=sys.stderr)
    raise SystemExit(2)

skills, skill_why = {}, []
# role -> [(trigger, skill)], one hop from the rules that actually matched.
# Not the transitive closure: chasing it from `java` yields 29 pairs that
# reach React, Redux and express() through generic hubs like docker, which
# is the whole graph rather than a set about this task.
watch = {}


def watch_add(rule):
    for role in rule["roles"]:
        seen = watch.setdefault(role, [])
        for pair in cbmap.discovery_pairs(rule):
            if pair not in seen:
                seen.append(pair)


for r in rules:
    if stack is not None and r["stack"] and r["stack"] not in stack:
        continue                      # declared for a stack this project does not have
    hit = None
    for rx in r["paths"]:
        for p in paths:
            if re.search(rx, p):
                hit = "path %s" % p
                break
        if hit:
            break
    if not hit and text:
        low = text.lower()
        for t in r["topics"]:
            # Word-bounded; the topic is escaped, not a pattern.
            if re.search(r'(?<!\w)%s(?!\w)' % re.escape(t.lower()), low):
                hit = "topic '%s'" % t
                break
    if not hit:
        continue
    # The head of `roles:` owns the skill; the rest only receive it.
    if not any(role in agents for role in r["roles"]):
        add(r["roles"][:1], 1, "%s -> %s (skill map)" % (hit, r["roles"][0]))
    for role in r["roles"]:
        skills.setdefault(role, [])
        if r["skill"] not in skills[role]:
            skills[role].append(r["skill"])
    skill_why.append("%s <- %s" % (r["skill"], hit))
    watch_add(r)

# ---- bounded stack completion (CB-143 / F-07) -------------------------
# In the loop above a declared stack token is a veto: it can only ever
# subtract. A project BEING a Spring Boot project therefore added
# nothing, and a routed backend-agent arrived with an empty skill floor
# unless the request text happened to name the technology. Nobody
# writing "add a REST endpoint for user registration" writes
# "hibernate"; the pom.xml says it instead.
#
# Completion is the narrow inverse: a role the rules ALREADY routed
# gains the skills whose declared stack token the profile confirms.
# Three bounds keep it from becoming "a stack token triggers", the
# version that would load java for a typo fix in a README:
#
#   1. it never adds a ROLE. Only roles already in `agents` gain
#      skills, so the floor's membership is still decided by path and
#      topic rules alone. docs-agent is in no stack rule's roles, so a
#      docs-only change in a Java repository is untouched.
#   2. it fires only for rules that DECLARE a stack token AND only when
#      the profile confirms that token. A rule with no token is
#      unaffected; an absent profile (stack is None) disables it
#      entirely, so the "no stack gate, never a wrong guess" rule above
#      still holds.
#   3. it runs BEFORE the unresolved branch fills `agents` with the
#      inferred fallback, so an unroutable request still gets an empty
#      floor and stays visibly `inferred: true`. Completion must not
#      dress a guess up as a routed answer.
#
# What this buys is the §3b guarantee in mechanism rather than in prose:
# the specialist that owns the surface is selected, and it is selected
# WITH the skill closure that surface needs in this repository.
if stack:
    for r in rules:
        if not r["stack"] or r["stack"] not in stack:
            continue
        for role in r["roles"]:
            if role not in agents:
                continue
            skills.setdefault(role, [])
            if r["skill"] not in skills[role]:
                skills[role].append(r["skill"])
                skill_why.append("%s <- stack token '%s' in profile, for %s"
                                 % (r["skill"], r["stack"], role))
                watch_add(r)

inferred = False
if not agents:
    print("# select-agents — UNRESOLVED (inferred)", file=sys.stderr)
    # The advice differs by what was already tried (CB-124): answering a
    # --text call by asking for a --text call is a loop, and a run that
    # got that sentence twice abandoned the selector.
    #
    # CB-132 removes the second half of that fix. The message also said
    # reading the policy by hand "is not the fallback", which closed the
    # only route a caller had left. The route it offered instead — pass
    # a repository path — does not exist for every surface: a request to
    # restructure `.claude/` or CLAUDE.md names configuration, and the
    # rule table has no configuration surface, so no path resolves. A
    # refusal that forbids the remaining option without opening another
    # is worse than the loop it replaced. Observed as minutes of a run
    # cycling through candidate agents and reaching none.
    #
    # So: say what does not match, name the path route as the better
    # one, and stop forbidding the fallback. Choosing by hand stays
    # visibly worse without being blocked, which is the honest state —
    # a wrong specialist chosen out loud is correctable, a run that
    # cannot proceed at all is not.
    # CB-133: a default, recorded. Refusing produced neither a stopped
    # run nor a question to the user — twice it produced improvisation:
    # once a specialist invented out of a project's skills directory,
    # once minutes of cycling through candidates. The table will always
    # be incomplete, so the case this refusal fires on is permanent, and
    # an unrecorded guess is what the refusal was meant to prevent.
    #
    # A risk gate was considered and dropped as dead code: payment,
    # auth, migration and deploy all resolve through TEXT_RULES already,
    # so a high-risk request never reaches this branch. The one that did
    # — secret rotation — was a missing word in the auth rule, fixed
    # above rather than caught by a second mechanism.
    #
    # What survives is the part that mattered: the choice is not silent.
    # `inferred: true` reaches the Response Block, the Verifier and the
    # ledger, so a wrong default is visible and correctable — which a
    # model choosing quietly never was.
    print("unresolved: true   # no rule matched; the specialist below is inferred",
          file=sys.stderr)
    if text:
        print("reason: --text was supplied and no rule matched it — the "
              "request names no surface", file=sys.stderr)
    else:
        print("reason: no path rule matched", file=sys.stderr)
    print("next: if the request names a symbol, class or file, resolve it "
          "to a repository path and re-run (`select-agents <path>`) — a "
          "path carries the surface a verb cannot, and a routed choice "
          "beats an inferred one. Otherwise proceed with the inferred "
          "specialist and leave `inferred: true` in the plan.",
          file=sys.stderr)
    agents = [FALLBACK_AGENT]
    inferred = True
    signals.append("no rule matched — %s inferred, not routed" % FALLBACK_AGENT)

print("# select-agents — floor, never a ceiling (policy §1/§3b/§4c authoritative)")
# ---- spawnable names (CB-132) ----
# The platform addresses an agent as plugin:directory:file —
# `cereblnk:engineering:docs-agent`. This script owns the roster and
# knows where each file lives, so it is the one place that can say the
# spawnable name. It did not: it emitted `docs-agent`, DelegationGuard
# copied that into `NEXT ACTION: spawn docs-agent`, and a run followed
# the instruction exactly. Four spawns failed with `Agent type
# 'docs-agent' not found`, each answering with the full 27-agent
# roster, until the model worked out the shape from the error text.
#
# Nothing in the tree carried the qualified form — not the agent
# frontmatter, not TOPOLOGY, not the policies. It existed only as a
# directory path nobody surfaced. A routing table whose output cannot
# be handed to the spawn API is not routing, it is a suggestion.
#
# Unknown names fall through unchanged rather than being guessed at:
# `challenger-agent` is printed by this script as a literal, and an
# agent added outside agents/ should read as itself, not as a fiction.
# __file__ is unusable here: the body runs from a heredoc, so it
# resolves against the caller's directory and the map came back
# empty in silence. CB_LIB is exported by the wrapper above and
# points at scripts/lib, so the plugin root is two levels up.
AGENT_DIR = pathlib.Path(os.environ["CB_LIB"]).resolve().parent.parent / "agents"
_QUALIFIED = {}
if AGENT_DIR.is_dir():
    for _f in AGENT_DIR.rglob("*-agent.md"):
        _QUALIFIED[_f.stem] = "cereblnk:%s:%s" % (_f.parent.name, _f.stem)


def qualify(name):
    """docs-agent -> cereblnk:engineering:docs-agent, or unchanged."""
    return _QUALIFIED.get(name, name)


if inferred:
    print("inferred: true")
print("specialists:")
for a in agents:
    print("  - %s" % qualify(a))
if level == 3:
    print("  - %s   # mandatory at gate level 3" % qualify("challenger-agent"))
print("gate_level: %d" % level)
print("stack_source: %s" % stack_note)
floor_lines = []
for role in agents:
    got = skills.get(role) or []
    if got:
        floor_lines.append("  %s: [%s]" % (qualify(role), ", ".join(got)))
    else:
        floor_lines.append("  %s: []   # no skill signal for this role" % qualify(role))
print("skills_required:")
for line in floor_lines:
    print(line)

# --emit-floor writes the block the SubagentStop floor reads, so the
# list exists in exactly one place. Without a pinned run there is
# nowhere to write it, and a query-only invocation must not create
# files, so this is opt-in and silent when it cannot apply.
if os.environ.get("CB_EMIT"):
    run = (os.environ.get("CB_RUN") or "").rstrip("/")
    if not run:
        print("emit_floor: skipped — no run is armed with an id "
              "(scripts/run-flag arm \"\" <run_id>). The floor is not "
              "written to a guessed directory.", file=sys.stderr)
    else:
        dest = pathlib.Path(run) / "skills-required.yaml"
        try:
            dest.parent.mkdir(parents=True, exist_ok=True)
            dest.write_text("skills_required:\n" + "\n".join(floor_lines) + "\n",
                            encoding="utf-8")
            print("emit_floor: %s" % dest)
        except OSError as e:
            print("emit_floor: could NOT write %s (%s) — the skill floor "
                  "has nothing to read and will not run." % (dest, e),
                  file=sys.stderr)
            raise SystemExit(1)
# The floor above is everything the request text and the file paths can
# justify before anything is read. These are the triggers that only become
# visible once the specialist opens a file, so they travel into its Task
# Block instead of being resolved here.
watch_lines = []
for role in agents:
    got = watch.get(role) or []
    if got:
        watch_lines.append("  %s:" % qualify(role))
        for tok, tgt in got:
            watch_lines.append("    - \"%s -> %s\"" % (tok, tgt))
if watch_lines:
    print("discovery_watch:   # one hop from the matched rule, not the full cascade; seen while reading -> load that skill")
    for line in watch_lines:
        print(line)

print("signals:")
for s in signals:
    print("  - \"%s\"" % s)
for s in skill_why:
    print("  - \"%s\"" % s)
PY
