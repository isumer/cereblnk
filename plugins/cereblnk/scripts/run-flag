#!/usr/bin/env bash
# run-flag (CB-131) — the run flag is set by a mechanism, not by prose.
# CB-131: eleven raw arms resolved unset $CB_DIR to /flags and failed silently.
# The missing flag removed every run floor; one rewrite then ran inline to a context error.
# CB-134: relative careful/boundary flags claimed protection in a tree hooks never read.
# F-17: flag direction accepts exact words only; guessing controls for irreversible work is unsafe.
# Usage: run-flag arm|disarm|abandon|complete|status [cb_dir] [run_id]
#        run-flag complete [cb_dir] [run_id] [--decision <text>] [--gate <text>]
#   disarm   = pause; the run may resume
#   abandon  = retire a crashed/stale run without a completed handoff
#   complete = accepted synthesis; hands off and archives (§5)
#        run-flag flag <name> arm|on|disarm|off|status [cb_dir] [content]
# Exit:  0 the flag is in the requested state (verified on disk)
#        1 it is not, and stderr says why
#        2 usage
set -euo pipefail
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/cbenv.sh"
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/run-lifecycle.sh"

CMD="${1:-}"
NAME="run-active"
CONTENT=""
DECISION=""
GATE=""
if [ "$CMD" = "flag" ]; then
  NAME="${2:-}"
  CMD="${3:-}"
  DIR="${4:-${CB_DIR:-}}"
  CONTENT="${5:-}"
  case "$NAME" in
    "" | */* | .*) echo "usage: run-flag flag <name> arm|on|disarm|off|status [cb_dir] [content]" >&2; exit 2 ;;
  esac
  # F-17: the direction is decided here, by exact match, not by the
  # caller's reading of a sentence.
  case "$CMD" in
    on)  CMD="arm" ;;
    off) CMD="disarm" ;;
    arm|disarm|status) ;;
    *)
      echo "run-flag: '$CMD' is not a direction. Expected exactly one of: on, off, arm, disarm, status." >&2
      echo "run-flag: nothing was changed — the $NAME flag is still whatever it was. Do not report a toggle." >&2
      echo "usage: run-flag flag <name> arm|on|disarm|off|status [cb_dir] [content]" >&2
      exit 2 ;;
  esac
else
  if [ "$CMD" = "complete" ]; then
    # CB-169: completion metadata is optional, but when present its value is
    # opaque. Parse only the two flag names here; do not interpret their text.
    shift
    if [ "$#" -gt 0 ]; then
      case "$1" in
        --decision|--gate) DIR="${CB_DIR:-}" ;;
        *) DIR="${1:-${CB_DIR:-}}"; shift ;;
      esac
    else
      DIR="${CB_DIR:-}"
    fi
    if [ "$#" -gt 0 ]; then
      case "$1" in
        --decision|--gate) ;;
        --*)
          echo "run-flag: unknown complete option '$1'." >&2
          echo "usage: run-flag complete [cb_dir] [run_id] [--decision <text>] [--gate <text>]" >&2
          exit 2
          ;;
        *) CONTENT="$1"; shift ;;
      esac
    fi
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --decision|--gate)
          _metadata_flag="$1"
          shift
          if [ "$#" -eq 0 ]; then
            echo "run-flag: $_metadata_flag requires a value." >&2
            echo "usage: run-flag complete [cb_dir] [run_id] [--decision <text>] [--gate <text>]" >&2
            exit 2
          fi
          if [ "$_metadata_flag" = "--decision" ]; then
            DECISION="$1"
          else
            GATE="$1"
          fi
          shift
          ;;
        *)
          echo "run-flag: unknown complete option '$1'." >&2
          echo "usage: run-flag complete [cb_dir] [run_id] [--decision <text>] [--gate <text>]" >&2
          exit 2
          ;;
      esac
    done
    unset _metadata_flag
  else
    DIR="${2:-${CB_DIR:-}}"
    CONTENT="${3:-}"
  fi
  # CB-147/F-31: the third argument carries run identity instead of relying on mtimes.
  # Validate here for a visible refusal; cb_run_dir validates again for safety.
  if [ -n "$CONTENT" ]; then
    case "$CONTENT" in
      .* | *[!A-Za-z0-9._-]*)
        echo "run-flag: '$CONTENT' is not a run id. Expected a bare directory name under context/, e.g. R-2026-08-25-001." >&2
        echo "run-flag: nothing was changed — the run-active flag is still whatever it was." >&2
        echo "usage: run-flag arm|disarm|abandon|complete|status [cb_dir] [run_id]" >&2
        exit 2 ;;
    esac
  fi
fi

case "$CMD" in
  arm|disarm|abandon|complete|status) ;;
  *) echo "usage: run-flag [flag <name>] arm|disarm|abandon|complete|status [cb_dir] [run_id]" >&2; exit 2 ;;
esac

if [ -z "$DIR" ]; then
  echo "run-flag: no project root resolved — cbenv found no .claude/cereblnk above $(pwd)." >&2
  echo "run-flag: refusing to guess. Pass the directory explicitly: run-flag $CMD <cb_dir>" >&2
  exit 1
fi

FLAG="$DIR/flags/$NAME"

# CB-171: replacing a live pin requires an explicit transition; re-arming it is idempotent.
# Empty, malformed, or dead pins may be replaced with an announced repair.
if [ "$CMD" = "arm" ] && [ "$NAME" = "run-active" ] && \
   [ -n "$CONTENT" ] && [ -f "$FLAG" ]; then
  _existing_run="$(head -n 1 "$FLAG" 2>/dev/null | tr -d ' \t\r\n' || true)"
  _existing_pin=""
  case "$_existing_run" in
    "" | .* | *[!A-Za-z0-9._-]*) ;;
    *)
      if [ -d "$DIR/context/$_existing_run" ]; then
        _existing_pin="$_existing_run"
      fi
      ;;
  esac
  if [ "$_existing_pin" = "$CONTENT" ]; then
    unset _existing_run _existing_pin
    exit 0
  fi
  if [ -n "$_existing_pin" ]; then
    echo "run-flag: refusing to arm $CONTENT — run-active already pins $_existing_pin." >&2
    echo "run-flag: use /cb-resume, 'run-flag disarm', 'run-flag complete', or 'run-flag abandon' for $_existing_pin before arming $CONTENT." >&2
    unset _existing_run _existing_pin
    exit 1
  fi
  echo "run-flag: warning: the existing run-active flag is unpinned or invalid; replacing it with $CONTENT." >&2
  unset _existing_run _existing_pin
fi

# CB-166: resolve the validated pin before lifecycle transitions remove it.
_contract_baseline=""
_completion_run_id="$CONTENT"
_active_run_id=""
if [ "$NAME" = "run-active" ] && [ -f "$FLAG" ]; then
  _pinned_run="$(head -n 1 "$FLAG" 2>/dev/null | tr -d ' \t\r\n')"
  case "$_pinned_run" in
    "" | .* | *[!A-Za-z0-9._-]*) ;;
    *)
      if [ -d "$DIR/context/$_pinned_run" ]; then
        _active_run_id="$_pinned_run"
        _contract_baseline="$DIR/context/$_pinned_run/contract-baseline.txt"
        if { [ "$CMD" = "complete" ] || [ "$CMD" = "abandon" ]; } && \
           [ -z "$_completion_run_id" ]; then
          _completion_run_id="$_pinned_run"
        fi
      fi
      ;;
  esac
  unset _pinned_run
fi
if { [ "$CMD" = "complete" ] || [ "$CMD" = "abandon" ]; } && \
   [ -n "$CONTENT" ] && [ -n "$_active_run_id" ] && \
   [ "$CONTENT" != "$_active_run_id" ]; then
  echo "run-flag: refusing to $CMD $CONTENT — run-active pins $_active_run_id." >&2
  echo "run-flag: nothing was changed; resume, complete, or abandon the pinned run first." >&2
  exit 1
fi
# Preserve the historical unpinned fallback, but resolve it before complete
# removes run-active. The explicit id and a valid pin always win over mtime.
if { [ "$CMD" = "complete" ] || [ "$CMD" = "abandon" ]; } && \
   [ -z "$_completion_run_id" ]; then
  _completion_run_dir="$(ls -1dt "$DIR"/context/*/ 2>/dev/null | head -n 1 || true)"
  _completion_run_dir="${_completion_run_dir%/}"
  [ -z "$_completion_run_dir" ] || _completion_run_id="${_completion_run_dir##*/}"
  unset _completion_run_dir
fi
if { [ "$CMD" = "complete" ] || [ "$CMD" = "abandon" ]; } && \
   [ -n "$_completion_run_id" ] && \
   [ -d "$DIR/context/$_completion_run_id" ]; then
  _contract_baseline="$DIR/context/$_completion_run_id/contract-baseline.txt"
fi
if { [ "$CMD" = "complete" ] || [ "$CMD" = "abandon" ]; } && \
   [ -n "$_completion_run_id" ]; then
  _archive_preflight
fi

case "$CMD" in
  status)
    if [ -f "$FLAG" ]; then echo "run-flag: armed ($FLAG)"; else echo "run-flag: not armed"; fi
    exit 0
    ;;
  arm)
    mkdir -p "$DIR/flags" 2>/dev/null || true
    if [ -n "$CONTENT" ]; then
      printf '%s\n' "$CONTENT" > "$FLAG" 2>/dev/null || true
    else
      touch "$FLAG" 2>/dev/null || true
    fi
    if [ ! -f "$FLAG" ]; then
      echo "run-flag: could not arm $FLAG — this protection is NOT active." >&2
      echo "run-flag: the hook that reads this file will find nothing and pass everything through. Do not report the protection as enabled." >&2
      exit 1
    fi
    # CB-147/F-31: create context/<id> now or the resolver discards the pin as dead.
    if [ "$NAME" = "run-active" ] && [ -n "$CONTENT" ]; then
      mkdir -p "$DIR/context/$CONTENT" 2>/dev/null || true
      if [ ! -d "$DIR/context/$CONTENT" ]; then
        echo "run-flag: could not create $DIR/context/$CONTENT — the pin will not resolve." >&2
        echo "run-flag: cb_run_dir treats a pin with no matching context directory as dead and falls back to guessing. Do not report this run as guarded." >&2
        exit 1
      fi
      # Exit 3 records an empty baseline; execution/write failure leaves it absent so floors fail open.
      _contract_baseline="$DIR/context/$CONTENT/contract-baseline.txt"
      _contract_check="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/contract-check"
      _project_root="$(dirname "$(dirname "$DIR")")"
      _baseline_tmp="$_contract_baseline.$$"
      _baseline_rc=127
      if [ -n "${PYBIN:-}" ] && [ -f "$_contract_check" ]; then
        set +e
        $PYBIN "$_contract_check" "$_project_root" 2>/dev/null \
          | LC_ALL=C sort -u > "$_baseline_tmp"
        _baseline_rc=${PIPESTATUS[0]}
        set -e
      fi
      case "$_baseline_rc" in
        0|1|3)
          if ! mv -f "$_baseline_tmp" "$_contract_baseline" 2>/dev/null; then
            rm -f "$_baseline_tmp" 2>/dev/null || true
            rm -f "$_contract_baseline" 2>/dev/null || true
          fi
          ;;
        *)
          rm -f "$_baseline_tmp" 2>/dev/null || true
          rm -f "$_contract_baseline" 2>/dev/null || true
          ;;
      esac
      unset _contract_check _project_root _baseline_tmp _baseline_rc
    fi
    echo "run-flag: armed ($FLAG)"
    # Scaffold what run-status reads. Created only when absent; the
    # conductor owns the contents afterwards.
    if [ "$NAME" = "run-active" ] && [ -n "$CONTENT" ]; then
      _state="$DIR/state.md"
      if [ ! -f "$_state" ]; then
        {
          printf '# Run state — %s\n\n' "$CONTENT"
          printf 'run_id: %s\n' "$CONTENT"
          printf 'stage: armed\n'
          printf 'spec: none\n'
          printf 'plan: context/%s/plan.md\n' "$CONTENT"
          printf '\nRead by `scripts/run-status`, which a second terminal can\n'
          printf 'run while the conductor is blocked mid-run. Keep `stage`\n'
          printf 'current; it is the only line that says where the run is.\n'
        } > "$_state" 2>/dev/null || true
      elif ! grep -q "^run_id: $CONTENT\$" "$_state" 2>/dev/null; then
        # A stale run_id would point run-status at another run.
        _tmp="$_state.$$"
        if sed "s|^run_id: .*|run_id: $CONTENT|" "$_state" > "$_tmp" 2>/dev/null; then
          mv -f "$_tmp" "$_state" 2>/dev/null || rm -f "$_tmp" 2>/dev/null
        else
          rm -f "$_tmp" 2>/dev/null || true
        fi
      fi
      _inbox="$DIR/context/$CONTENT/inbox.md"
      if [ ! -f "$_inbox" ] && [ -d "$DIR/context/$CONTENT" ]; then
        {
          printf '# Inbox — %s\n\n' "$CONTENT"
          printf 'written_by: conductor\nrun_id: %s\n' "$CONTENT"
          printf 'date: %s\n' "$(date -u +%Y-%m-%d 2>/dev/null || echo unknown)"
          printf 'acp_version: "1.0"\n\n'
          printf 'Every user message arriving during a run lands here at the next\n'
          printf 'task boundary, with its class (input-policy §3). Unchecked\n'
          printf '`- [ ]` means unresolved; `correction` and `invalidation` hold\n'
          printf 'the loop, `clarification` never does.\n'
        } > "$_inbox" 2>/dev/null || true
      fi
    fi
    # F-23: a split-root arm existed but hooks saw another tree; warn via CB_ROOT_HINT.
    if [ -n "${CB_ROOT_HINT:-}" ]; then
      echo "run-flag: note — the session root is $CB_ROOT_HINT and this armed under $DIR." >&2
      echo "run-flag: hooks resolving to the session root will not see this flag." >&2
    fi
    ;;
  disarm)
    rm -f "$FLAG" 2>/dev/null || true
    if [ -f "$FLAG" ]; then
      echo "run-flag: could not remove $FLAG — the guards still consider this run active." >&2
      exit 1
    fi
    # The nudge counter covers one uninterrupted armed period.
    if [ "$NAME" = "run-active" ]; then
      rm -f "$DIR/flags/run-active.state" 2>/dev/null || true
      [ -z "$_contract_baseline" ] || rm -f "$_contract_baseline" 2>/dev/null || true
      if [ -n "$_contract_baseline" ] && [ -f "$_contract_baseline" ]; then
        echo "run-flag: could not remove $_contract_baseline — the run baseline is stale." >&2
        exit 1
      fi
    fi
    echo "run-flag: disarmed"
    if [ "$NAME" = "run-active" ] && [ ! -f "$DIR/flags/run-completed" ]; then
      echo "run-flag: note — this is a PAUSE, not a completion. If the run" >&2
      echo "run-flag: is finished, use 'run-flag complete' instead: it hands off" >&2
      echo "run-flag: to run-completed, which is what DelegationGuard reads as a" >&2
      echo "run-flag: run that ENDED rather than one whose guard was removed." >&2
    fi
    ;;
  abandon)
    # Never undo durable-memory touches; a later run may already depend on them.
    if [ -z "$_completion_run_id" ] || \
       [ ! -d "$DIR/context/$_completion_run_id" ]; then
      echo "run-flag: no live run context resolved to abandon." >&2
      exit 1
    fi
    _abandon_context="$DIR/context/$_completion_run_id"
    _abandon_root="$(dirname "$(dirname "$DIR")")"
    _abandon_memory="$(_memory_touch_list "$_abandon_context" "$_abandon_root")"
    echo "run-flag: memory touches for $_completion_run_id (review only; never reverted):"
    if [ -n "$_abandon_memory" ]; then
      while IFS= read -r _memory_path; do
        [ -n "$_memory_path" ] && printf '  %s\n' "$_memory_path"
      done <<< "$_abandon_memory"
    else
      echo "  none"
    fi
    _clear_run_transients "$_abandon_context"
    rm -f "$FLAG" "$DIR/flags/run-active.state" \
          "$DIR/flags/run-active.nudged" "$DIR/flags/run-active.witness" \
          "$DIR/flags/run-completed" 2>/dev/null || true
    for _stale in run-active run-active.state run-active.nudged \
                  run-active.witness run-completed; do
      if [ -f "$DIR/flags/$_stale" ]; then
        echo "run-flag: could not remove $DIR/flags/$_stale — abandonment stopped." >&2
        exit 1
      fi
    done
    _archive_run_context
    echo "run-flag: abandoned (no run-completed handoff)"
    unset _abandon_context _abandon_root _abandon_memory _memory_path
    ;;
  complete)
    # Final-synthesis handoff (run-discipline §5): clears the run
    # flag and its siblings, then writes run-completed.
    rm -f "$FLAG" 2>/dev/null || true
    rm -f "$DIR/flags/run-active.state" 2>/dev/null || true
    rm -f "$DIR/flags/run-active.nudged" 2>/dev/null || true
    rm -f "$DIR/flags/run-active.witness" 2>/dev/null || true
    [ -z "$_contract_baseline" ] || rm -f "$_contract_baseline" 2>/dev/null || true
    mkdir -p "$DIR/flags" 2>/dev/null || true
    : > "$DIR/flags/run-completed" 2>/dev/null || true
    if [ ! -f "$DIR/flags/run-completed" ]; then
      echo "run-flag: could not write $DIR/flags/run-completed — the follow-up" >&2
      echo "run-flag: window is NOT armed. Do not report the run as handed off." >&2
      exit 1
    fi
    for _stale in run-active run-active.nudged run-active.witness; do
      if [ -f "$DIR/flags/$_stale" ]; then
        echo "run-flag: could not remove $DIR/flags/$_stale — the guards may still" >&2
        echo "run-flag: read this run as live." >&2
        exit 1
      fi
    done
    if [ -n "$_contract_baseline" ] && [ -f "$_contract_baseline" ]; then
      echo "run-flag: could not remove $_contract_baseline — the run baseline is stale." >&2
      exit 1
    fi
    _append_completion_telemetry
    if [ -n "$_completion_run_id" ] && \
       [ -d "$DIR/context/$_completion_run_id" ]; then
      _clear_run_transients "$DIR/context/$_completion_run_id"
      _archive_run_context
    else
      echo "run-flag: no live context was archived." >&2
    fi
    echo "run-flag: completed (handed off to run-completed)"
    ;;
esac
