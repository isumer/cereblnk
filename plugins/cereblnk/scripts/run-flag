#!/usr/bin/env bash
# run-flag (CB-131) — the run flag is set by a mechanism, not by prose.
#
# Eleven files told the conductor to arm the run with a raw command:
#
#   mkdir -p "$CB_DIR/flags" && touch "$CB_DIR/flags/run-active"
#
# A raw command carries no environment. `$CB_DIR` is exported by
# lib/cbenv.sh, which that command never sources, so an unresolved
# variable made the target `/flags` — the root of the filesystem. The
# run observed died there with `mkdir: cannot create directory
# '/flags': Permission denied`, and nothing noticed.
#
# Nothing noticed is the part that matters. DelegationGuard, RunGuard
# and every check built on them read `$CB_DIR/flags/run-active` and
# treat its absence as "no run in progress". A failed arm does not
# weaken the delegation boundary; it removes it. That session then ran
# a full rewrite workflow inline — zero Task Blocks on disk, the whole
# rule payload, the source and a Maven failure in one window, and a
# context-length error at 96001 tokens. From the outside, a run whose
# flag never landed and a session that is not a run are the same thing.
#
# So this script does three things the prose could not:
#
#   1. Sources cbenv, so $CB_DIR is resolved the way run-status and
#      plan-status resolve it.
#   2. Verifies. After touch, the file is stat'ed. If it is not there,
#      exit 1 with the reason on stderr. Silent success was the bug.
#   3. Presents one stable command string. A host that remembers a
#      permission decision remembers it per command; eleven improvised
#      spellings meant the decision never matched the next run.
#
# CB-134 generalises it. `careful` and `boundary` — the two protections
# a user turns on by hand — were armed by the skills with a RELATIVE
# path, `.claude/cereblnk/flags/...`, which lands wherever the shell
# happens to be. The hooks read $CB_DIR. Measured in a controlled
# experiment: the same recursive delete ran when the flag sat where the
# skill wrote it and was blocked when it sat where the hook looks. Both
# skills report the protection as enabled either way, so the system
# announces a guarantee it does not hold — worse than no protection,
# because the user then takes more risk.
#
# F-17 adds the direction to the same principle. `/cb-careful` rendered
# its argument into the instruction as `<argument> = on, or empty`, so
# invoking it with anything but a bare `on`/`off` — "careful mode
# please", "turn it on for this repo" — left the branch to model
# judgment. A toggle whose direction is guessed is not a toggle, and
# this one controls whether irreversible commands are blocked. The flag
# subcommand therefore accepts `on`/`off` as literal synonyms of
# arm/disarm and rejects everything else with usage and exit 2. The
# skill passes the user's argument through verbatim; an argument that is
# not one of the four accepted words changes nothing and says so.
#
# Usage: run-flag arm|disarm|status [cb_dir]
#        run-flag flag <name> arm|on|disarm|off|status [cb_dir] [content]
# Exit:  0 the flag is in the requested state (verified on disk)
#        1 it is not, and stderr says why
#        2 usage
set -euo pipefail
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/cbenv.sh"

CMD="${1:-}"
NAME="run-active"
CONTENT=""
if [ "$CMD" = "flag" ]; then
  NAME="${2:-}"
  CMD="${3:-}"
  DIR="${4:-${CB_DIR:-}}"
  CONTENT="${5:-}"
  case "$NAME" in
    "" | */* | .*) echo "usage: run-flag flag <name> arm|on|disarm|off|status [cb_dir] [content]" >&2; exit 2 ;;
  esac
  # F-17: the direction is decided here, by exact match, not by the
  # caller's reading of a sentence.
  case "$CMD" in
    on)  CMD="arm" ;;
    off) CMD="disarm" ;;
    arm|disarm|status) ;;
    *)
      echo "run-flag: '$CMD' is not a direction. Expected exactly one of: on, off, arm, disarm, status." >&2
      echo "run-flag: nothing was changed — the $NAME flag is still whatever it was. Do not report a toggle." >&2
      echo "usage: run-flag flag <name> arm|on|disarm|off|status [cb_dir] [content]" >&2
      exit 2 ;;
  esac
else
  DIR="${2:-${CB_DIR:-}}"
fi

case "$CMD" in
  arm|disarm|status) ;;
  *) echo "usage: run-flag [flag <name>] arm|disarm|status [cb_dir]" >&2; exit 2 ;;
esac

if [ -z "$DIR" ]; then
  echo "run-flag: no project root resolved — cbenv found no .claude/cereblnk above $(pwd)." >&2
  echo "run-flag: refusing to guess. Pass the directory explicitly: run-flag $CMD <cb_dir>" >&2
  exit 1
fi

FLAG="$DIR/flags/$NAME"

case "$CMD" in
  status)
    if [ -f "$FLAG" ]; then echo "run-flag: armed ($FLAG)"; else echo "run-flag: not armed"; fi
    exit 0
    ;;
  arm)
    mkdir -p "$DIR/flags" 2>/dev/null || true
    if [ -n "$CONTENT" ]; then
      printf '%s\n' "$CONTENT" > "$FLAG" 2>/dev/null || true
    else
      touch "$FLAG" 2>/dev/null || true
    fi
    if [ ! -f "$FLAG" ]; then
      echo "run-flag: could not arm $FLAG — this protection is NOT active." >&2
      echo "run-flag: the hook that reads this file will find nothing and pass everything through. Do not report the protection as enabled." >&2
      exit 1
    fi
    echo "run-flag: armed ($FLAG)"
    # F-23: stat answers "is the file there", not "is it in the tree the
    # hooks read". Under a split root the arm reported success while the
    # hooks saw nothing — the same silent-unguarded outcome this script
    # was written to end, reached from the other side.
    if [ -n "${CB_ROOT_HINT:-}" ]; then
      echo "run-flag: note — the session root is $CB_ROOT_HINT and this armed under $DIR." >&2
      echo "run-flag: hooks resolving to the session root will not see this flag." >&2
    fi
    ;;
  disarm)
    rm -f "$FLAG" 2>/dev/null || true
    if [ -f "$FLAG" ]; then
      echo "run-flag: could not remove $FLAG — the guards still consider this run active." >&2
      exit 1
    fi
    echo "run-flag: disarmed"
    ;;
esac
