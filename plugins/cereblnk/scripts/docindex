#!/usr/bin/env bash
# docindex (CB-112) extracts once by source hash so callers can read slices.

#   $CB_DIR/docs/<sha12>/text.md      docparse output, verbatim
#   $CB_DIR/docs/<sha12>/outline.json section -> line range
#   $CB_DIR/docs/<sha12>/manifest.json source, fidelity, how it segmented

# Content hashing avoids TTLs and stale self-collisions.

# Usage: docindex <file> [--refresh] [--json] [--window-lines N]
# Exit: 0 indexed/reused · 1 extraction failed · 2 usage/unsupported/root · 3 no text layer
set -euo pipefail
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/cbenv.sh"
cb_require_python

[ -n "${CB_DIR:-}" ] || {
  echo "docindex: no project root resolved — cannot place the index." >&2
  exit 2
}

exec $PYBIN "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/docindex.py" \
  --cb-dir "$CB_DIR" "$@"
