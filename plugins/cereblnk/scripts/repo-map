#!/usr/bin/env bash
# repo-map — git-based repository map for Cereblnk CTX bundles (CB-045)
# Produces a single YAML on stdout from git history + the file tree:
#   1. hotspots: change-frequency ranking (commits touching each file)
#   2. ownership: top committers per file
#   3. imports: static import/include listing per source file
# No semantic index, no embeddings, no external services (F-class stays F).
# Usage: scripts/repo-map [max_files]   (default 30; run at repo root)
set -euo pipefail
# shellcheck source=../lib/cbenv.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/cbenv.sh"
cb_require_python

command -v git >/dev/null || { echo "repo-map: git required" >&2; exit 1; }
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || { echo "repo-map: not a git repo" >&2; exit 1; }
MAX="${1:-30}"
export MAX
$PYBIN << 'PY'
import os, re, subprocess, collections

MAX = int(os.environ.get("MAX", "30"))
def git(*a):
    return subprocess.run(["git", *a], capture_output=True, text=True, check=True).stdout

# tracked files (current tree only — deleted files excluded from map)
tracked = set(git("ls-files").splitlines())

# 1. hotspots: commits touching each currently-tracked file
counts = collections.Counter()
for line in git("log", "--name-only", "--pretty=format:").splitlines():
    if line and line in tracked:
        counts[line] += 1
hot = counts.most_common(MAX)

# 2. ownership: top 3 committers per hotspot file
def owners(path):
    out = git("log", "--pretty=format:%an", "--", path).splitlines()
    return collections.Counter(out).most_common(3)

# 3. static imports per source file (line-based, language-agnostic patterns)
pat = re.compile(
    r"^\s*(?:import\s+.+|from\s+\S+\s+import\s+.+|#include\s*[<\"].+[>\"]|"
    r"require\s*\(\s*['\"].+['\"]\s*\)|use\s+\S+;|source\s+\S+|\.\s+\S+\.sh)\s*$")
src_ext = (".py",".java",".kt",".ts",".tsx",".js",".jsx",".go",".rb",".c",".cc",".cpp",".h",".rs",".sh")
def imports(path):
    if not path.endswith(src_ext) or not os.path.isfile(path):
        return []
    hits = []
    try:
        with open(path, errors="replace") as f:
            for i, line in enumerate(f, 1):
                if i > 400: break
                if pat.match(line):
                    hits.append(line.strip())
    except OSError:
        pass
    return hits[:20]

def y(s):  # minimal YAML string escape
    return '"' + str(s).replace('\\', '\\\\').replace('"', '\\"') + '"'

head = git("rev-parse", "--short", "HEAD").strip()
print("# repo-map output — attachable as a CTX bundle (context-policy.md)")
print(f"generated_at_commit: {head}")
print(f"max_files: {MAX}")
print("hotspots:")
for path, n in hot:
    print(f"  - path: {y(path)}")
    print(f"    commits: {n}")
    print(f"    owners:")
    for name, c in owners(path):
        print(f"      - {{name: {y(name)}, commits: {c}}}")
print("imports:")
for path in sorted(tracked):
    imps = imports(path)
    if imps:
        print(f"  - path: {y(path)}")
        print(f"    lines:")
        for imp in imps:
            print(f"      - {y(imp)}")
PY
