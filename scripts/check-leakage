#!/usr/bin/env python3
"""check-leakage (CB-108) — reference strings must not survive to a push.

Originality is a standing rule (00 §6, 01 §7) and it has been enforced
by reading. Reading does not scale across 79 skills and 174 rule files,
and it does not run on a branch nobody opened.

The wordlist is deliberately NOT committed. Committing the list of
strings you are hiding publishes them in the same repository — the
check would become the leak. The list lives outside version control and
its path is supplied at run time; the absence of a list is reported as
a skip, never as a pass.

Asserts:
  L-1  the wordlist resolves, is readable, and holds at least one entry
       (absent → exit 3, reported by verify as SKIP, never as PASS)
  L-2  no tracked file under the scanned root contains a listed string,
       matched case-insensitively on word boundaries
  L-3  the wordlist itself is not tracked by git — a committed wordlist
       defeats the entire mechanism and is a hard failure

Findings print `path:line` and the wordlist ENTRY NUMBER, never the
matched string. A CI log or a pasted terminal is an unbounded audience;
the finding tells the owner where to look without republishing what was
found. This is the same reasoning that removed the bypass sentence from
DelegationGuard's block message (CB-099).

Usage:
  check-leakage [--wordlist PATH] [ROOT]

  --wordlist  defaults to $CB_LEAKAGE_WORDLIST, then to
              <repo root>/.leakage-wordlist
  ROOT        directory to scan; defaults to the repository root

Wordlist format: one entry per line, UTF-8. Blank lines and lines
beginning with `#` are ignored. Entries are matched literally, not as
regular expressions.

Exit: 0 clean · 1 leakage found or wordlist tracked · 2 usage
      3 wordlist absent (suite skipped)
"""
import os
import pathlib
import re
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
DEFAULT_WORDLIST = ".leakage-wordlist"
# Extensions whose bytes are not text we can meaningfully scan.
BINARY_SUFFIXES = {
    ".png", ".jpg", ".jpeg", ".gif", ".webp", ".ico", ".pdf", ".zip",
    ".gz", ".tar", ".woff", ".woff2", ".ttf", ".otf", ".docx", ".xlsx",
    ".pptx", ".class", ".jar", ".so", ".dylib", ".dll",
}


def parse_args(argv):
    wordlist, root, rest = None, None, []
    i = 0
    while i < len(argv):
        if argv[i] == "--wordlist":
            if i + 1 >= len(argv):
                print("check-leakage: --wordlist needs a path", file=sys.stderr)
                sys.exit(2)
            wordlist = argv[i + 1]
            i += 2
            continue
        if argv[i].startswith("-"):
            print(f"check-leakage: unknown option {argv[i]}", file=sys.stderr)
            sys.exit(2)
        rest.append(argv[i])
        i += 1
    if len(rest) > 1:
        print("check-leakage: at most one ROOT may be given", file=sys.stderr)
        sys.exit(2)
    if rest:
        root = rest[0]
    return wordlist, root


def resolve_wordlist(explicit):
    for candidate in (explicit, os.environ.get("CB_LEAKAGE_WORDLIST"),
                      str(ROOT / DEFAULT_WORDLIST)):
        if candidate:
            return pathlib.Path(candidate).expanduser()
    return None


def read_entries(path):
    entries = []
    for raw in path.read_text(encoding="utf-8", errors="replace").splitlines():
        line = raw.strip()
        if line and not line.startswith("#"):
            entries.append(line)
    return entries


def tracked_files(root):
    """Tracked files under root. Untracked work-in-progress is not a leak
    until it is committed, and failing on it would make the suite unusable
    while editing."""
    try:
        out = subprocess.run(
            ["git", "ls-files", "-z", "--", str(root)],
            cwd=str(ROOT), capture_output=True, text=True, check=True,
        ).stdout
    except (subprocess.CalledProcessError, FileNotFoundError):
        return sorted(p for p in root.rglob("*") if p.is_file())
    return [ROOT / p for p in out.split("\0") if p]


def is_tracked(path):
    try:
        r = subprocess.run(
            ["git", "ls-files", "--error-unmatch", "--", str(path)],
            cwd=str(ROOT), capture_output=True, text=True,
        )
        return r.returncode == 0
    except FileNotFoundError:
        return False


def main():
    wordlist_arg, root_arg = parse_args(sys.argv[1:])
    wordlist = resolve_wordlist(wordlist_arg)
    root = pathlib.Path(root_arg).resolve() if root_arg else ROOT

    # L-1 — no list, no verdict. Skipping loudly beats passing silently.
    if wordlist is None or not wordlist.is_file():
        shown = wordlist if wordlist else DEFAULT_WORDLIST
        print(f"check-leakage: L-1 wordlist not found at {shown} — suite skipped, "
              f"not passed. Set CB_LEAKAGE_WORDLIST to enable it.")
        return 3
    entries = read_entries(wordlist)
    if not entries:
        print(f"check-leakage: L-1 wordlist {wordlist} holds no entries — "
              f"suite skipped, not passed.")
        return 3

    # L-3 — a committed wordlist publishes exactly what it protects.
    if is_tracked(wordlist):
        print(f"check-leakage: L-3 wordlist {wordlist} is tracked by git. "
              f"Remove it from version control and add it to .gitignore.",
              file=sys.stderr)
        return 1

    patterns = [re.compile(r"(?<!\w)" + re.escape(e) + r"(?!\w)", re.IGNORECASE)
                for e in entries]

    findings, scanned = [], 0
    for path in tracked_files(root):
        if not path.is_file() or path.suffix.lower() in BINARY_SUFFIXES:
            continue
        if path.resolve() == wordlist.resolve():
            continue
        try:
            text = path.read_text(encoding="utf-8")
        except (UnicodeDecodeError, OSError):
            continue
        scanned += 1
        for lineno, line in enumerate(text.splitlines(), 1):
            for idx, pattern in enumerate(patterns, 1):
                if pattern.search(line):
                    rel = path.relative_to(ROOT) if ROOT in path.parents else path
                    findings.append((str(rel), lineno, idx))

    if findings:
        print(f"check-leakage: L-2 {len(findings)} occurrence(s) of "
              f"{len({f[2] for f in findings})} wordlist entr(ies) in tracked files.",
              file=sys.stderr)
        for rel, lineno, idx in findings[:50]:
            print(f"  L-2  {rel}:{lineno}  (wordlist entry #{idx})", file=sys.stderr)
        if len(findings) > 50:
            print(f"  ... {len(findings) - 50} more", file=sys.stderr)
        return 1

    print(f"check-leakage: clean — {scanned} tracked text file(s) scanned "
          f"against {len(entries)} entr(ies).")
    return 0


if __name__ == "__main__":
    sys.exit(main())
