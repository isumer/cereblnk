#!/usr/bin/env python3
"""host-probe — what a host actually does, from running it (CB-122).

Secondary sources on host hook systems disagree with each other and with
themselves across months: one adjacent host was written up as having no
blocking hooks in one quarter and a full pre-tool veto in the next. The
1.4.0 port cannot rest on that, so nothing downstream reads a vendor page.
It reads this.

The measurement has to happen inside the host, because the question is
what the host does, not what its documentation says. So:

  host-probe install <host>   write a recording hook into the host config
  host-probe record           the hook itself; appends one event, exits 0
  host-probe collect <host>   turn the recording into a profile
  host-probe attest <host>    record an operator observation, as one
  host-probe status           what has been measured, and what has not

Everything a run did not establish is written as `unmeasured` and stays
that way. That is the whole discipline here: an absent field is a fact
about the evidence, not an invitation to fill it in from memory. A
capability nobody measured must not appear in the published matrix as
though it had been (CB-125).

Two facts need the operator to provoke them, because no recording of a
successful call can show them:

  refusal_enforced   a refusal actually stopped the action
  failure_mode       an erroring hook failed open or closed

`install` writes hooks that provoke both; `collect` reports them as
unmeasured until the recording proves otherwise.

Exit: 0 fine · 1 the command failed · 2 bad usage
"""
import json
import os
import pathlib
import re
import sys
import time

ROOT = pathlib.Path(__file__).resolve().parent.parent
LOG_ENV = "CB_PROBE_LOG"
DEFAULT_LOG = ROOT / ".cb-probe/events.jsonl"
PROFILES = ROOT / "plugins/cereblnk/context"
PLUGIN_POLICIES = ROOT / "plugins/cereblnk/policies"

# Where each host reads its hook config, and the key names it uses. These
# are the claims under test — install writes here, and collect reports
# only what came back.
HOSTS = {
    "claude": {"config": ".claude/settings.json", "style": "claude"},
    "cursor": {"config": ".cursor/hooks.json", "style": "cursor"},
    "codex": {"config": ".codex/hooks.json", "style": "codex"},
    "gemini": {"config": ".gemini/settings.json", "style": "gemini"},
}

# Event name -> capability, per host. This is a decoder for what came
# back, not a claim about what exists: an event that never fires leaves
# its capability unmeasured no matter what the table says, and an event
# that fires under a name not listed here is reported unmapped, which is
# itself a finding worth reading.
ALIASES = {
    "claude": {"PreToolUse": "pre_tool_veto", "PostToolUse": "post_tool",
               "Stop": "turn_stop", "SubagentStop": "subagent_stop",
               "PreCompact": "pre_compact", "SessionStart": "session_start",
               "SessionEnd": "session_end"},
    "cursor": {"preToolUse": "pre_tool_veto", "postToolUse": "post_tool",
               "stop": "turn_stop", "subagentStop": "subagent_stop",
               "preCompact": "pre_compact", "sessionStart": "session_start",
               "sessionEnd": "session_end"},
    "codex": {"PreToolUse": "pre_tool_veto", "PostToolUse": "post_tool",
              "Stop": "turn_stop", "SessionStart": "session_start"},
    "gemini": {"BeforeTool": "pre_tool_veto", "AfterTool": "post_tool",
               "AfterAgent": "turn_stop", "PreCompress": "pre_compact",
               "SessionStart": "session_start", "SessionEnd": "session_end"},
}

# Stages of a smoke run, in the order they can fail. A stage classifies
# an observation and nothing else: it never names a capability, because
# capabilities come from capabilities.yaml and a host binding. Two models
# of what this platform can do would be one too many, and the second one
# always wins by being closer to hand.
#
# The vocabulary is fixed rather than free text so that "the host worked"
# stops being one result. When a run fails, the profile says which layer
# it failed at.
STAGES = ("install", "context", "marketplace", "plugin", "skill", "agent",
          "subagent", "hook", "veto", "finish")

# Uppercase, deliberately. A capability state in the matrix is lowercase
# (`M`, `declared:M`, `unmeasured`); a stage result is uppercase. They are
# different namespaces answering different questions — did this layer run,
# versus does this host have this capability — and one word appearing in
# both would invite exactly the conflation this evidence layer exists to
# avoid.
#
#   PASS         the expected behaviour was observed
#   FAIL         the stage ran and contradicted the contract
#   BLOCKED      an external dependency stopped it: no credentials, a
#                runner restriction, a vendor outage
#   UNMEASURED   no valid measurement exists yet
#   UNSUPPORTED  the host exposes no equivalent capability
#
# BLOCKED never becomes FAIL and UNMEASURED never becomes PASS. The first
# would blame this project for a missing credential; the second is the
# failure the whole probe exists to refuse.
RESULTS = ("PASS", "FAIL", "BLOCKED", "UNMEASURED", "UNSUPPORTED")

# Stages each host can reach at all. A stage outside this set is recorded
# UNSUPPORTED rather than dropped: a stage missing from a report reads as
# untested, and untested and unsupported are not the same finding.
HOST_STAGES = {
    "claude": ("install", "context", "plugin", "skill", "agent", "subagent",
               "hook", "veto", "finish"),
    "codex": ("install", "marketplace", "plugin", "skill", "agent", "hook",
              "veto", "finish"),
    "cursor": ("install", "marketplace", "plugin", "skill", "agent",
               "subagent", "hook", "veto", "finish"),
    "gemini": ("install", "context", "skill", "subagent", "hook", "veto",
               "finish"),
}

# What the port needs to know it has. Named host-neutrally on purpose:
# each host's own event name is whatever the recording says it was.
NEEDED = (
    "pre_tool_veto",      # something can refuse a tool call before it runs
    "post_tool",          # something observes a completed tool call
    "turn_stop",          # something runs when the turn tries to end
    "subagent_stop",      # something runs when a subagent tries to finish
    "pre_compact",        # something runs before history is compacted
    "session_start",
    "session_end",
)


def log_path():
    return pathlib.Path(os.environ.get(LOG_ENV) or DEFAULT_LOG)


def cmd_record():
    """Invoked by the host. Never blocks, never fails the caller."""
    raw = sys.stdin.read()
    try:
        payload = json.loads(raw) if raw.strip() else {}
    except ValueError:
        payload = {"_unparsed": raw[:500]}

    entry = {
        "at": time.time(),
        "event": os.environ.get("CB_PROBE_EVENT", "unknown"),
        "host": os.environ.get("CB_PROBE_HOST", "unknown"),
        # the field names are the finding; the values are not recorded
        "fields": sorted(payload.keys()) if isinstance(payload, dict) else [],
        "argv": sys.argv[2:],
    }
    path = log_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as fh:
        fh.write(json.dumps(entry, sort_keys=True) + "\n")
    return 0


def read_events():
    path = log_path()
    if not path.exists():
        return []
    out = []
    for line in path.read_text(encoding="utf-8").splitlines():
        if line.strip():
            try:
                out.append(json.loads(line))
            except ValueError:
                continue
    return out


def cmd_collect(host, write=False):
    if host not in HOSTS:
        print("host-probe: unknown host %r; known: %s"
              % (host, ", ".join(sorted(HOSTS))), file=sys.stderr)
        return 2

    events = [e for e in read_events() if e.get("host") in (host, "unknown")]
    by_event = {}
    for e in events:
        name = e.get("event", "unknown")
        if name.startswith("_"):
            continue  # attestations are not observations
        seen = by_event.setdefault(name, set())
        seen.update(e.get("fields", []))

    lines = [
        "# Host profile: %s (CB-122)" % host,
        "#",
        "# Produced by scripts/host-probe from %d recorded event(s)."
        % len(events),
        "# Every field here came back from a run. Anything a run did not",
        "# establish reads `unmeasured`, and stays that way until one does.",
        "#",
        "# This file is evidence, not configuration. Do not hand-edit it:",
        "# a hand-written capability is exactly the claim CB-122 exists to",
        "# refuse.",
        "version: 1",
        "host: %s" % host,
        "events_recorded: %d" % len(events),
        "events:",
    ]
    if not by_event:
        lines.append("  # none — the probe has not run on this host")
    for name in sorted(by_event):
        lines.append("  - event: %s" % name)
        fields = sorted(by_event[name])
        lines.append("    fields: [%s]" % ", ".join("'%s'" % f for f in fields)
                     if fields else "    fields: []")

    alias = ALIASES.get(host, {})
    fired = {alias[name]: name for name in by_event if name in alias}
    unmapped = sorted(n for n in by_event
                      if n not in alias and not n.startswith("_"))

    lines.append("capabilities:")
    for need in NEEDED:
        lines.append("  - capability: %s" % need)
        if need in fired:
            # the event fired. That establishes it exists, and nothing
            # more: whether it can refuse is a separate question, and
            # only a provoked refusal answers it.
            lines.append("    status: present")
            lines.append("    event: %s" % fired[need])
        else:
            lines.append("    status: unmeasured")

    if unmapped:
        lines.append("unmapped_events: [%s]"
                     % ", ".join("'%s'" % n for n in unmapped))

    attested, stages = {}, []
    for e in events:
        if e.get("attested") == "stage":
            stages.append(e)
        elif e.get("attested"):
            attested[e["attested"]] = e.get("value")

    lines.append("stages:")
    if not stages:
        lines.append("  # none — no smoke run has been attested")
    for e in stages:
        lines.append("  - stage: %s" % e["stage"])
        lines.append("    result: %s" % e["result"])
        if e.get("capability"):
            lines.append("    capability: %s" % e["capability"])
        if e.get("evidence"):
            lines.append("    evidence: %s" % json.dumps(e["evidence"]))
        lines.append("    observed_at: %s" % e.get("observed_at", "unknown"))

    lines += [
        "# Provoked facts. No recording of ordinary use can show either, so",
        "# a person provokes them and says what happened. Operator-attested",
        "# is weaker than observed, and is labelled rather than blurred.",
        "refusal_enforced: %s" % (
            "attested:%s" % attested["refusal-enforced"]
            if "refusal-enforced" in attested else "unmeasured"),
        "failure_mode: %s" % (
            "attested:%s" % attested["failure-mode"]
            if "failure-mode" in attested else "unmeasured"),
    ]

    text = "\n".join(lines) + "\n"
    if write:
        PROFILES.mkdir(parents=True, exist_ok=True)
        target = PROFILES / ("host-profile.%s.yaml" % host)
        target.write_text(text, encoding="utf-8")
        print("host-probe: wrote %s (%d event(s))"
              % (target.relative_to(ROOT), len(events)))
        return 0
    sys.stdout.write(text)
    return 0


def known_capabilities():
    """Capability ids, read from the catalogue rather than accepted."""
    path = PLUGIN_POLICIES / "capabilities.yaml"
    if not path.exists():
        return set()
    return set(re.findall(r"^\s*-\s*capability:\s*(\S+)", 
                          path.read_text(encoding="utf-8"), re.M))


def cmd_attest(args):
    """Record an operator's observation, labelled as one.

    Some facts cannot be read off a recording of ordinary use, so a
    person provokes them and says what happened. That is weaker evidence
    than an observation, and the profile keeps the two apart rather than
    letting them blur.

    A staged attestation classifies where in a smoke run the observation
    came from. It does not create capability semantics: --capability is
    checked against capabilities.yaml and rejected if absent, so this
    command cannot quietly become a second model of what the platform
    does.
    """
    usage = ("host-probe attest <host> --refusal-enforced yes|no\n"
             "            attest <host> --failure-mode open|closed\n"
             "            attest <host> --stage STAGE --result RESULT\n"
             "                          [--capability ID] [--evidence TEXT]\n"
             "\n"
             "  stages:  %s\n"
             "  results: %s" % (" ".join(STAGES), " ".join(RESULTS)))

    if not args:
        print(usage, file=sys.stderr)
        return 2
    host = args[0]
    flags = {}
    rest = args[1:]
    while rest:
        key = rest[0]
        if not key.startswith("--") or len(rest) < 2:
            print(usage, file=sys.stderr)
            return 2
        flags[key[2:]] = rest[1]
        rest = rest[2:]

    entry = {"at": time.time(), "host": host, "event": "_attestation",
             "fields": [],
             "observed_at": time.strftime("%Y-%m-%dT%H:%M:%SZ",
                                          time.gmtime())}

    if "stage" in flags:
        stage = flags["stage"]
        if stage not in STAGES:
            print("host-probe: unknown stage %r. The vocabulary is fixed so "
                  "that a failed run\n  says which layer it failed at: %s"
                  % (stage, ", ".join(STAGES)), file=sys.stderr)
            return 2
        result = flags.get("result")
        if result not in RESULTS:
            print("host-probe: --stage needs --result, one of: %s"
                  % ", ".join(RESULTS), file=sys.stderr)
            return 2
        capability = flags.get("capability")
        if capability is not None:
            known = known_capabilities()
            if capability not in known:
                print("host-probe: %r is not in capabilities.yaml.\n"
                      "  A stage classifies an observation; it does not name "
                      "a new capability.\n  Bind it in the catalogue first, "
                      "or leave --capability off for a stage\n  that is not "
                      "about one." % capability, file=sys.stderr)
                return 2
        entry.update({"attested": "stage", "stage": stage, "result": result,
                      "capability": capability,
                      "evidence": flags.get("evidence", "")})
        label = "%s=%s" % (stage, result)
    elif "refusal-enforced" in flags:
        entry.update({"attested": "refusal-enforced",
                      "value": flags["refusal-enforced"]})
        label = "refusal-enforced=%s" % flags["refusal-enforced"]
    elif "failure-mode" in flags:
        entry.update({"attested": "failure-mode",
                      "value": flags["failure-mode"]})
        label = "failure-mode=%s" % flags["failure-mode"]
    else:
        print(usage, file=sys.stderr)
        return 2

    path = log_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as fh:
        fh.write(json.dumps(entry, sort_keys=True) + "\n")
    print("host-probe: attested %s for %s" % (label, host))
    return 0


def cmd_status():
    events = read_events()
    if not events:
        print("host-probe: nothing recorded yet.")
        print("  Run `host-probe install <host>` inside a project that host "
              "opens,\n  use it normally for a few turns, then "
              "`host-probe collect <host>`.")
    by_host = {}
    for e in events:
        by_host.setdefault(e.get("host", "unknown"), set()).add(
            e.get("event", "unknown"))
    for host in sorted(HOSTS):
        seen = by_host.get(host, set())
        state = ", ".join(sorted(seen)) if seen else "unmeasured"
        print("  %-8s %s" % (host, state))
    return 0


# Candidate event names per host, for wiring the recorder. These come
# from documentation and from configurations other projects have
# committed and apparently run. Neither is measurement, which is what
# CB-122 exists to insist on — so they are candidates, not claims. A name
# that is wrong simply never fires, and the profile reports that
# capability unmeasured. The guess cannot contaminate the evidence; it
# can only fail to gather any.
#
# The list is deliberately wide. A name that does not exist costs one
# line of config that never runs; a name left out costs a capability
# recorded as absent when it was only unwired, and that error is the
# expensive one because it looks like a finding.
#
# Cross-check note (CB-135). A committed multi-harness configuration
# wires Cursor through per-tool events — before shell execution, before
# file read, before MCP execution — and carries no generic pre-tool
# event at all. If that holds, a pre-write veto on Cursor binds to
# several events rather than one, and policies/hosts/cursor.yaml will
# need a row each. It is not treated as settled: absence from someone
# else's config means unused at least as often as unsupported.
CANDIDATE_EVENTS = {
    "claude": ["PreToolUse", "PostToolUse", "PostToolUseFailure", "Stop",
               "SubagentStop", "PreCompact", "SessionStart", "SessionEnd"],
    "cursor": ["preToolUse", "postToolUse", "stop", "subagentStart",
               "subagentStop", "preCompact", "sessionStart", "sessionEnd",
               "beforeShellExecution", "afterShellExecution",
               "beforeReadFile", "afterFileEdit", "beforeMCPExecution",
               "afterMCPExecution", "beforeSubmitPrompt",
               "beforeTabFileRead", "afterTabFileEdit"],
    "codex": ["PreToolUse", "PostToolUse", "Stop", "SessionStart",
              "SessionEnd", "UserPromptSubmit"],
    "gemini": ["SessionStart", "SessionEnd", "BeforeAgent", "AfterAgent",
               "BeforeModel", "AfterModel", "BeforeToolSelection",
               "BeforeTool", "AfterTool", "PreCompress", "Notification"],
}


def cmd_install(host):
    if host not in HOSTS:
        print("host-probe: unknown host %r" % host, file=sys.stderr)
        return 2
    spec = HOSTS[host]
    probe = ROOT / "scripts/host-probe"
    events = CANDIDATE_EVENTS.get(host, [])

    hooks = {}
    for event in events:
        hooks[event] = [{
            "command": "CB_PROBE_HOST=%s CB_PROBE_EVENT=%s %s record"
                       % (host, event, probe),
        }]
    config = json.dumps({"version": 1, "hooks": hooks}, indent=2)

    print("host-probe: %s reads its hook config from %s"
          % (host, spec["config"]))
    print()
    print("1. Put this in that file, inside a project the host opens:")
    print()
    for line in config.splitlines():
        print("   " + line)
    print()
    print("   The event names above are candidates taken from")
    print("   documentation, which is what this whole command exists not to")
    print("   trust. A wrong name never fires and its capability stays")
    print("   unmeasured — the guess cannot contaminate the evidence, only")
    print("   fail to gather it. Adjust the key shape to whatever the host")
    print("   actually accepts; the recorder itself does not care.")
    print()
    print("2. Walk the stages, attesting each as you go. The vocabulary is")
    print("   fixed so a failed run says which layer it failed at:")
    print()
    for stage, what in (
            ("install", "the host accepts the plugin or extension"),
            ("context", "its context file is loaded"),
            ("skill", "a Cereblnk skill is discovered and invoked"),
            ("agent", "a specialist is selected"),
            ("subagent", "a subagent runs and finishes"),
            ("hook", "a hook script is reached at all"),
            ("veto", "a hook refuses and the action is actually stopped"),
            ("finish", "the run guard is reached at the end of a turn")):
        print("     %-9s %s" % (stage, what))
    print()
    print("   host-probe attest %s --stage hook --result pass \\" % host)
    print("       --capability veto.destructive-command \\")
    print("       --evidence \"what you saw\"")
    print()
    print("   --capability is checked against capabilities.yaml. A stage")
    print("   classifies an observation; it never names a new capability.")
    print()
    print("3. Provoke the two facts a normal session cannot show.")
    print("   a. Make a hook refuse something — return the host's refusal")
    print("      form from a pre-tool hook — and see whether the action")
    print("      was actually stopped or merely complained about:")
    print("        host-probe attest %s --refusal-enforced yes|no" % host)
    print("   b. Make a hook exit non-zero, and see whether the action")
    print("      still went through:")
    print("        host-probe attest %s --failure-mode open|closed" % host)
    print()
    print("4. host-probe collect %s --write" % host)
    print("   Then scripts/check-host-matrix, which will refuse any cell")
    print("   the recording does not support.")
    print()
    print("install prints rather than writes: the file it would touch")
    print("belongs to the operator's editor, and a probe that silently")
    print("rewrites it has already earned distrust.")
    return 0


def main():
    argv = sys.argv[1:]
    if not argv:
        print(__doc__.strip().splitlines()[0], file=sys.stderr)
        return 2
    cmd = argv[0]
    if cmd == "record":
        return cmd_record()
    if cmd == "status":
        return cmd_status()
    if cmd == "attest":
        return cmd_attest(argv[1:])
    if cmd in ("collect", "install"):
        if len(argv) < 2:
            print("host-probe: %s needs a host name" % cmd, file=sys.stderr)
            return 2
        if cmd == "install":
            return cmd_install(argv[1])
        return cmd_collect(argv[1], write="--write" in argv)
    print("host-probe: unknown command %r" % cmd, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
