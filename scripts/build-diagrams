#!/usr/bin/env python3
"""build-diagrams — generate the architecture assets from the tree.

The diagrams are not drawn and then checked against the repository. They
are generated from it, so the class of error that produced the first
draft of this poster — a picture asserting a retrieval pipeline, a CLI
and a memory layer that do not exist — cannot recur for anything
derivable. What remains authored is prose, and a missing description
fails the build rather than shipping a blank.

    scripts/build-diagrams            write docs/assets/*.svg
    scripts/build-diagrams --check    regenerate to a temp dir and
                                      compare; exit 1 if committed
                                      assets are stale
    scripts/build-diagrams --list     name what would be written

Output is byte-stable on identical input, which is what makes --check
meaningful. See scripts/lib/svgkit.py for the rules that keep it so.

Two widths per panel. The wide layout is what the composite uses. The
narrow one is laid out at a natural width close to a phone's container,
so a README embeds it at roughly one-to-one instead of scaling it until
the type disappears.
"""
import argparse
import pathlib
import sys
import tempfile

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent / "lib"))

import facts  # noqa: E402
import panels  # noqa: E402
import svgkit as k  # noqa: E402

ROOT = pathlib.Path(__file__).resolve().parent.parent
ASSETS = ROOT / "docs/assets"

COMPOSITE_GAP = 18


def _panels(wide, target=None):
    """(key, title, elements, width, height) for each panel.

    `target` aligns every panel to a common measure in the composite, so
    the page reads as one document rather than five stacked cards."""
    hooks = facts.hooks()
    out = [
        ("enforcement", "Cereblnk enforcement: hooks by the event that fires "
                        "them, and which ones refuse a specialist's stop",
         panels.enforcement(hooks, cols=7 if wide else 1, width=target)),
        ("commands", "Cereblnk entry points: the commands that start work",
         panels.commands(facts.entry_points(), cols=2 if wide else 1, width=target)),
        ("routing", "Cereblnk routing: which command a plain-language "
                    "request is routed to",
         panels.routing(facts.routing_table(), cols=2 if wide else 1, width=target)),
        ("gates", "Cereblnk verification gates: who reviews at each risk level",
         panels.gates(facts.gate_levels(), cols=2 if wide else 1, width=target)),
        ("agents", "Cereblnk agents: specialists by group",
         panels.agents(facts.agent_groups(), cols=2 if wide else 1, width=target)),
    ]
    return [(key, title, els, w, h) for key, title, (els, w, h) in out]


def render():
    """{relative path: file text}. Nothing is written here, so --check
    and a real build run identical code."""
    files = {}

    for key, title, els, w, h in _panels(wide=False):
        files[f"{key}.svg"] = k.document(w, h, els, title)

    measure = max(w for _, _, _, w, _ in _panels(wide=True))
    wide = _panels(wide=True, target=measure)
    width = measure + 36
    body, y = [], 78
    for key, _title, els, w, h in wide:
        body.append(k.group(f"panel-{key}", els, 18, y))
        y += h + COMPOSITE_GAP
    height = y + 30

    counts = facts.counts()
    head = [
        k.text(20, 44, "CEREBLNK", 28, k.TXT, "700", 6),
        k.text(300, 44, "engineering discipline as mechanism", 13, k.MUTED),
        k.text(width - 20, 34,
               f"{counts['agents']} agents \u00b7 {counts['skills']} skills "
               f"\u00b7 {counts['rules']} rules \u00b7 {counts['hooks']} hooks",
               10, k.DIM, anchor="end"),
        k.text(width - 20, 50, "generated from the tree by scripts/build-diagrams",
               10, k.DIM, anchor="end"),
        k.line(20, 60, width - 20, 60, k.EDGE, 1),
        k.text(20, height - 14,
               "github.com/isumer/cereblnk \u00b7 MIT \u00b7 "
               "hook names and their events are asserted by scripts/check-diagram",
               9.5, k.DIM),
    ]
    files["architecture.svg"] = k.document(
        width, height, head + body,
        "Cereblnk architecture: entry points, routing, agents, verification "
        "gates, and the enforcement hooks that refuse an unfinished stop")
    return files


def main():
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("--check", action="store_true",
                    help="fail if committed assets differ from a fresh build")
    ap.add_argument("--list", action="store_true")
    args = ap.parse_args()

    files = render()

    if args.list:
        for name in sorted(files):
            print(f"docs/assets/{name}")
        return 0

    if args.check:
        stale, missing = [], []
        with tempfile.TemporaryDirectory():
            for name, body in sorted(files.items()):
                path = ASSETS / name
                if not path.is_file():
                    missing.append(name)
                elif path.read_text(encoding="utf-8") != body:
                    stale.append(name)
        for name in missing:
            print(f"B-1 docs/assets/{name} is not committed")
        for name in stale:
            print(f"B-2 docs/assets/{name} differs from a fresh build")
        if missing or stale:
            print("build-diagrams: run scripts/build-diagrams and commit "
                  "the result", file=sys.stderr)
            return 1
        print(f"build-diagrams: {len(files)} asset(s) match a fresh build")
        return 0

    ASSETS.mkdir(parents=True, exist_ok=True)
    for name, body in sorted(files.items()):
        (ASSETS / name).write_text(body, encoding="utf-8")
    print(f"build-diagrams: wrote {len(files)} asset(s) to "
          f"{ASSETS.relative_to(ROOT)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
