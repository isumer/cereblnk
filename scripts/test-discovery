#!/usr/bin/env python3
"""test-discovery (CB-098) — the cascade must name evidence, not wishes.

A discovery entry says: when an agent sees THIS inside its own window,
load THAT skill next. The mechanism only works if the trigger is a
string that actually occurs in real files. A plausible-looking token
that no file ever contains is worse than no entry — it reads as
coverage while firing never, which is Part II trap #1 in data form.

The proxy for "observable" is mechanical: the token must appear in the
fixture corpus under tests/fixtures/discovery/, which holds realistic
snippets per ecosystem. File NAMES count as evidence alongside file
contents, because a name is part of what an agent sees when it lists
or opens a directory.

Asserts:
  D-1  every discovery token appears in the fixture corpus
  D-2  no token targets its own skill — a cascade to yourself is a
       no-op that inflates the entry count and moves nothing
  D-3  no token is shorter than three characters; a one- or two-char
       trigger matches everywhere and would fire on every window
  D-4  every fixture file contributes at least one token, so the
       corpus cannot rot into unrelated sample code

Target resolution is NOT re-checked here: check-agent-skills A-5 owns
it, and asserting it twice would let one copy drift unnoticed.

Exit: 0 all pass · 1 any violation (each printed with its D-id).
"""
import pathlib
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
FIXTURES = ROOT / "tests/fixtures/discovery"
sys.path.insert(0, str(ROOT / "plugins/cereblnk/scripts/lib"))
import cbmap  # noqa: E402

MIN_TOKEN_LEN = 3


def main():
    rules, errors = cbmap.load()
    if errors:
        for e in errors:
            print(f"test-discovery: map error: {e}", file=sys.stderr)
        return 1
    if not FIXTURES.is_dir():
        print(f"test-discovery: fixture corpus missing at {FIXTURES}", file=sys.stderr)
        return 1

    files = sorted(p for p in FIXTURES.iterdir() if p.is_file())
    corpus = {}
    for p in files:
        corpus[p] = p.name + "\n" + p.read_text(encoding="utf-8", errors="replace")
    blob = "\n".join(corpus.values())

    bad, tokens, used = 0, 0, set()
    for r in rules:
        for token, target in cbmap.discovery_pairs(r):
            tokens += 1
            if token not in blob:
                print(f"D-1 {r['skill']}: trigger {token!r} appears in no fixture — "
                      f"add a realistic snippet or drop the entry")
                bad += 1
            else:
                for p, text in corpus.items():
                    if token in text:
                        used.add(p)
            if target == r["skill"]:
                print(f"D-2 {r['skill']}: trigger {token!r} targets its own skill")
                bad += 1
            if len(token) < MIN_TOKEN_LEN:
                print(f"D-3 {r['skill']}: trigger {token!r} is too short to "
                      f"discriminate ({MIN_TOKEN_LEN} chars minimum)")
                bad += 1

    for p in files:
        if p not in used:
            print(f"D-4 {p.relative_to(ROOT)}: fixture contributes no trigger")
            bad += 1

    covered = sum(1 for r in rules if r["discovery"])
    print(f"test-discovery: {tokens} trigger(s) across {covered}/{len(rules)} skills, "
          f"{len(files)} fixture file(s), "
          + ("all pass" if bad == 0 else f"{bad} VIOLATIONS"))
    return 1 if bad else 0


if __name__ == "__main__":
    sys.exit(main())
