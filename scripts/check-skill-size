#!/usr/bin/env python3
"""check-skill-size — no skill exceeds the smallest host's ceiling (CB-129).

An adjacent host caps a skill file at 8 KB. Over the cap the file does not
load, and a skill that does not load fails the way this project cares
about least usefully: silently, with the run continuing as though the
craft had been supplied.

The ceiling is enforced on every host, including the ones with no such
limit: a tree where one skill only works in some places is a tree where
nobody can say what a port delivers.

Ceiling: 8192 bytes. **This number is unmeasured.** It comes from
documentation for an adjacent host, which is the kind of source CB-122
exists not to trust, and no probe has confirmed it. It is enforced anyway
because a guessed ceiling that turns out to be right costs a tidier file,
and one that turns out to be wrong is corrected by moving a constant. Both
are cheaper than shipping a skill that silently fails to load.

When CB-131 profiles that host, this constant is re-derived from the
profile and this paragraph is rewritten to say what was measured. Until
then it reads as a guess, because it is one.

Usage:
  scripts/check-skill-size            check every SKILL.md
  scripts/check-skill-size --list     print sizes, largest first

Exit: 0 all within the ceiling · 1 at least one over
"""
import pathlib
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
SKILLS = ROOT / "plugins/cereblnk/skills"
CEILING = 8192


def main():
    files = sorted(SKILLS.rglob("SKILL.md"))
    if not files:
        print("check-skill-size: no SKILL.md found under %s"
              % SKILLS.relative_to(ROOT), file=sys.stderr)
        return 1

    sizes = [(f.stat().st_size, f.relative_to(ROOT)) for f in files]

    if "--list" in sys.argv:
        try:
            for size, rel in sorted(sizes, reverse=True):
                print("%6d  %s%s"
                      % (size, rel, "  OVER" if size > CEILING else ""))
        except BrokenPipeError:
            pass  # piped into head; not an error worth a traceback
        return 0

    over = [(s, r) for s, r in sizes if s > CEILING]
    if over:
        print("check-skill-size: %d skill(s) over the %d byte ceiling"
              % (len(over), CEILING), file=sys.stderr)
        for size, rel in sorted(over, reverse=True):
            print("  %s  %d bytes (+%d)" % (rel, size, size - CEILING),
                  file=sys.stderr)
        print("\n  The ceiling comes from the smallest adjacent host's skill\n"
              "  packaging limit. Prose can be tightened, but a skill that is\n"
              "  over because it inlines what the rest of the tree references\n"
              "  should reference it too — moving text is not the same as\n"
              "  dropping a rule.", file=sys.stderr)
        return 1

    largest, where = max(sizes)
    print("check-skill-size: %d skill(s) within the %d byte ceiling "
          "(largest %s, %d)" % (len(sizes), CEILING, where.name, largest))
    return 0


if __name__ == "__main__":
    sys.exit(main())
