#!/usr/bin/env python3
"""test-provider-path — provider selection and the auth stage (CB-168).

The host is not the service that answers it. Claude Code speaks its
protocol to whatever base URL it is given, so the same CLI is backed by
a direct provider or a gateway depending on four environment variables,
and evidence that records only "claude" cannot tell the two apart.

These are the cases that were wrong or unrepresentable before:

  a credential the gateway path requires to be empty, read as absent
  a provider rejection, read as a capability failure
  a mapping this repository built wrong, read as a provider problem
  authentication, inferred from six downstream BLOCKEDs

Every case runs against a stand-in binary. No provider is called: a test
suite that spent a metered daily request allowance to assert a string
would stop being run, and one that needs a credential cannot run on a
fork at all.

The stand-in is not a convenience. Reading the outcomes off a mocked
Python function would test the mock; this drives the real stage script
through the real probe, and only the host at the end of it is fake.

Exit: 0 all cases hold · 1 one did not
"""
import os
import pathlib
import subprocess
import sys
import tempfile

ROOT = pathlib.Path(__file__).resolve().parent.parent
STAGES = ROOT / "tests" / "runtime" / "claude" / "stages.sh"

# Behaviours the stand-in can be asked for, keyed by CB_FAKE_MODE.
FAKE = r"""#!/usr/bin/env bash
case "${1:-}" in
  --help) echo "  -p, --print   run non-interactively and print the result"
          echo "      --debug   emit diagnostic output"
          echo "      --output-format <text|json>  set the output format"
          exit 0 ;;
  plugin)
    case "${CB_FAKE_MODE:-ok}" in
      no-plugin-cmd) echo "unknown command: plugin" >&2; exit 1 ;;
    esac
    case "${2:-}" in
      --help) echo "  install <name>   install a plugin from a marketplace"
              exit 0 ;;
    esac
    case "${CB_FAKE_MODE:-ok}" in
      plugin-ok) echo "installed"; exit 0 ;;
      *) echo "no such plugin in any configured marketplace" >&2; exit 1 ;;
    esac ;;
esac
for _a in "$@"; do
  [ "$_a" = "--debug" ] && CB_FAKE_DEBUG=1
done
case "${CB_FAKE_MODE:-ok}" in
  ok)       echo "ready"; exit 0 ;;
  refused)  echo "401 invalid_api_key: no auth credentials found" >&2; exit 1 ;;
  quota)    echo "429 rate limit exceeded for free models" >&2; exit 1 ;;
  broken)   echo "segmentation fault" >&2; exit 1 ;;
  # The shape both real runs produced: a wrapper line, and the cause
  # underneath it where head -1 never looked.
  wrapped)  echo "Execution error"
            echo "API error 404: model not found: nex-agi/nex-n2-pro:free" >&2
            exit 1 ;;
  structured) echo '{"is_error":true,"wrapper":"Execution error","error":{"message":"unsupported through this endpoint"}}'; exit 1 ;;
  silent)   exit 7 ;;
  # Debug output that says plenty and counts nothing: the boundary is
  # genuinely not observable from it.
  hang-mute) if [ "${CB_FAKE_DEBUG:-}" = "1" ]; then
              echo "startup: resolving configuration" >&2
              exit 1
            fi
            sleep 30 ;;
  hang)     if [ "${CB_FAKE_DEBUG:-}" = "1" ]; then
              echo "startup: cached session conflicts with gateway credential" >&2
              echo '{"is_error":true,"duration_api_ms":0}'
              exit 1
            fi
            sleep 30 ;;
  # The case that separates the two remaining explanations for a silent
  # host: one that is waiting on something interactive says so first.
  hang-loud) echo "Do you trust the files in this folder? [y/N]"; sleep 30 ;;
  # What the live run actually produced: a structured result whose usage
  # block was flushed first, truncated mid-write by the kill, with the
  # message that explains it further in than a raw read ever reached.
  # A host that hangs only when the installed profile is present: the
  # control home is empty, so HOME differing is what it keys on.
  hang-unless-clean)
      if [ -f "$HOME/.installed" ]; then sleep 30; else echo "ready"; exit 0; fi ;;
  hang-json) printf '{"is_error":true,"duration_api_ms":0,"num_turns":2,'
             printf '"usage":{"input_tokens":0,"output_tokens":0},'
             printf '"result":"the model does not support this endpoint",'
             printf '"cache_creation'
             sleep 30 ;;
  # A provider is untrusted text on its way to a public comment.
  nasty)    printf "Execution error\nAPI error 404: model | injected | row\n" >&2; exit 1 ;;
esac
"""

GATEWAY = "https://openrouter.ai/api"
KEY = "sk-or-v1-0000000000000000000000000000000000000000"


def run_stage(stage, env_overrides, mode="ok"):
    """Drive one stage of the real script against the stand-in host."""
    with tempfile.TemporaryDirectory() as tmp:
        tmp = pathlib.Path(tmp)
        bindir = tmp / "bin"
        bindir.mkdir()
        fake = bindir / "claude"
        fake.write_text(FAKE)
        fake.chmod(0o755)
        work = tmp / "work"
        work.mkdir()

        env = {
            "PATH": "%s:%s" % (bindir, os.environ.get("PATH", "")),
            "HOME": str(tmp),
            "CB_ROOT": str(ROOT),
            "CB_WORKDIR": str(work),
            "CB_FAKE_MODE": mode,
            # The timeout path is exercised deliberately; waiting out the
            # real budget to assert one sentence would make the suite
            # slow enough to skip.
            "CB_AUTH_TIMEOUT": "3",
        }
        env.update(env_overrides)
        proc = subprocess.run(["bash", str(STAGES), stage], env=env,
                              capture_output=True, text=True, timeout=180,
                              cwd=str(work))
        return proc.stdout + "\n" + proc.stderr


def status_of(blob):
    for line in blob.splitlines():
        if line.startswith("CB_STATUS="):
            return line.split("=", 1)[1].strip()
    return "<none>"


def gateway_env(**extra):
    env = {
        "OPENROUTER_API_KEY": KEY,
        "ANTHROPIC_AUTH_TOKEN": KEY,
        "ANTHROPIC_BASE_URL": GATEWAY,
        # Empty, not absent. This is the case the old presence test read
        # as a missing credential.
        "ANTHROPIC_API_KEY": "",
        "CEREBLNK_CLAUDE_RUNTIME_MODEL": "nex-agi/nex-n2-pro:free",
    }
    env.update(extra)
    return env


CASES = []


def case(name):
    def register(fn):
        CASES.append((name, fn))
        return fn
    return register


@case("the gateway credential is not read as absent")
def _gateway_present():
    """AC-2. The gateway contract requires an empty ANTHROPIC_API_KEY, and
    the presence test that predated it reported that as no credential —
    a repository problem filed where an account problem belongs."""
    blob = run_stage("auth", gateway_env())
    assert status_of(blob) == "PASS", status_of(blob)
    assert "no credential in the environment" not in blob


@case("the provider and the model reach the evidence")
def _provider_recorded():
    """AC-3. A reader deciding what a run certified needs the service
    that answered before they read a stage row."""
    blob = run_stage("auth", gateway_env())
    assert "inference_provider=openrouter" in blob, blob
    assert "configured_model=nex-agi/nex-n2-pro:free" in blob, blob


@case("the credential never reaches the evidence")
def _no_credential_leak():
    """The stage emits provenance, not secrets."""
    for mode in ("ok", "refused", "broken"):
        blob = run_stage("auth", gateway_env(), mode=mode)
        assert KEY not in blob, mode


@case("the direct path is selected when the gateway is absent")
def _direct_selected():
    """AC: the direct branch stays implemented and testable without a
    repository secret. It is not runtime-certified by this passing."""
    blob = run_stage("auth", {"ANTHROPIC_API_KEY": "sk-ant-" + "0" * 40})
    assert status_of(blob) == "PASS", status_of(blob)
    assert "inference_provider=anthropic" in blob, blob


@case("explicit provider configuration outranks a stray variable")
def _explicit_wins():
    """Reading the provider off whichever variable happens to be set is
    how a job that exported two by accident gets described as the one it
    did not mean."""
    env = gateway_env(CEREBLNK_CLAUDE_PROVIDER="anthropic",
                      ANTHROPIC_API_KEY="sk-ant-" + "0" * 40,
                      ANTHROPIC_BASE_URL="")
    blob = run_stage("auth", env)
    assert "inference_provider=anthropic" in blob, blob


@case("no credential at all is BLOCKED, not FAIL")
def _absent_blocked():
    """AC-5. A missing secret is not a defect in this package."""
    blob = run_stage("auth", {"ANTHROPIC_API_KEY": "", "OPENROUTER_API_KEY": ""})
    assert status_of(blob) == "BLOCKED", status_of(blob)


@case("a refused credential is BLOCKED with a sanitized reason")
def _refused_blocked():
    """AC-5. A rejected key, an exhausted quota and an unentitled account
    are all reasons to stop and none is a capability failure."""
    for mode in ("refused", "quota"):
        blob = run_stage("auth", gateway_env(), mode=mode)
        assert status_of(blob) == "BLOCKED", (mode, status_of(blob))
        assert "Not a defect in this package" in blob, mode


@case("a mapping this repository built wrong is FAIL")
def _misconfig_fails():
    """AC-6. Asking a misconfigured endpoint produces a rejection that
    reads like a bad key, so the configuration is judged before the
    request rather than after it."""
    broken = [
        gateway_env(ANTHROPIC_BASE_URL=""),
        gateway_env(ANTHROPIC_BASE_URL="https://api.anthropic.com"),
        gateway_env(ANTHROPIC_AUTH_TOKEN=""),
        # The silent-attribution case: a real direct key on the gateway
        # path would authenticate against the direct provider while the
        # run reported the gateway.
        gateway_env(ANTHROPIC_API_KEY="sk-ant-" + "0" * 40),
    ]
    for env in broken:
        blob = run_stage("auth", env)
        assert status_of(blob) == "FAIL", (env.get("ANTHROPIC_BASE_URL"),
                                           status_of(blob))
        assert "built by this repository is wrong" in blob


@case("the reason names the invocation and the host's own words")
def _detail_survives():
    """The probe is called in a command substitution, which is a
    subshell, so everything it recorded about *why* died with it while
    the verdict — the thing being echoed — survived. Every reason read
    `invoked with '?'` and `no output`, on every run, including the
    evidence meant to explain a failure. Only the sentence was wrong,
    which is why nothing caught it."""
    blob = run_stage("auth", gateway_env(), mode="broken")
    assert "invoked with '?'" not in blob, blob
    assert "-p" in blob, blob
    assert "no output" not in blob, blob
    assert "segmentation fault" in blob, blob

    # The same sentence is built on the refusal path, from the provider's
    # own words rather than ours.
    blob = run_stage("auth", gateway_env(), mode="refused")
    assert "invalid_api_key" in blob, blob
    assert "no detail" not in blob, blob


@case("the cause outranks the wrapper line above it")
def _cause_not_wrapper():
    """Two runs, two different models, one sentence: `Execution error`.
    The host announces a failure on its first line and names the cause
    underneath, and the probe only ever read the first line — so a model
    incompatibility, a rejected key and a protocol mismatch all reached
    the reader as the same six words."""
    blob = run_stage("auth", gateway_env(), mode="wrapped")
    assert "model not found" in blob, blob


@case("a structured answer beats any line of prose")
def _structured_preferred():
    """Asked for where the host offers it, at no extra request."""
    blob = run_stage("auth", gateway_env(), mode="structured")
    reason = [l for l in blob.splitlines() if l.startswith("CB_REASON=")][0]
    assert "unsupported through this endpoint" in reason, reason
    # The field, not the line it lived on. Scanning the raw text would
    # find the same words and prove nothing about reading the document.
    assert "is_error" not in reason, reason
    assert "{" not in reason, reason


@case("a timeout is not reported as a refusal")
def _timeout_named():
    blob = run_stage("auth", gateway_env(), mode="hang")
    assert status_of(blob) == "UNMEASURED", status_of(blob)
    assert "timeout" in blob.lower(), blob
    # Silence is now claimed rather than assumed. The old wording said a
    # host killed at the wall has nothing to quote; that was never
    # measured, and the log is read before the claim is made.
    assert "printed nothing before being killed" in blob, blob


@case("a host that says what it is waiting on is quoted saying it")
def _timeout_keeps_partial_output():
    """The two remaining explanations for a silent host are a CLI
    waiting on something interactive and a request hanging at the
    provider. The first prints the prompt it is waiting on; the second
    prints nothing. Discarding the partial output threw away the one
    observation that separates them, and left a reader with an
    assumption presented as a finding."""
    blob = run_stage("auth", gateway_env(), mode="hang-loud")
    assert status_of(blob) == "UNMEASURED", status_of(blob)
    assert "Do you trust the files" in blob, blob


@case("silence is reported as silence, with the exit code")
def _silent_named():
    blob = run_stage("auth", gateway_env(), mode="silent")
    assert "exit 7" in blob, blob


@case("a message is salvaged from JSON the host never finished")
def _partial_json_is_salvaged():
    """A host killed mid-write leaves JSON that will not parse, and the
    fields already flushed are the usage block — zeros, in whatever order
    it serialised them. A raw fallback then spends the whole budget on
    counters and cuts before the message. The live run reported exactly
    that: six hundred characters of zeroes and no sentence."""
    blob = run_stage("auth", gateway_env(), mode="hang-json")
    assert "does not support this endpoint" in blob, blob


@case("counters say whether the provider was called at all")
def _counters_are_recorded():
    """An API duration of zero with zero tokens means no request was
    ever made, so a silent host is not a slow provider — and that is
    decided by numbers rather than by reading prose."""
    blob = run_stage("auth", gateway_env(), mode="hang-json")
    assert "duration_api_ms=0" in blob, blob
    assert "num_turns=2" in blob, blob


@case("a control run separates this package from the host")
def _control_run_discriminates():
    """The host errors without calling the provider and hangs writing
    its own result, so stdout has nothing more to give and two
    explanations remain: this package, or the CLI and its configuration.
    Nothing separates them except removing one of them — and no request
    reaches the provider on either side, so asking costs nothing against
    a daily request allowance."""
    with tempfile.TemporaryDirectory() as tmp:
        tmp = pathlib.Path(tmp)
        bindir = tmp / "bin"
        bindir.mkdir()
        fake = bindir / "claude"
        fake.write_text(FAKE)
        fake.chmod(0o755)
        (tmp / ".installed").touch()
        work = tmp / "work"
        work.mkdir()
        env = {"PATH": "%s:%s" % (bindir, os.environ.get("PATH", "")),
               "HOME": str(tmp), "CB_ROOT": str(ROOT),
               "CB_WORKDIR": str(work), "CB_FAKE_MODE": "hang-unless-clean",
               "CB_AUTH_TIMEOUT": "3"}
        env.update(gateway_env())
        blob = subprocess.run(["bash", str(STAGES), "auth"], env=env,
                              capture_output=True, text=True, timeout=180,
                              cwd=str(work)).stdout
    assert status_of(blob) == "UNMEASURED", status_of(blob)
    assert "auth_control: PASSED without the installed profile" in blob, blob


@case("the control profile is not built inside the artifact")
def _control_home_is_outside_the_artifact():
    """A fresh profile is a place the CLI writes configuration, and the
    credential it was handed can land there. Under the staged workdir
    that means building a credential-bearing directory inside the thing
    that gets uploaded — the leak guard caught it and failed the run,
    which is the guard working. The defect was creating the file."""
    with tempfile.TemporaryDirectory() as tmp:
        tmp = pathlib.Path(tmp)
        bindir = tmp / "bin"
        bindir.mkdir()
        fake = bindir / "claude"
        # A host that persists what it was given, as a real one does.
        # It also records where its profile was, because cleanup would
        # otherwise hide the answer: a control home built inside the
        # artifact and then deleted still leaves the window in which the
        # guard runs, and a deletion that fails leaves the credential.
        seen = tmp / "home-seen"
        # Right after the shebang: the stand-in answers --help before it
        # reaches any mode branch, and the control run has to be recorded
        # on every invocation rather than only the ones that get that far.
        prelude = (
            'printf "%s" "${ANTHROPIC_AUTH_TOKEN:-}" > "$HOME/.claude.json"\n'
            'printf "%s\\n" "$HOME" >> "' + str(seen) + '"\n')
        head, rest = FAKE.split("\n", 1)
        fake.write_text(head + "\n" + prelude + rest)
        fake.chmod(0o755)
        work = tmp / "work"
        work.mkdir()
        env = {"PATH": "%s:%s" % (bindir, os.environ.get("PATH", "")),
               "HOME": str(tmp), "CB_ROOT": str(ROOT),
               "CB_WORKDIR": str(work), "CB_FAKE_MODE": "hang",
               "CB_AUTH_TIMEOUT": "3"}
        env.update(gateway_env())
        subprocess.run(["bash", str(STAGES), "auth"], env=env,
                       capture_output=True, text=True, timeout=180,
                       cwd=str(work))
        staged = [f for f in work.rglob("*") if f.is_file()]
        leaked = [f for f in staged
                  if KEY in f.read_text(errors="replace")]
        homes = [h for h in seen.read_text().split() if h] \
            if seen.exists() else []
    assert not leaked, "credential staged for upload in %s" % leaked
    control = [h for h in homes if h != str(tmp)]
    assert control, "the control run never happened; homes seen: %s" % homes
    inside = [h for h in control if h.startswith(str(work))]
    assert not inside, "the control profile was built inside the artifact"


@case("the debug retry runs once, and only where reading has run out")
def _diagnostic_retry_is_conditional():
    """Four hypotheses have been measured and eliminated — credential,
    model, this package, its installation — and what remains is a CLI
    that does local work, never calls the provider, and does not exit.
    Its ordinary output ends mid-sentence because it hangs while writing
    it, so there is nothing further to read at this verbosity.

    A refusal, a quota response and a model-not-found already carry
    provider-level attribution. Retrying those louder spends a request
    to learn what was already said."""
    blob = run_stage("auth", gateway_env(), mode="hang")
    assert "auth_diagnostic: diagnostic_retry=true" in blob, blob
    assert "mode=--debug" in blob, blob
    assert "cached session conflicts" in blob, blob

    for quiet in ("ok", "refused", "quota", "wrapped"):
        blob = run_stage("auth", gateway_env(), mode=quiet)
        assert "auth_diagnostic" not in blob, (quiet, blob)


@case("the boundary is decided by numbers, not by local activity")
def _provider_reached_is_measured():
    """Two local turns is not a request. `provider_reached` divides the
    next investigation, so inferring it from the host having been busy
    would send the next person to the wrong layer."""
    blob = run_stage("auth", gateway_env(), mode="hang")
    assert "provider_reached=false" in blob, blob


@case("an unobservable boundary is unknown, not assumed crossed")
def _provider_reached_admits_ignorance():
    """`provider_reached` divides the next investigation. Defaulting it
    either way sends the next person to a layer the evidence never
    pointed at, so output that counts nothing has to say so."""
    blob = run_stage("auth", gateway_env(), mode="hang-mute")
    assert "provider_reached=unknown" in blob, blob


@case("diagnostic visibility does not promote the auth stage")
def _diagnosis_is_not_a_result():
    """Seeing why something failed is not measuring that it worked."""
    blob = run_stage("auth", gateway_env(), mode="hang")
    assert status_of(blob) == "UNMEASURED", status_of(blob)


@case("the two debug streams are kept apart")
def _streams_are_separate():
    """Which stream a line arrived on is evidence. Merging them destroys
    that before anyone reads it."""
    lib = (ROOT / "tests/runtime/lib/authprobe.sh").read_text()
    assert '>"$_dout" 2>"$_derr"' in lib, "debug output is merged"


@case("the host's words cannot reshape the table they land in")
def _detail_is_neutralised():
    """The reason is rendered into a public comment as a table cell. A
    pipe in a provider's error message would end the cell and start a
    column nobody wrote."""
    blob = run_stage("auth", gateway_env(), mode="nasty")
    reason = [l for l in blob.splitlines() if l.startswith("CB_REASON=")]
    assert reason, blob
    assert "|" not in reason[0], reason[0]


@case("a refusal names its cause, not its announcement")
def _detail_picks_the_cause():
    """A host announces before it explains. `Installing plugin ...` came
    first, the reason came after, and a first-line-then-truncate read
    delivered the announcement with the cause sliced off — in the one
    field a reader had to work from."""
    import subprocess as sp
    log = "Installing plugin \"/x/y\"...\n" \
          "Failed to install: not found in any configured marketplace\n"
    with tempfile.TemporaryDirectory() as tmp:
        f = pathlib.Path(tmp) / "install.log"
        f.write_text(log)
        out = sp.run(["bash", "-c",
                      '. "%s"; cb_detail "%s"'
                      % (ROOT / "tests/runtime/lib/authprobe.sh", f)],
                     capture_output=True, text=True).stdout.strip()
    assert "marketplace" in out, out
    assert not out.startswith("Installing plugin"), out


@case("one extractor, not one per caller")
def _extractor_is_shared():
    """The auth probe learned to prefer a structured field and skip a
    wrapper line; the plugin stage kept its own worse copy of the same
    read. Two implementations of one judgement drift, and the one that
    drifts is the one nobody is looking at."""
    stages = (ROOT / "tests/runtime/claude/stages.sh").read_text()
    assert "cb_detail" in stages, "the plugin stage does not use it"
    assert "head -1 | tr -d" not in stages, "a private copy survives"


@case("the renderer shows the cause the table has to cut")
def _renderer_shows_the_cause():
    """The table cell is 150 characters because a table is for scanning.
    But the first real installation refusal reached readers as
    `Failed to…`, with the sentence that named the cause past the cut —
    and the renderer dropped evidence lines entirely, so a stage could
    record exactly what the host documented it wanted and nobody would
    see it. Both facts existed; neither was readable."""
    import json
    import subprocess as sp
    cause = "not found in any configured marketplace"
    doc = {
        "schema_version": "1", "host": "claude", "host_version": "2.x",
        "source_sha": "a" * 40, "observed_at": "2026-01-01T00:00:00Z",
        "stages": {"plugin": {
            "status": "FAIL",
            "reason": "invoked as 'claude plugin install <path>' and the "
                      "host refused: " + "Installing plugin. " * 8 + cause,
            "evidence": ["install_usage=claude plugin install <name>"],
        }},
    }
    with tempfile.TemporaryDirectory() as tmp:
        f = pathlib.Path(tmp) / "e.json"
        f.write_text(json.dumps(doc))
        out = sp.run(["python3", str(ROOT / "scripts" / "render-evidence"),
                      str(f)], capture_output=True, text=True).stdout

    table = out.split("<details>")[0]
    assert cause not in table, "the table cell is no longer bounded"
    assert cause in out, "the cause is nowhere in the output"
    assert "install_usage" in out, "evidence lines are still dropped"


@case("a refusal is not cut before the sentence that explains it")
def _detail_bound_is_generous_enough():
    """200 characters cut the first real refusal mid-filesystem-path,
    ahead of the cause. The renderer bounds this again at its own limit,
    so the tighter number was buying nothing and costing the finding."""
    import subprocess as sp
    path = "/home/runner/work/cereblnk/cereblnk/plugins/cereblnk"
    cause = "not found in any configured marketplace"
    # One line, as the host emits it: a spinner rewrites in place, so the
    # progress text and the failure arrive concatenated and the cause is
    # last. That shape is what made a 200-character bound cut mid-path.
    log = ('Installing plugin "%s"...\u2718 Failed to install plugin '
           '"%s": Plugin "%s": %s\n' % (path, path, path, cause))
    with tempfile.TemporaryDirectory() as tmp:
        f = pathlib.Path(tmp) / "install.log"
        f.write_text(log)
        out = sp.run(["bash", "-c", '. "%s"; cb_detail "%s"'
                      % (ROOT / "tests/runtime/lib/authprobe.sh", f)],
                     capture_output=True, text=True).stdout.strip()
    assert cause in out, out


@case("a non-auth failure is UNMEASURED, not BLOCKED")
def _unknown_unmeasured():
    """Nothing was established about the credential, and BLOCKED would
    claim an external prerequisite had been identified."""
    blob = run_stage("auth", gateway_env(), mode="broken")
    assert status_of(blob) == "UNMEASURED", status_of(blob)


@case("authentication is asked once, not once per stage")
def _probe_is_cached():
    """On a metered free tier the limit is requests per day, not tokens.
    Six stages each asking separately turned one question into six."""
    with tempfile.TemporaryDirectory() as tmp:
        tmp = pathlib.Path(tmp)
        bindir = tmp / "bin"
        bindir.mkdir()
        counter = tmp / "calls"
        fake = bindir / "claude"
        fake.write_text(FAKE.replace(
            "case \"${CB_FAKE_MODE:-ok}\" in",
            "echo x >> %s\ncase \"${CB_FAKE_MODE:-ok}\" in" % counter))
        fake.chmod(0o755)
        work = tmp / "work"
        work.mkdir()
        env = {"PATH": "%s:%s" % (bindir, os.environ.get("PATH", "")),
               "HOME": str(tmp), "CB_ROOT": str(ROOT),
               "CB_WORKDIR": str(work), "CB_FAKE_MODE": "ok"}
        env.update(gateway_env())
        for stage in ("auth", "skill", "agent", "subagent"):
            subprocess.run(["bash", str(STAGES), stage], env=env,
                           capture_output=True, text=True, timeout=180,
                           cwd=str(work))
        calls = counter.read_text().count("x") if counter.exists() else 0
    assert calls == 1, "the host was invoked %d times for one answer" % calls


@case("a refused install is not a passing plugin stage")
def _plugin_refusal_is_fail():
    """The stage is named for what the host does with the package, and
    its status came from a local generator comparison instead. A reader
    saw PASS beside a log recording a refusal."""
    blob = run_stage("plugin", gateway_env(), mode="ok")
    assert status_of(blob) == "FAIL", status_of(blob)
    assert "install_result=REFUSED" in blob, blob
    # The ambiguity this used to carry has been removed rather than
    # restated. The invocation now matches the shape the host documents,
    # so a refusal is about the package or the registry — and the reason
    # has to say so, because the earlier wording let a probe defect be
    # read as a package defect for as long as it went unexamined.
    assert "which is the shape the host documents" in blob, blob
    assert "not the invocation" in blob, blob
    assert "no such plugin" in blob, blob


@case("the install reference comes from the registry, not this script")
def _identity_is_read_not_written():
    """The host installs by name. A name hard-coded here would let the
    probe pass while the marketplace declared something else — the stage
    would be measuring agreement with itself."""
    import json
    blob = run_stage("plugin", gateway_env(), mode="ok")
    market = json.loads((ROOT / ".claude-plugin" / "marketplace.json")
                        .read_text())
    ref = "%s@%s" % (market["plugins"][0]["name"], market["name"])
    assert ref in blob, (ref, blob)

    stages = (ROOT / "tests/runtime/claude/stages.sh").read_text()
    assert market["name"] not in stages, "the marketplace name is written in"
    # The path variable still exists and should: hooks.json is read off
    # disk. What must not happen is handing that path to the subcommand
    # that documents a name.
    assert 'claude plugin "$SUB" "$REF"' in stages, "install is not by name"
    assert 'claude plugin "$SUB" "$PLUGIN"' not in stages
    assert 'claude plugin "$SUB" "$ROOT' not in stages


@case("an accepted install is what makes the plugin stage pass")
def _plugin_accept_is_pass():
    blob = run_stage("plugin", gateway_env(), mode="plugin-ok")
    assert status_of(blob) == "PASS", status_of(blob)
    assert "install_result=ACCEPTED" in blob, blob


@case("no plugin subcommand is UNSUPPORTED, not a failure")
def _plugin_unsupported():
    """A host that offers no such mechanism has not failed at one."""
    blob = run_stage("plugin", gateway_env(), mode="no-plugin-cmd")
    assert status_of(blob) == "UNSUPPORTED", status_of(blob)


@case("CB-155 stages stay honestly unmeasured")
def _phase_two_not_faked():
    """AC-10. A passing auth stage does not promote a capability nobody
    has watched work."""
    for stage in ("skill", "agent", "subagent", "hook", "veto", "finish"):
        blob = run_stage(stage, gateway_env())
        assert status_of(blob) == "UNMEASURED", (stage, status_of(blob))


def main():
    failures = []
    for name, fn in CASES:
        try:
            fn()
        except AssertionError as exc:
            failures.append("%s: %s" % (name, exc))
        except Exception as exc:  # noqa: BLE001 - report, do not mask
            failures.append("%s: raised %s: %s"
                            % (name, type(exc).__name__, exc))
    if failures:
        print("test-provider-path: %d case(s) failed" % len(failures),
              file=sys.stderr)
        for line in failures:
            print("  " + line, file=sys.stderr)
        return 1
    print("test-provider-path: %d case(s) hold" % len(CASES))
    return 0


if __name__ == "__main__":
    sys.exit(main())
