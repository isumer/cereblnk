#!/usr/bin/env python3
"""check-diagram — a diagram must not lie about the repository.

`check-readme` exists because the front page printed counts nobody
compared to the tree. A diagram is the same defect with better
production values: it names hooks, files them under events, and lists
commands, and none of that was reachable by a checker. A picture drawn
from a stale reading is worse than no picture, because it is the
artifact a reader trusts fastest and questions last.

The assets are generated, so most drift is prevented rather than
detected — see scripts/build-diagrams, which is what proves a committed
asset is not stale. This suite is the second half: it reads the
committed files and asserts what they claim, so a hand-edited or
hand-supplied SVG fails the same way a generated one would.

Structure is read from named groups, not from coordinates. An event
column is `<g id="event-SubagentStop">`, so the claim being made is
explicit in the document rather than inferred from where a label
happened to land. That also means this suite survives an asset produced
by something other than our own generator, provided it keeps live text
and the same group naming.

Asserts:
  D-1  every hook named in a diagram exists as hooks/scripts/<name>.sh
  D-2  every hook that ships appears in a diagram — a mechanism the
       picture omits reads as one that does not exist
  D-3  the events named in the diagrams are exactly the events in
       hooks.json
  D-4  each hook sits in the group of the event that actually fires it
  D-5  every /cb-* command in a diagram is a shipped entry point, and
       every entry point appears

Deliberately not asserted: counts. A diagram that prints totals must be
redrawn whenever a skill is added, and a picture with a redraw cost gets
redrawn late or never. Totals live in README, where check-readme already
guards them.

Exit: 0 clean · 1 drift, each with its D-id · 2 nothing to check.
"""
import pathlib
import re
import sys
import xml.etree.ElementTree as ET

ROOT = pathlib.Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "scripts/lib"))

import facts  # noqa: E402

ASSETS = ROOT / "docs/assets"
NS = "{http://www.w3.org/2000/svg}"
GLYPH = re.compile(r"^[\u25a0\u25a1]\s*")


def texts(node):
    for el in node.iter(f"{NS}text"):
        if el.text:
            yield el.text.strip()


def main():
    diagrams = sorted(ASSETS.glob("*.svg")) if ASSETS.is_dir() else []
    if not diagrams:
        print("check-diagram: no diagrams under docs/assets", file=sys.stderr)
        return 2

    wiring = facts.hooks()
    real = {ev: {h["name"] for h in items} for ev, items in wiring.items()}
    shipped = set(facts.shipped_hooks())
    entry_points = {e["name"] for e in facts.entry_points()}

    drawn, named, commands, readable = {}, set(), set(), 0
    for svg in diagrams:
        root = ET.parse(svg).getroot()
        for g in root.iter(f"{NS}g"):
            gid = g.get("id", "")
            if not gid.startswith("event-"):
                continue
            event = gid[len("event-"):]
            for s in texts(g):
                # Only a glyph-prefixed line is a hook row. Wrapped
                # description lines are also short lowercase strings, and
                # treating them as names produced ten false positives the
                # first time this ran.
                if not s or s[0] not in "\u25a0\u25a1":
                    continue
                name = GLYPH.sub("", s)
                if re.fullmatch(r"[a-z][a-z0-9-]+", name) and name != event:
                    drawn.setdefault(event, set()).add(name)
                    named.add(name)
                    readable += 1
        for s in texts(root):
            for m in re.findall(r"/(cb-[a-z0-9-]+)", s):
                commands.add(m)

    bad = 0

    # An asset whose text was flattened to outlines yields nothing, and a
    # suite that reads nothing and reports success is worse than absent.
    if readable == 0:
        print("D-0 no hook names are readable in any diagram — text may have "
              "been converted to outlines, which no checker can inspect")
        return 1

    for name in sorted(named - shipped):
        print(f"D-1 a diagram names {name}, which no hook script provides")
        bad += 1
    for name in sorted(shipped - named):
        print(f"D-2 {name}.sh ships but no diagram shows it")
        bad += 1
    for event in sorted(set(drawn) - set(real)):
        print(f"D-3 a diagram shows event {event}, which fires no hook")
        bad += 1
    for event in sorted(set(real) - set(drawn)):
        print(f"D-3 event {event} fires hooks but no diagram shows it")
        bad += 1
    for event in sorted(set(drawn) & set(real)):
        for name in sorted(drawn[event] - real[event]):
            print(f"D-4 a diagram files {name} under {event}; hooks.json "
                  f"does not")
            bad += 1
        for name in sorted(real[event] - drawn[event]):
            print(f"D-4 {name} fires on {event}; the diagram files it "
                  f"elsewhere")
            bad += 1
    for name in sorted(commands - entry_points):
        print(f"D-5 a diagram shows /{name}, which no entry point provides")
        bad += 1
    for name in sorted(entry_points - commands):
        print(f"D-5 /{name} ships but no diagram shows it")
        bad += 1

    if bad:
        print(f"check-diagram: {bad} drift(s)", file=sys.stderr)
        return 1
    print(f"check-diagram: {len(named)} hooks across {len(drawn)} events and "
          f"{len(commands)} commands, checked across {len(diagrams)} diagrams")
    return 0


if __name__ == "__main__":
    sys.exit(main())
