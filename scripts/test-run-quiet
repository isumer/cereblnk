#!/usr/bin/env python3
"""test-run-quiet (CB-085) — asserts the tool-output gate's contract.

Cases:
  1. big-output success: digest <= 20 lines, full output in log,
     exit 0 propagated, header states the real line count.
  2. failing command, unstructured: digest contains tail section,
     exit code propagated verbatim.
  3. surefire fixture: failing test class surfaces in digest;
     passing-only report does not.
  4. compile-error lines: deduplicated, capped at 10.
  5. missing args: usage error, exit 64.
"""
import os, pathlib, shutil, subprocess, sys, tempfile

ROOT = pathlib.Path(__file__).resolve().parent.parent
RQ = ROOT / "plugins/cereblnk/scripts/run-quiet"

def run(args, cwd, env_extra=None):
    env = dict(os.environ)
    env.update(env_extra or {})
    return subprocess.run(["bash", str(RQ)] + args, cwd=cwd,
                          capture_output=True, text=True, env=env)

def main():
    bad = 0
    def check(name, ok, detail=""):
        nonlocal bad
        print(f"  {'ok' if ok else 'FAIL'}  {name}" + (f" — {detail}" if detail and not ok else ""))
        bad += 0 if ok else 1

    tmp = pathlib.Path(tempfile.mkdtemp(prefix="rq-test-"))
    try:
        logs = {"CB_RUN_LOG_DIR": str(tmp / "logs")}

        # 1. big output, success
        r = run(["t1", "bash", "-c", "seq 1 500"], cwd=tmp, env_extra=logs)
        log = tmp / "logs/t1.log"
        check("exit 0 propagated", r.returncode == 0, f"rc={r.returncode}")
        check("digest bounded", len(r.stdout.strip().splitlines()) <= 20,
              f"{len(r.stdout.splitlines())} lines")
        check("full output in log", log.exists() and len(log.read_text().splitlines()) == 500)
        check("header has real count", "lines=500" in r.stdout)

        # 2. failure, unstructured -> tail + propagated code
        r = run(["t2", "bash", "-c", "echo boom; exit 7"], cwd=tmp, env_extra=logs)
        check("exit 7 propagated", r.returncode == 7, f"rc={r.returncode}")
        check("tail on failure", "tail:" in r.stdout and "boom" in r.stdout)

        # 3. surefire fixture
        sf = tmp / "mod/target/surefire-reports"
        sf.mkdir(parents=True)
        (sf / "com.example.FailingTest.txt").write_text(
            "Test set: com.example.FailingTest\n"
            "Tests run: 3, Failures: 1, Errors: 0, Skipped: 0\n")
        (sf / "com.example.PassingTest.txt").write_text(
            "Test set: com.example.PassingTest\n"
            "Tests run: 5, Failures: 0, Errors: 0, Skipped: 0\n")
        r = run(["t3", "bash", "-c", "exit 1"], cwd=tmp, env_extra=logs)
        check("failing class in digest", "com.example.FailingTest" in r.stdout)
        check("passing class absent", "com.example.PassingTest" not in r.stdout)

        # 4. compile errors deduplicated + capped
        lines = "\n".join(f"[ERROR] src/A.java:[{i},5] bad" for i in range(1, 30))
        dup = "[ERROR] src/A.java:[1,5] bad"
        r = run(["t4", "bash", "-c", f"printf '%s\\n%s\\n' '{dup}' '{lines}'; exit 1"],
                cwd=tmp, env_extra=logs)
        errs = [l for l in r.stdout.splitlines() if "A.java" in l]
        check("compile errors capped at 10", 0 < len(errs) <= 10, f"{len(errs)}")
        check("deduplicated", len(errs) == len(set(errs)))

        # 5. usage
        r = run(["only-task-id"], cwd=tmp, env_extra=logs)
        check("usage exit 64", r.returncode == 64, f"rc={r.returncode}")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)

    print("test-run-quiet:", "all green" if bad == 0 else f"{bad} FAILURES")
    return 1 if bad else 0

if __name__ == "__main__":
    sys.exit(main())
