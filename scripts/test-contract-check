#!/usr/bin/env python3
"""test-contract-check — acceptance run for cross-surface contracts (CB-116).

Usage: scripts/test-contract-check   Exit: 0 all pass · 1 any failure
"""
import json, os, pathlib, shutil, subprocess, sys, tempfile

ROOT = pathlib.Path(__file__).resolve().parent.parent
CHECK = ROOT / "plugins/cereblnk/scripts/contract-check"
HOOK = ROOT / "plugins/cereblnk/hooks/scripts/contract-floor.sh"
RUN_FLAG = ROOT / "plugins/cereblnk/scripts/run-flag"
FIXTURES = ROOT / "tests/fixtures/contract-check"

CONTRACT = """contract: chat-stomp
version: 1
parties: ui, api

## Channels
| channel | direction | payload |
| --- | --- | --- |
| /topic/messages | server->client | MessageDto |
| /app/send | client->server | SendCommand |

## Migration
| old | new | status |
| --- | --- | --- |
| POST /api/messages | /app/send | replaced |
"""


def write(p, text):
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(text, encoding="utf-8")


def build(base, ui_body, api_body, contract=CONTRACT):
    write(base / ".claude/cereblnk/memory/contracts/chat.md", contract)
    write(base / "src/components/Chat.tsx", ui_body)
    write(base / "server/controller/ChatController.java", api_body)


UI_GOOD = ('export function wire() { stomp.subscribe("/topic/messages", f); '
           'stomp.send("/app/send", {}); }\n')
UI_MISSING_SUB = 'export function wire() { stomp.send("/app/send", {}); }\n'
UI_OLD_LEFT = UI_GOOD + 'export function legacy() { fetch("/api/messages"); }\n'
API_GOOD = ('@MessageMapping("/app/send")\npublic void in() {}\n'
            '@SendTo("/topic/messages")\npublic String out() { return "x"; }\n')


def check(base, *surfaces):
    r = subprocess.run([sys.executable, str(CHECK), str(base)] + list(surfaces),
                       capture_output=True, text=True)
    return r.returncode, r.stdout.strip().splitlines()


def main():
    fails, ran = [], 0

    def case(name, ok, detail=""):
        nonlocal ran
        ran += 1
        if not ok:
            fails.append("%s%s" % (name, (": " + detail) if detail else ""))

    with tempfile.TemporaryDirectory() as td:
        base = pathlib.Path(td) / "proj"

        build(base, UI_GOOD, API_GOOD)
        rc, out = check(base)
        case("matched surfaces are clean", rc == 0 and not out, "rc=%d out=%r" % (rc, out))

        build(base, UI_MISSING_SUB, API_GOOD)
        rc, out = check(base)
        case("missing channel on one side is reported",
             rc == 1 and any("ui" in l and "/topic/messages" in l for l in out),
             "rc=%d out=%r" % (rc, out))

        rc, out = check(base, "api")
        case("the matched side closes alone — parallelism preserved",
             rc == 0 and not out, "rc=%d out=%r" % (rc, out))

        rc, out = check(base, "ui")
        case("the unmatched side is still blocked alone", rc == 1, "rc=%d" % rc)

        build(base, UI_OLD_LEFT, API_GOOD)
        rc, out = check(base)
        case("a replaced path left behind is reported",
             rc == 1 and any("/api/messages" in l for l in out), "rc=%d out=%r" % (rc, out))

        deferred = CONTRACT.replace("| POST /api/messages | /app/send | replaced |",
                                    "| POST /api/messages | /app/send | deferred |")
        build(base, UI_OLD_LEFT, API_GOOD, contract=deferred)
        rc, out = check(base)
        case("deferred rows are not enforced", rc == 0 and not out, "rc=%d out=%r" % (rc, out))

        build(base, UI_GOOD, API_GOOD,
              contract=(FIXTURES / "channels-deferred.md").read_text(encoding="utf-8"))
        rc, out = check(base, "ui")
        case("deferred Channels rows are not enforced",
             rc == 0 and not out, "rc=%d out=%r" % (rc, out))

        build(base, UI_GOOD, API_GOOD,
              contract=(FIXTURES / "channels-unbacked.md").read_text(encoding="utf-8"))
        rc, out = check(base, "ui")
        case("non-deferred unbacked Channels rows are reported",
             rc == 1 and any("/topic/unbacked" in l for l in out),
             "rc=%d out=%r" % (rc, out))

        shutil.rmtree(base / ".claude/cereblnk/memory/contracts")
        rc, out = check(base)
        case("no contract is a skip, not a pass", rc == 3, "rc=%d" % rc)

        rc, out = check(base / "nope")
        case("missing root is inert", rc == 3, "rc=%d" % rc)

    # ---- hook ----
    if shutil.which("bash") is None:
        print("test-contract-check: bash absent — hook checks skipped")
    else:
        with tempfile.TemporaryDirectory() as td:
            proj = pathlib.Path(td) / "proj"
            build(proj, UI_MISSING_SUB, API_GOOD)
            runctx = proj / ".claude/cereblnk/context/R-T"
            runctx.mkdir(parents=True)
            ledger = runctx / "exec.log"

            def reset(lines, baseline=""):
                ledger.write_text("".join(lines), encoding="utf-8")
                for f in runctx.glob("contract-floor.*.state"):
                    f.unlink()
                baseline_file = runctx / "contract-baseline.txt"
                if baseline is None:
                    if baseline_file.exists():
                        baseline_file.unlink()
                else:
                    baseline_file.write_text(baseline, encoding="utf-8")

            def run_hook(agent="frontend-agent", active=False, extra=None):
                d = {"agent_type": agent}
                if active:
                    d["stop_hook_active"] = True
                env = dict(os.environ, CLAUDE_PROJECT_DIR=str(proj))
                if extra:
                    env.update(extra)
                return subprocess.run(["bash", str(HOOK)], input=json.dumps(d),
                                      capture_output=True, text=True, env=env, cwd=str(proj))

            reset(["1\tfrontend-agent\tedit\tui\n"])
            r = run_hook()
            case("hook: empty baseline makes an unmatched surface new",
                 r.returncode == 2, "rc=%d" % r.returncode)
            case("hook: message names the channel", "/topic/messages" in r.stderr,
                 r.stderr.strip()[:90])

            rc, existing = check(proj, "ui")
            reset(["1\tfrontend-agent\tedit\tui\n"],
                  "\n".join(sorted(existing)) + "\n")
            r = run_hook()
            case("hook: pre-existing contract failure does not block",
                 rc == 1 and r.returncode == 0, "check=%d hook=%d" % (rc, r.returncode))
            case("hook: pre-existing contract failure is a risk note",
                 "Pre-existing contract risk" in r.stderr
                 and "/topic/messages" in r.stderr, r.stderr.strip()[:120])

            build(proj, UI_GOOD, API_GOOD)
            rc, clean = check(proj, "ui")
            reset(["1\tfrontend-agent\tedit\tui\n"],
                  "\n".join(sorted(clean)))
            write(proj / "src/components/Chat.tsx", UI_MISSING_SUB)
            r = run_hook()
            case("hook: a contract break introduced after baseline blocks",
                 rc == 0 and r.returncode == 2, "check=%d hook=%d" % (rc, r.returncode))
            case("hook: introduced break names the channel",
                 "/topic/messages" in r.stderr, r.stderr.strip()[:120])

            reset(["1\tfrontend-agent\tedit\tui\n"], baseline=None)
            r = run_hook()
            case("hook: missing baseline fails open", r.returncode == 0,
                 "rc=%d" % r.returncode)
            case("hook: missing baseline reports comparison risk",
                 "missing or unreadable" in r.stderr and "/topic/messages" in r.stderr,
                 r.stderr.strip()[:120])

            reset(["1\tbackend-agent\tedit\tapi\n"])
            r = run_hook(agent="backend-agent")
            case("hook: the matched surface closes", r.returncode == 0, "rc=%d" % r.returncode)

            reset(["1\tfrontend-agent\tedit\tui\n"])
            r = run_hook(active=True)
            case("hook: stop_hook_active always allows", r.returncode == 0, "rc=%d" % r.returncode)

            reset(["1\tfrontend-agent\tedit\tui\n"])
            rcs = [run_hook(extra={"CB_CONTRACT_NUDGES": "2"}).returncode for _ in range(3)]
            case("hook: nudge cap releases after the limit", rcs == [2, 2, 0], "rcs=%r" % rcs)

            shutil.rmtree(proj / ".claude/cereblnk/memory/contracts")
            reset(["1\tfrontend-agent\tedit\tui\n"])
            r = run_hook()
            case("hook: no contract means no floor", r.returncode == 0, "rc=%d" % r.returncode)

        with tempfile.TemporaryDirectory() as td:
            proj = pathlib.Path(td) / "proj"
            build(proj, UI_MISSING_SUB, API_GOOD)
            cbdir = proj / ".claude/cereblnk"
            run_id = "R-CONTRACT-BASELINE"
            env = dict(os.environ, CLAUDE_PROJECT_DIR=str(proj))
            armed = subprocess.run(
                ["bash", str(RUN_FLAG), "arm", str(cbdir), run_id],
                capture_output=True, text=True, env=env, cwd=str(proj))
            baseline_file = cbdir / "context" / run_id / "contract-baseline.txt"
            expected_rc, expected = check(proj)
            actual = (baseline_file.read_text(encoding="utf-8").splitlines()
                      if baseline_file.is_file() else None)
            case("run-flag: arm writes a sorted contract baseline",
                 armed.returncode == 0 and expected_rc == 1
                 and actual == sorted(set(expected)),
                 "arm=%d baseline=%r" % (armed.returncode, actual))
            completed = subprocess.run(
                ["bash", str(RUN_FLAG), "complete", str(cbdir)],
                capture_output=True, text=True, env=env, cwd=str(proj))
            case("run-flag: complete removes the contract baseline",
                 completed.returncode == 0 and not baseline_file.exists(),
                 "rc=%d exists=%r" % (completed.returncode, baseline_file.exists()))

            shutil.rmtree(cbdir / "memory/contracts")
            empty_id = "R-EMPTY-CONTRACT-BASELINE"
            armed = subprocess.run(
                ["bash", str(RUN_FLAG), "arm", str(cbdir), empty_id],
                capture_output=True, text=True, env=env, cwd=str(proj))
            empty_file = cbdir / "context" / empty_id / "contract-baseline.txt"
            case("run-flag: nothing-to-check writes an empty baseline",
                 armed.returncode == 0 and empty_file.is_file()
                 and empty_file.read_text(encoding="utf-8") == "",
                 "rc=%d content=%r" % (armed.returncode,
                                        empty_file.read_text(encoding="utf-8")
                                        if empty_file.is_file() else None))
            disarmed = subprocess.run(
                ["bash", str(RUN_FLAG), "disarm", str(cbdir)],
                capture_output=True, text=True, env=env, cwd=str(proj))
            case("run-flag: disarm removes the contract baseline",
                 disarmed.returncode == 0 and not empty_file.exists(),
                 "rc=%d exists=%r" % (disarmed.returncode, empty_file.exists()))

    if fails:
        print("test-contract-check: %d/%d FAILED" % (len(fails), ran))
        for f in fails:
            print("  FAIL  %s" % f)
        return 1
    print("test-contract-check: %d checks passed" % ran)
    return 0


if __name__ == "__main__":
    sys.exit(main())
