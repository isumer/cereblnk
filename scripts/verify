#!/usr/bin/env python3
"""verify — the single deterministic acceptance entry for this repo.

Runs every scripted checker in one pass and reports one line per
suite. This is the mechanical half of the verification story; workflow
behavior (prompt-driven) is NOT covered here and never will be — it can
only be established by running the workflows. Claiming workflow
correctness from this script's green would be Part II trap #8.

Suites (each asserts exit codes AND expected output, incl. failure and
unsupported paths where the tool has them):
  check-skill-relations   skill graph integrity
  test-xmltools           xml/xsd tools, fixtures
  test-docparse           office/pdf golden files + path cases
  test-docindex           segmentation ladder + the read floor (CB-112)
  test-exec-floor         edit/exec ledger + the execution floor (CB-113)
  test-reachability       orphan-symbol analyser + the reach floor (CB-114)
  test-env-lifecycle      environment lifecycle + teardown safety (CB-115)
  test-contract-check     cross-surface contract reconciliation (CB-116)
  test-behavior-check     behavior rulings in a rewrite contract (CB-121)
  test-hooks              four guards, full path matrix
  test-run-quiet          tool-output gate contract (CB-085)
  skill-frontmatter       every skill loads: fm present, names sane (CB-088)
  rules-layer             constraint files load and resolve (CB-092)
  test-context-budget     capacity follows the window (CB-094)
  budget-literals         no window size written as a fact (CB-094)
  test-lifecycle-scripts  spec-assemble/run-status/ensure-gitignore (CB-086)
  test-skill-selection    task-scoped skill floor + hooks (CB-097)
  check-agent-skills      agent<->skill graph: no dangling, no orphan,
                          preload inside budget (CB-097)
  test-artifact-gate      R-2 loss gate + R-3 history preservation (CB-091)
  acp-lint domain floor   a security task may not be assigned below
                          level 3; an unfloored role keeps its own (F-26)
  acp-lint fixtures       canonical block passes; 5-violation block
                          reports all five checklist IDs; task blocks
                          with indexed documents, both ways (CB-112)
  select-agents triples   CB-044 dry-run expectations
  check-exec-bit          hooks and the verify entry point keep the mode
                          bit; a hook that cannot run fails silently
  check-readme            the front page's command list and counts match
                          the tree it describes (CB-104)
  test-select-rules       the stack gate subtracts only what it can
                          prove; absent profile subtracts nothing (CB-109)
  test-discovery         cascade triggers name evidence that real files
                          contain, not plausible-looking strings (CB-098)
  test-leakage            the leakage checker's own failure paths (CB-108)
  leakage scan            reference strings in tracked files; SKIPs when
                          no wordlist is configured — a skip is never a
                          pass, and the skip is printed (CB-108)

Usage: scripts/verify        Exit: 0 all green · 1 any failure
"""
import os, pathlib, re, subprocess, sys, tempfile

ROOT = pathlib.Path(__file__).resolve().parent.parent
S = ROOT / "scripts"; PS = ROOT / "plugins/cereblnk/scripts"

def sh(cmd, stdin=None):
    return subprocess.run(cmd, input=stdin, capture_output=True, text=True)

def main():
    results, bad = [], 0
    def suite(name, ok, detail="", skipped=False):
        nonlocal bad
        # A skip is reported, never counted as green. A suite that cannot
        # run must say so out loud — silence here is how an unenforced
        # check survives a release.
        if skipped:
            results.append(f"  SKIP  {name}" + (f" — {detail}" if detail else ""))
            return
        results.append(f"  {'PASS' if ok else 'FAIL'}  {name}" + (f" — {detail}" if detail and not ok else ""))
        bad += 0 if ok else 1

    for name in ("check-skill-relations", "test-xmltools", "test-docparse", "test-hooks", "test-run-quiet", "test-lifecycle-scripts", "test-artifact-gate", "test-context-budget",
                 "test-skill-selection", "test-discovery", "test-select-rules",
                 "test-docindex", "test-exec-floor",
                 "test-reachability", "test-env-lifecycle",
                 "test-contract-check", "test-behavior-check"):
        r = sh([sys.executable, str(S / name)])
        suite(name, r.returncode == 0, (r.stderr or r.stdout).strip().splitlines()[-1][:100] if r.returncode else "")

    lk_unit = sh([sys.executable, str(S / "test-leakage")])
    suite("test-leakage", lk_unit.returncode == 0,
          (lk_unit.stderr or lk_unit.stdout).strip().splitlines()[-1][:100]
          if lk_unit.returncode else "")

    lk = sh([sys.executable, str(S / "check-leakage")])
    suite("leakage scan", lk.returncode == 0,
          "no wordlist — set CB_LEAKAGE_WORDLIST to enable"
          if lk.returncode == 3
          else (lk.stderr or lk.stdout).strip().splitlines()[0][:100],
          skipped=(lk.returncode == 3))

    # CB-129: templates are copied verbatim into a user's run ledger, so
    # anything in one ships to their repository. `CB-097` was observed in
    # a project's T-00N.yaml, carried out of the Response Block template
    # comment an agent had copied along with the fields. A backlog number
    # means nothing in someone else's repository.
    #
    # Scoped to protocols/ on purpose. Policies, skills and agents cite CB
    # numbers as provenance and are READ, not copied — banning them there
    # would remove useful history to solve a problem those files do not
    # have. This is also not the leakage scanner's job: that list is
    # deliberately uncommitted because publishing it would be the leak,
    # whereas backlog numbers are public in BACKLOG.md. Different problem,
    # separate check.
    tmpl_hits = []
    for f in sorted((ROOT / "plugins/cereblnk/protocols").rglob("*")):
        if not f.is_file():
            continue
        for n, line in enumerate(
                f.read_text(encoding="utf-8", errors="replace").splitlines(), 1):
            if re.search(r"\bCB-\d{3}\b", line):
                tmpl_hits.append(f"{f.relative_to(ROOT)}:{n}")
    suite("protocols carry no backlog ids", not tmpl_hits,
          ", ".join(tmpl_hits[:3]))

    # CB-131: eleven files told the conductor to arm the run with a raw
    # `mkdir`/`touch` pair. A raw command carries no environment, so an
    # unresolved $CB_DIR aimed at /flags and failed on permissions —
    # and nothing looked. DelegationGuard and RunGuard read that file
    # and treat its absence as "no run", so the failed arm did not
    # weaken the boundary, it removed it. The session then ran a whole
    # workflow inline: no Task Blocks on disk, and a context-length
    # error at 96001 tokens.
    rf = PS / "run-flag"
    rf_root = pathlib.Path(tempfile.mkdtemp(prefix="cb-flag-")) / "cereblnk"
    fw = []
    a = sh(["bash", str(rf), "arm", str(rf_root)])
    if a.returncode != 0 or not (rf_root / "flags/run-active").is_file():
        fw.append(f"arm did not land (rc={a.returncode})")
    d = sh(["bash", str(rf), "disarm", str(rf_root)])
    if d.returncode != 0 or (rf_root / "flags/run-active").exists():
        fw.append(f"disarm did not remove it (rc={d.returncode})")
    # the case that started this: a target that cannot be written must
    # be loud, because a silent failure is indistinguishable from a
    # session that is simply not a run.
    u = sh(["bash", str(rf), "arm", "/proc/cb-nonexistent/cereblnk"])
    if u.returncode == 0:
        fw.append("an unwritable target armed silently")
    if "NOT active" not in u.stderr:
        fw.append("the failure does not say the protection is inactive")
    # and the prose must call the script, or the script is never run
    raw = 'touch "$CB_DIR/flags/run-active"'
    for f in sorted((ROOT / "plugins/cereblnk").rglob("*.md")):
        if raw in f.read_text(encoding="utf-8", errors="replace"):
            fw.append(f"{f.relative_to(ROOT)} still arms by hand")
    # F-16/F-20: careful and boundary were armed with a relative path,
    # so they landed next to the shell rather than under $CB_DIR. A
    # controlled experiment showed the same delete running when the flag
    # sat where the skill wrote it and blocked when it sat where the
    # hook reads. Both skills reported the protection as enabled either
    # way.
    for nm, extra in (("careful", []), ("boundary", ["src"])):
        a = sh(["bash", str(rf), "flag", nm, "arm", str(rf_root)] + extra)
        if a.returncode != 0 or not (rf_root / f"flags/{nm}").is_file():
            fw.append(f"{nm} did not land (rc={a.returncode})")
    if (rf_root / "flags/boundary").read_text().strip() != "src":
        fw.append("boundary lost its content")
    u2 = sh(["bash", str(rf), "flag", "careful", "arm",
             "/proc/cb-nonexistent/cereblnk"])
    if u2.returncode == 0 or "NOT active" not in u2.stderr:
        fw.append("an unwritable protection armed silently")
    for f in sorted((ROOT / "plugins/cereblnk/skills").rglob("SKILL.md")):
        t = f.read_text(encoding="utf-8", errors="replace")
        if ".claude/cereblnk/flags" in t:
            fw.append(f"{f.parent.name} still writes a flag by relative path")
    # F-01: CLAUDE_PROJECT_DIR won unconditionally and only hooks get
    # it, so in a session opened above the project the hooks and the
    # scripts resolved different trees. The baseline was written under
    # one and looked for under the other, and every floor exited 0.
    env_root = pathlib.Path(tempfile.mkdtemp(prefix="cb-root-"))
    (env_root / "proj/.git").mkdir(parents=True)
    (env_root / "proj/sub").mkdir(parents=True)
    (env_root / ".claude").mkdir(parents=True)
    cbenv = PS / "lib/cbenv.sh"
    def root_of(cwd, project_dir=None):
        env = dict(os.environ)
        env.pop("CLAUDE_PROJECT_DIR", None)
        if project_dir:
            env["CLAUDE_PROJECT_DIR"] = str(project_dir)
        r = subprocess.run(["bash", "-c", f'. "{cbenv}"; printf "%s" "$CB_DIR"'],
                           cwd=str(cwd), env=env, capture_output=True, text=True)
        return r.stdout.strip()
    as_script = root_of(env_root / "proj/sub")
    as_hook = root_of(env_root / "proj/sub", env_root)
    if as_script != as_hook:
        fw.append(f"root still splits: script={as_script} hook={as_hook}")
    if "proj" not in as_hook:
        fw.append("the nested project lost to the session directory")
    # a marker OUTSIDE the session root must not win
    outside = root_of(env_root / "proj/sub", env_root / "proj/sub")
    if str(env_root / "proj/sub") not in outside:
        fw.append("an explicit project dir was overridden from below")
    suite("run flag is armed by a mechanism", not fw, "; ".join(fw[:3]))

    xb = sh([sys.executable, str(S / "check-exec-bit")])
    suite("check-exec-bit", xb.returncode == 0,
          (xb.stdout or xb.stderr).strip().splitlines()[0][:100] if xb.returncode else "")

    rm = sh([sys.executable, str(S / "check-readme")])
    suite("check-readme", rm.returncode == 0,
          (rm.stdout or rm.stderr).strip().splitlines()[0][:100] if rm.returncode else "")

    bl = sh([sys.executable, str(S / "check-budget-literals")])
    suite("budget-literals", bl.returncode == 0,
          bl.stdout.strip().splitlines()[-1] if bl.stdout else "")

    # F-04: the policy cites this as a live guarantee, but it lived in
    # the repository scripts/ and the package does not carry those — so
    # anyone reading the policy from an install held the rule without
    # the checker. Moved into the plugin rather than copied: two copies
    # of a checker drift, which is the defect class this release keeps
    # closing.
    ags = sh([sys.executable, str(PS / "check-agent-skills")])
    # F-04: it must be reachable from an install, not just from here.
    if not (ROOT / "plugins/cereblnk/scripts/check-agent-skills").is_file():
        suite("check-agent-skills ships", False, "not in the package")
    else:
        suite("check-agent-skills ships", True, "")
    suite("check-agent-skills", ags.returncode == 0,
          ags.stdout.strip().splitlines()[-1] if ags.stdout else "")

    r_ok = sh([sys.executable, str(S / "check-rules")])
    suite("rules-layer", r_ok.returncode == 0, r_ok.stdout.strip().splitlines()[-1] if r_ok.stdout else "")

    fm_ok = sh([sys.executable, str(S / "check-skill-frontmatter")])
    fm_bad = sh([sys.executable, str(S / "check-skill-frontmatter"),
                 str(ROOT / "tests/fixtures/frontmatter/bad-skills")])
    suite("skill-frontmatter", fm_ok.returncode == 0 and fm_bad.returncode == 1
          and "F-1" in fm_bad.stdout and "F-3" in fm_bad.stdout,
          f"ok rc={fm_ok.returncode}, bad rc={fm_bad.returncode}")

    g_ok = sh(["bash", str(S / "ground-check"), str(ROOT / "tests/fixtures/grounding/ok-block.yaml"), str(ROOT)])
    g_bad = sh(["bash", str(S / "ground-check"), str(ROOT / "tests/fixtures/grounding/bad-block.yaml"), str(ROOT)])
    suite("ground-check fixtures", g_ok.returncode == 0 and g_bad.returncode == 1,
          f"ok rc={g_ok.returncode}, bad rc={g_bad.returncode}")

    r = sh(["bash", str(S / "authoring-lint"), "manifest"])
    suite("authoring-lint manifest", r.returncode == 0,
          (r.stderr or r.stdout).strip().splitlines()[-1][:100] if r.returncode else "")

    good = sh(["bash", str(PS / "acp-lint"), str(ROOT / "tests/fixtures/acp/good-block.yaml")])
    bad_b = sh(["bash", str(PS / "acp-lint"), str(ROOT / "tests/fixtures/acp/bad-block.yaml")])
    ids = ("V-3", "V-4", "V-5", "V-7", "V-10")
    # A Task Block carrying indexed documents is admissible; a malformed
    # doc_id, an empty section list and a non-outline section id are not.
    t_good = sh(["bash", str(PS / "acp-lint"), str(ROOT / "tests/fixtures/acp/good-task-block.yaml")])
    t_bad = sh(["bash", str(PS / "acp-lint"), str(ROOT / "tests/fixtures/acp/bad-task-block.yaml")])
    # CB-125: a run spawned a specialist that was never shipped, got a
    # silent no-op, re-ran the work on a general-purpose agent and wrote
    # the block itself. The fabricated verdict reached the gate. The
    # roster is the one thing Cereblnk knows without discovering
    # anything, so the block that claims a role has to match it.
    _acp_good = (ROOT / "tests/fixtures/acp/good-block.yaml").read_text()
    _tmp = pathlib.Path(tempfile.mkdtemp(prefix="cb-acp-"))
    fake = _tmp / "fabricated-role.yaml"
    fake.write_text(
        _acp_good
        .replace("role: SecurityAgent", "role: DomainExpert"),
        encoding="utf-8")
    f_bad = sh(["bash", str(PS / "acp-lint"), str(fake)])
    real = _tmp / "real-role.yaml"
    real.write_text(
        _acp_good
        .replace("role: SecurityAgent", "role: security-agent"),
        encoding="utf-8")
    f_ok = sh(["bash", str(PS / "acp-lint"), str(real)])
    # ACP writes the role CamelCase (`role: SecurityAgent`) while the
    # roster is filenames (`security-agent.md`). Both spellings have to
    # resolve, or the check rejects every well-formed block there is.
    camel = _tmp / "camel-role.yaml"
    camel.write_text(_acp_good, encoding="utf-8")
    f_camel = sh(["bash", str(PS / "acp-lint"), str(camel)])
    # CB-127: the assignment is where an invented role is written first.
    # Before this, the check ran on responses only and the Task Block
    # carrying `role: domain-expert` sailed through — twenty-seven
    # minutes ahead of the block that got refused.
    t_fake = _tmp / "fabricated-task-role.yaml"
    t_fake.write_text(
        (ROOT / "tests/fixtures/acp/good-task-block.yaml").read_text()
        .replace("role: RequirementsAgent", "role: DomainExpert"),
        encoding="utf-8")
    t_bad_role = sh(["bash", str(PS / "acp-lint"), str(t_fake)])
    suite("acp-lint roster",
          f_bad.returncode == 1 and "is not a Cereblnk agent" in f_bad.stderr
          and "not an agent" in f_bad.stderr
          and f_ok.returncode == 0 and f_camel.returncode == 0
          and t_bad_role.returncode == 1
          and "is not a Cereblnk agent" in t_bad_role.stderr,
          f"fabricated rc={f_bad.returncode}, spelled-out rc={f_ok.returncode}, "
          f"CamelCase rc={f_camel.returncode}, task rc={t_bad_role.returncode}")

    # F-26: two rules collided and nothing stated an order. A Task
    # Block carried `verification_level: 1` and `risk: low` for a
    # security task, while security-agent.md and the security-audit
    # skill both said "always level 3 — no exceptions, no fast path".
    # The agent chose 3 by judgment. risk-model.md now states the
    # precedence; T-2 is the mechanical half, checked at the
    # assignment because that is where the wrong number is written.
    t2_bad = sh(["bash", str(PS / "acp-lint"),
                 str(ROOT / "tests/fixtures/acp/security-task-level-1.yaml")])
    _t2 = _tmp / "security-task-level-3.yaml"
    _t2.write_text(
        (ROOT / "tests/fixtures/acp/security-task-level-1.yaml").read_text()
        .replace("verification_level: 1", "verification_level: 3"),
        encoding="utf-8")
    t2_ok = sh(["bash", str(PS / "acp-lint"), str(_t2)])
    # the qualified spelling select-agents now emits must reach the
    # same floor, or the block that names its agent correctly is the
    # one that escapes the check
    _t2q = _tmp / "security-task-qualified.yaml"
    _t2q.write_text(
        (ROOT / "tests/fixtures/acp/security-task-level-1.yaml").read_text()
        .replace("role: SecurityAgent",
                 "role: cereblnk:engineering:security-agent"),
        encoding="utf-8")
    t2_q = sh(["bash", str(PS / "acp-lint"), str(_t2q)])
    # a role WITHOUT an unconditional floor keeps its assigned level:
    # database and infra floors are conditional, and a checker that
    # cannot read the objective must not refuse a well-formed block
    _t2n = _tmp / "backend-task-level-1.yaml"
    _t2n.write_text(
        (ROOT / "tests/fixtures/acp/security-task-level-1.yaml").read_text()
        .replace("role: SecurityAgent", "role: BackendAgent"),
        encoding="utf-8")
    t2_n = sh(["bash", str(PS / "acp-lint"), str(_t2n)])
    suite("acp-lint domain floor",
          t2_bad.returncode == 1 and "T-2" in t2_bad.stderr
          and "risk-model" in t2_bad.stderr
          and t2_ok.returncode == 0
          and t2_q.returncode == 1 and "T-2" in t2_q.stderr
          and t2_n.returncode == 0,
          f"level-1 rc={t2_bad.returncode}, level-3 rc={t2_ok.returncode}, "
          f"qualified rc={t2_q.returncode}, unfloored rc={t2_n.returncode}")

    suite("acp-lint fixtures",
          good.returncode == 0 and bad_b.returncode == 1 and all(i in bad_b.stderr for i in ids)
          and t_good.returncode == 0 and t_bad.returncode == 1
          and t_bad.stderr.count("T-1") == 3,
          f"good rc={good.returncode}, bad rc={bad_b.returncode}, "
          f"task good rc={t_good.returncode}, task bad rc={t_bad.returncode} "
          f"({t_bad.stderr.count('T-1')} T-1 of 3), "
          f"ids={[i for i in ids if i not in bad_b.stderr]} missing")

    triples = [
        (["src/components/Button.tsx"], "frontend-agent", "gate_level: 1"),
        (["db/migrations/V7__x.sql"], "database-agent", "gate_level: 3"),
        (["src/main/java/AuthFilter.java"], "security-agent", "gate_level: 3"),
        # CB-103: an authored spec belongs to the writer, a README to the
        # reviewer. Both are .md; only the path separates them.
        (["memory/specs/export-format.md"], "technicalwriter-agent", "gate_level: 1"),
        # A spec ABOUT auth still raises the floor — the writer owns the
        # document, security-agent owns the surface it describes.
        (["memory/specs/auth-conversion.md"], "security-agent", "gate_level: 3"),
        (["README.md"], "docs-agent", "gate_level: 1"),
    ]
    ok = True; why = []
    for paths, agent, level in triples:
        r = sh(["bash", str(PS / "select-agents")] + paths)
        if r.returncode != 0 or agent not in r.stdout or level not in r.stdout:
            ok = False; why.append(paths[0])
        # The wrong specialist must not merely be outranked, it must be absent.
        if paths[0].startswith("memory/specs/") and "docs-agent" in r.stdout:
            ok = False; why.append(paths[0] + " (docs-agent still selected)")
    # CB-121: a rewrite has no diff to route on — the request is the
    # only signal. The analyst must be reachable from it, and the agent
    # the workflow excludes must not ride along.
    for text, want, level in [
        ("rewrite this legacy order module, the design is wrong",
         "legacy-analyst-agent", "gate_level: 3"),
        ("modernize the reporting module from scratch",
         "legacy-analyst-agent", "gate_level: 3"),
    ]:
        r = sh(["bash", str(PS / "select-agents"), "--text", text])
        if r.returncode != 0 or want not in r.stdout or level not in r.stdout:
            ok = False; why.append(text[:24])
        if "refactoring-agent" in r.stdout:
            ok = False; why.append(text[:24] + " (refactoring-agent selected)")

    # CB-124 asserted this branch exits 3 and does not repeat the step
    # just taken. CB-133 keeps the second half and drops the first: the
    # branch now infers a specialist and exits 0, because refusing
    # produced improvisation rather than a question. What must not come
    # back is the loop — advice that asks for the call already made —
    # and what must never be lost is the mark on the inference.
    r_txt = sh(["bash", str(PS / "select-agents"), "--text",
                "review the OrderValidator class"])
    if r_txt.returncode != 0:
        ok = False; why.append("unresolved --text no longer proceeds")
    if "inferred: true" not in r_txt.stdout:
        ok = False; why.append("the inference is not marked")
    if "re-run with --text" in r_txt.stderr:
        ok = False; why.append("unresolved --text still asks for --text")
    if "select-agents <path>" not in r_txt.stderr:
        ok = False; why.append("unresolved --text does not name the path route")
    if "not the fallback" in r_txt.stderr:
        ok = False; why.append("the refusal that had no way out is back")
    r_resolved = sh(["bash", str(PS / "select-agents"),
                     "src/main/java/com/x/OrderValidator.java"])
    if r_resolved.returncode != 0 or "backend-agent" not in r_resolved.stdout:
        ok = False; why.append("the path route the message names does not resolve")
    if "inferred: true" in r_resolved.stdout:
        ok = False; why.append("a routed choice was marked as inferred")

    # CB-132: the routing table must name something the spawn API
    # accepts. It emitted `docs-agent`; the platform wants
    # `cereblnk:engineering:docs-agent`, and a run spawned the bare form
    # four times because that is what the handoff told it to spawn.
    q = sh(["bash", str(PS / "select-agents"), "README.md"])
    qw = []
    if "  - cereblnk:engineering:docs-agent" not in q.stdout:
        qw.append("specialists are not spawnable names")
    if "  cereblnk:engineering:docs-agent: [" not in q.stdout:
        qw.append("skills_required keys drifted from the specialist list")
    q3 = sh(["bash", str(PS / "select-agents"), "src/main/java/AuthFilter.java"])
    if "cereblnk:core:challenger-agent" not in q3.stdout:
        qw.append("the mandatory level-3 specialist is not qualified")
    # a qualified role must still pass the roster check it feeds
    qf = _tmp / "qualified-role.yaml"
    qf.write_text(_acp_good.replace("role: SecurityAgent",
                                    "role: cereblnk:engineering:security-agent"),
                  encoding="utf-8")
    if sh(["bash", str(PS / "acp-lint"), str(qf)]).returncode != 0:
        qw.append("acp-lint rejects the qualified form it now receives")
    # F-21: three file kinds resolved to nothing while sql, css and
    # nginx resolved fine — so the cause was never the stack gate they
    # share. The routing table simply had no row for shell, YAML or
    # XML, nor for the AI configuration a request to restructure
    # `.claude/` names.
    sw2 = []
    for path, want in (("deploy.sh", "infra-agent"),
                       ("Makefile", "infra-agent"),
                       ("config.yaml", "infra-agent"),
                       ("pom.xml", "infra-agent"),
                       ("CLAUDE.md", "technicalwriter-agent"),
                       (".claude/rules/java.md", "technicalwriter-agent")):
        r = sh(["bash", str(PS / "select-agents"), path])
        if r.returncode != 0 or want not in r.stdout:
            sw2.append(f"{path} -> {want} missing")
        if "inferred: true" in r.stdout:
            sw2.append(f"{path} fell through to the inferred default")
    # the control group the journal used: these already worked
    for path, want in (("a.sql", "database-agent"), ("a.css", "frontend-agent"),
                       ("X.java", "backend-agent")):
        if want not in sh(["bash", str(PS / "select-agents"), path]).stdout:
            sw2.append(f"{path} regressed")
    suite("infrastructure and config surfaces route", not sw2, "; ".join(sw2[:3]))

    suite("agent names are spawnable", not qw, "; ".join(qw))

    suite("select-agents triples", ok, f"mismatch on {why}")

    # CB-128: the rules-side stack gate had never applied. detect-stack
    # caches to $CB_DIR/context/stack-profile.yaml; select-rules looked
    # for .claude/cereblnk/stack-profile.yaml, without the context/
    # segment, found nothing, and returned every glob match — the
    # behaviour CB-109 was written to replace. select-agents read the
    # same cache correctly, which is why one half of the gate worked.
    gate_root = pathlib.Path(tempfile.mkdtemp(prefix="cb-gate-"))
    (gate_root / "src/main/java/com/x").mkdir(parents=True)
    prof_dir = gate_root / ".claude/cereblnk/context"
    prof_dir.mkdir(parents=True)
    target = "src/main/java/com/x/Foo.java"

    def rules_for(cwd):
        r = subprocess.run(["python3", str(PS / "select-rules"), target],
                           cwd=str(cwd), capture_output=True, text=True)
        listed = [l.strip()[2:] for l in r.stdout.splitlines()
                  if l.startswith("  - ")]
        return r.stdout, listed

    ungated_out, ungated = rules_for(gate_root)
    (prof_dir / "stack-profile.yaml").write_text(
        "tokens:\n  - java\nmanifests:\n  - pom.xml\n", encoding="utf-8")
    gated_out, gated = rules_for(gate_root)

    ok, why = True, []
    if "absent" not in ungated_out:
        ok = False; why.append("no profile did not report absent")
    if "present" not in gated_out:
        ok = False; why.append("profile present but not read")
    # a java-only profile drops the framework rules and keeps the
    # language rules, which carry no stack token and are never gated
    if any("frameworks/spring-boot" in f for f in gated):
        ok = False; why.append("spring-boot survived a java-only profile")
    if not any("frameworks/spring-boot" in f for f in ungated):
        ok = False; why.append("spring-boot absent even ungated — fixture drifted")
    if not any("languages/java" in f for f in gated):
        ok = False; why.append("language rules were gated away")
    if len(gated) >= len(ungated):
        ok = False; why.append(f"gate reduced nothing ({len(ungated)} -> {len(gated)})")
    suite("select-rules gate", ok, "; ".join(why))

    # CB-130: three spring-boot rules claimed every file under
    # src/main/java, which is every class in a Maven project. Their own
    # Trigger tables say otherwise — hooks fires on property files,
    # controller mappings and config classes; patterns on units of work,
    # exceptions at the edge and off-thread work; security on endpoints,
    # payload binding and management output. A service class pulled all
    # three and used none. Directory globs are paired with filename
    # globs so a flat package layout still matches.
    sw = []
    # Its own root: gate_root carries a java-only profile, which gates
    # every spring-boot rule away and would prove nothing here.
    sb_root = pathlib.Path(tempfile.mkdtemp(prefix="cb-sb-"))
    for d in ("src/main/java/com/x/service", "src/main/java/com/x/controller",
              ".claude/cereblnk/context"):
        (sb_root / d).mkdir(parents=True)
    (sb_root / ".claude/cereblnk/context/stack-profile.yaml").write_text(
        "tokens:\n  - java\n  - spring-boot\nmanifests:\n  - pom.xml\n",
        encoding="utf-8")

    def rules_text(rel):
        return subprocess.run(["python3", str(PS / "select-rules"), rel],
                              cwd=str(sb_root), capture_output=True,
                              text=True).stdout

    r_svc = rules_text("src/main/java/com/x/service/PaymentService.java")
    r_ctl = rules_text("src/main/java/com/x/controller/OrderController.java")
    for rule in ("spring-boot/hooks.md", "spring-boot/security.md"):
        if rule in r_svc:
            sw.append(f"{rule} still matches a service class")
        if rule not in r_ctl:
            sw.append(f"{rule} lost the controller it is written for")
    if "spring-boot/coding-style.md" not in r_svc:
        sw.append("coding-style was narrowed; its triggers are project-wide")
    if "spring-boot/patterns.md" not in r_svc:
        sw.append("patterns lost the service layer it is written for")
    suite("spring-boot globs match their triggers", not sw, "; ".join(sw))

    print("verify:"); print("\n".join(results))
    if bad:
        print(f"verify: {bad} suite(s) failed", file=sys.stderr); return 1
    print("verify: all suites green (deterministic layer only — workflow behavior is not covered)")
    return 0

if __name__ == "__main__":
    sys.exit(main())
