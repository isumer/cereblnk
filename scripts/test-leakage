#!/usr/bin/env python3
"""test-leakage (CB-108) — the leakage checker's own acceptance.

Exit: 0 all cases pass · 1 any case failed
"""
import pathlib
import subprocess
import sys
import tempfile

ROOT = pathlib.Path(__file__).resolve().parent.parent
CHECK = ROOT / "scripts" / "check-leakage"
CLEAN = ROOT / "tests/fixtures/leakage/clean"
DIRTY = ROOT / "tests/fixtures/leakage/dirty"
TOKEN = "cbfixtureleak"


def run(wordlist, root):
    cmd = [sys.executable, str(CHECK)]
    if wordlist is not None:
        cmd += ["--wordlist", str(wordlist)]
    cmd.append(str(root))
    return subprocess.run(cmd, capture_output=True, text=True)


def main():
    failures = []

    def case(name, ok, detail=""):
        if not ok:
            failures.append(f"  FAIL  {name}" + (f" — {detail}" if detail else ""))

    with tempfile.TemporaryDirectory() as tmp:
        tmpdir = pathlib.Path(tmp)
        good = tmpdir / "wordlist.txt"
        good.write_text(f"# fixture list\n{TOKEN}\n\n", encoding="utf-8")
        empty = tmpdir / "empty.txt"
        empty.write_text("# only a comment\n\n", encoding="utf-8")
        absent = tmpdir / "does-not-exist.txt"

        r = run(good, CLEAN)
        case("T-1 clean tree exits 0", r.returncode == 0,
             f"rc={r.returncode} {r.stderr.strip()[:80]}")

        r = run(good, DIRTY)
        out = r.stdout + r.stderr
        case("T-2 seeded tree exits 1", r.returncode == 1, f"rc={r.returncode}")
        case("T-2 both occurrences reported", out.count("L-2  ") == 2,
             f"reported {out.count('L-2  ')}, expected 2")
        case("T-2 entry number shown", "entry #1" in out, "no entry number in output")

        r = run(absent, CLEAN)
        case("T-3 absent wordlist exits 3", r.returncode == 3, f"rc={r.returncode}")
        case("T-3 skip is stated", "skipped, not passed" in r.stdout, "skip not stated")

        r = run(empty, CLEAN)
        case("T-4 empty wordlist exits 3", r.returncode == 3, f"rc={r.returncode}")

        # T-5/T-6 expect two seeded case-folded word-boundary matches.
        r = run(good, DIRTY)
        out = r.stdout + r.stderr
        case("T-5 longer word is not a finding", out.count("L-2  ") == 2,
             "cbfixtureleakage matched, boundary lost")
        case("T-6 case-insensitive match found",
             "seeded.md:3" in out and "seeded.md:7" in out,
             "expected findings on lines 3 (lowercase) and 7 (mixed case)")

        case("T-7 matched string absent from output",
             TOKEN not in out.lower(),
             "the checker printed the string it was hiding")

        # T-8 — a tracked wordlist must fail, whatever else is true.
        tracked = ROOT / "tests/fixtures/leakage/clean/ok.md"
        r = run(tracked, CLEAN)
        case("T-8 tracked wordlist exits 1", r.returncode == 1, f"rc={r.returncode}")
        case("T-8 L-3 named", "L-3" in r.stderr, "violation id missing")

    if failures:
        print("test-leakage:")
        print("\n".join(failures))
        print(f"test-leakage: {len(failures)} case(s) failed", file=sys.stderr)
        return 1
    print("test-leakage: all cases pass")
    return 0


if __name__ == "__main__":
    sys.exit(main())
