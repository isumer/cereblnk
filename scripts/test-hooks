#!/usr/bin/env python3
"""test-hooks — repeatable acceptance run for the four testable guards.

Drives delegation-guard, secret-guard, edit-boundary, and run-guard
with synthetic hook input in a throwaway project (CLAUDE_PROJECT_DIR),
asserting BOTH the exit code and, for blocks, a stderr/stdout
substring. Covers success, block, bypass, and stale-state paths.
Requires bash + python3 on PATH (the hooks' own runtime contract).

Usage: scripts/test-hooks        Exit: 0 all pass · 1 any failure
"""
import json, os, pathlib, shutil, subprocess, sys, tempfile, time

ROOT = pathlib.Path(__file__).resolve().parent.parent
H = ROOT / "plugins/cereblnk/hooks/scripts"

# The budget variables decide what context-monitor reports. Inheriting
# them made four cases pass or fail according to the shell that started
# the suite: `plugins/cereblnk/README.md` tells an operator to export
# them, so a contributor who follows the setup instructions could not
# run the suite that guards the code they were contributing to, and CI
# never saw it because Actions sets neither (F-30).
#
# A test constructs the environment it tests. These are stripped here and
# handed back explicitly by the cases that care which path they exercise.
BUDGET_VARS = ("CLAUDE_CODE_AUTO_COMPACT_WINDOW",
               "CLAUDE_CODE_MAX_OUTPUT_TOKENS",
               "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE")


def run(script, stdin, proj, extra_env=None):
    env = dict(os.environ, CLAUDE_PROJECT_DIR=str(proj))
    for var in BUDGET_VARS:
        env.pop(var, None)
    if extra_env:
        env.update(extra_env)
    return subprocess.run(["bash", str(H / script)], input=stdin,
                          capture_output=True, text=True, env=env, cwd=str(proj))

def main():
    if shutil.which("bash") is None:
        print("test-hooks: bash not on PATH — skipping (hooks require bash)"); return 0
    fails, ran = [], 0
    with tempfile.TemporaryDirectory() as td:
        proj = pathlib.Path(td) / "proj"
        flags = proj / ".claude/cereblnk/flags"; flags.mkdir(parents=True)
        runctx = proj / ".claude/cereblnk/context/R-T"; runctx.mkdir(parents=True)
        (runctx / "plan.md").write_text("task_id: T-1\ntask_id: T-2\n")
        conductor = json.dumps({"tool_input": {"file_path": "a.md", "content": "x"}})
        bypass_try = json.dumps({"tool_input": {"file_path": "a.md",
                                 "content": 'docs mention "agent_id" and "agent_type"'}})
        subagent = json.dumps({"agent_id": "abc", "tool_input": {"file_path": "a.md"}})

        def case(name, script, stdin, want_rc, want_sub=""):
            nonlocal ran; ran += 1
            r = run(script, stdin, proj)
            if r.returncode != want_rc:
                fails.append(f"{name}: rc={r.returncode}, want {want_rc} ({(r.stderr or r.stdout).strip()[:80]})")
            elif want_sub and want_sub not in (r.stderr + r.stdout):
                fails.append(f"{name}: missing expected message {want_sub!r}")

        # DelegationGuard
        case("delegation: no run -> allow", "delegation-guard.sh", conductor, 0)
        (flags / "run-active").touch()
        case("delegation: armed conductor -> block", "delegation-guard.sh", conductor, 2, "surface specialist")
        case("delegation: content-bypass attempt -> block", "delegation-guard.sh", bypass_try, 2, "surface specialist")
        case("delegation: subagent -> allow", "delegation-guard.sh", subagent, 0)

        # CB-106: the conductor owns its own control surface. Blocking it
        # from writing the plan told it to delegate the plan — a category
        # error the block message contradicted in its own sentence
        # ("the conductor holds plan, digests, and verdicts only").
        def edit(path):
            return json.dumps({"tool_name": "Edit", "tool_input": {"file_path": path}})

        cbd = proj / ".claude/cereblnk"
        owned = [
            ("plan.md", str(cbd / "context/implement-2026-08-03/plan.md")),
            ("plan.md on Windows",
             r"C:\Users\me\.claude\cereblnk\context\implement-2026-08-03\plan.md"),
            ("state.md", str(cbd / "state.md")),
            ("run flag", str(cbd / "flags/run-active")),
            ("telemetry", str(cbd / "telemetry/context.log")),
            # agent-selection-policy §3: the orchestrator copies the
            # selector's block here. Absent from the table, this write
            # was blocked mid-run and told to delegate the routing
            # decision the conductor had just made.
            ("skills-required.yaml",
             str(cbd / "context/implement-2026-08-03/skills-required.yaml")),
            # F-06: the block message says the conductor holds verdicts;
            # the table had no path for one. A run journal is a verdict
            # and no surface specialist owns it.
            ("run journal",
             str(cbd / "context/implement-2026-08-03/FINDINGS.md")),
        ]
        for label, path in owned:
            case(f"delegation: conductor owns {label} -> allow",
                 "delegation-guard.sh", edit(path), 0)

        # The exemption must not become a hole. A Response Block is a
        # subagent's output; a conductor writing one fabricates it.
        # CB-122: the flags exemption granted the conductor the one flag
        # it does not own. Blocked from a Response Block, a run wrote
        # conductor-override instead and the guard allowed it; nothing
        # but ScratchGuard — which nudges twice, then allows — stood in
        # the way. The hatch costs a human act or it is not a hatch.
        for label, path in (
            ("task ledger block", str(cbd / "context/implement-2026-08-03/T-3.yaml")),
            # still blocked: memory/specs is the technical writer's
            # surface, and the routing table says so
            ("authored spec", str(cbd / "memory/specs/design.md")),
            ("real source", str(proj / "src/Main.java")),
            ("self-armed override", str(cbd / "flags/conductor-override")),
            ("self-armed override on Windows",
             r"C:\Users\me\.claude\cereblnk\flags\conductor-override"),
        ):
            case(f"delegation: {label} still blocked",
                 "delegation-guard.sh", edit(path), 2, "surface specialist")
        case("delegation: unparseable while armed -> block", "delegation-guard.sh", "not-json", 2)

        # CB-123: the shell reaches the same files. The boundary has to
        # hold under a redirection without stopping the scripts
        # run-discipline requires the conductor to run.
        def bash(cmd, **extra):
            return json.dumps(dict({"tool_name": "Bash",
                                    "tool_input": {"command": cmd}}, **extra))

        for label, cmd in (
            ("git read", "git diff --name-only main..."),
            ("selector", "scripts/select-agents --text 'add idempotency'"),
            ("wrapped build", "scripts/run-quiet T-1 npm test"),
            ("stderr merge", "npm test 2>&1 | head -20"),
            ("redirect to sink", "ls -la > /dev/null"),
            ("quoted angle bracket", "grep -r 'a > b' src/"),
            ("arithmetic in python", 'python3 -c "print(1)"'),
            ("mkdir", "mkdir -p .claude/cereblnk/flags"),
            ("boundary flag via literal path",
             'echo "src/" > .claude/cereblnk/flags/boundary'),
            ("boundary flag via $CB_DIR", 'echo "src/" > $CB_DIR/flags/boundary'),
        ):
            case(f"delegation: shell {label} -> allow", "delegation-guard.sh",
                 bash(cmd), 0)

        for label, cmd in (
            ("heredoc into a Response Block",
             "cat > .claude/cereblnk/context/R-1/T-001-planner.yaml <<'EOF'\nx: 1\nEOF"),
            ("in-place edit of source", "sed -i 's/a/b/' src/Main.java"),
            ("copy over source", "cp /tmp/staged src/Main.java"),
            ("tee into the tree", "npm run build | tee build.log"),
            ("self-armed override through the shell",
             "echo 1 > $CB_DIR/flags/conductor-override"),
            ("nested shell redirect", 'bash -c "echo x > src/a.txt"'),
            ("inline interpreter write", "python3 -c \"open('src/a','w')\""),
            ("opaque writer via git", "git apply /tmp/patch.diff"),
            ("opaque writer via patch", "patch -p1 < /tmp/d.diff"),
            # an owned target does not launder an unresolved one
            ("owned write chained to an opaque one",
             'echo "src/" > $CB_DIR/flags/boundary && git apply /tmp/p.diff'),
        ):
            case(f"delegation: shell {label} -> block", "delegation-guard.sh",
                 bash(cmd), 2, "the same edit under another tool")

        case("delegation: shell subagent -> allow", "delegation-guard.sh",
             bash("sed -i 's/a/b/' src/Main.java", agent_id="abc"), 0)

        # CB-099: staleness bounds. An aged flag whose run ledger is also
        # cold is a dead run, and must not brick editing forever.
        stale = time.time() - 9 * 3600
        os.utime(flags / "run-active", (stale, stale))
        case("delegation: aged flag but live ledger -> block",
             "delegation-guard.sh", conductor, 2, "surface specialist")
        for q in (runctx / "plan.md", runctx, runctx.parent):
            os.utime(q, (stale, stale))
        case("delegation: aged flag, cold ledger -> allow (never bricks)",
             "delegation-guard.sh", conductor, 0)
        now = time.time()
        for q in (runctx / "plan.md", runctx, runctx.parent):
            os.utime(q, (now, now))
        # CB-099: the block names its own handoff, and never a bypass
        r = run("delegation-guard.sh",
                json.dumps({"tool_input": {"file_path": "svc/Payment.java"}}), proj)
        ran += 1
        msg = r.stderr + r.stdout
        # CB-132: the handoff must name what the spawn API accepts. The
        # bare form was followed literally and rejected four times.
        if "NEXT ACTION: spawn cereblnk:engineering:backend-agent" not in msg:
            fails.append("delegation: block does not name a spawnable specialist")
        ran += 1
        if "Remove" in msg or "run-active" in msg.split("NEXT ACTION")[0]:
            fails.append("delegation: block still advertises its own bypass")

        # disarm-and-continue: deleting the flag mid-run does not free the
        # conductor, because a run does not end by disarming its guard
        (flags / "run-active").unlink()
        case("delegation: flag deleted while ledger live -> still block",
             "delegation-guard.sh", conductor, 2, "was removed while the run ledger")
        (flags / "conductor-override").touch()
        case("delegation: explicit human override -> allow",
             "delegation-guard.sh", conductor, 0)
        (flags / "conductor-override").unlink()
        (flags / "run-active.witness").unlink()
        (flags / "run-active").touch()

        # the nudged variant arms the guard too, and ages the same way
        (flags / "run-active").rename(flags / "run-active.nudged")
        case("delegation: nudged flag with live ledger -> block",
             "delegation-guard.sh", conductor, 2, "surface specialist")
        (flags / "run-active.nudged").unlink()

        # Follow-up window (CB-087): run-completed keeps the guard armed
        (flags / "run-completed").touch()
        case("delegation: follow-up window -> block", "delegation-guard.sh", conductor, 2, "re-enter routing")
        case("delegation: subagent in window -> allow", "delegation-guard.sh", subagent, 0)
        # TTL-bounded: an aged flag is ignored (fail-open, never bricks)
        old = time.time() - 9 * 3600
        os.utime(flags / "run-completed", (old, old))
        case("delegation: stale completed flag -> allow", "delegation-guard.sh", conductor, 0)
        (flags / "run-completed").unlink()

        # SecretGuard (always on)
        secret = json.dumps({"tool_input": {"notebook_path": "n.ipynb",
                             "new_source": 'pat = "github_pat_11ABCDEFGH0123456789abcdefghij"'}})
        case("secret: PAT in notebook cell -> block", "secret-guard.sh", secret, 2, "likely secret")
        case("secret: clean content -> allow", "secret-guard.sh",
             json.dumps({"tool_input": {"content": "const x = 1;"}}), 0)

        # EditBoundary
        (flags / "boundary").write_text("src\n")
        (proj / "src").mkdir()
        inside = json.dumps({"tool_input": {"file_path": str(proj / "src/a.js")}})
        outside = json.dumps({"tool_input": {"notebook_path": str(proj / "other/b.ipynb")}})
        case("boundary: inside -> allow", "edit-boundary.sh", inside, 0)
        case("boundary: notebook outside -> block", "edit-boundary.sh", outside, 2, "outside the declared")
        (flags / "boundary").unlink()

        # RunGuard v2 (progress-aware, bounded)
        (flags / "run-active").touch()   # re-arm: CB-087 block above disarmed it
        (runctx / "T-1.yaml").touch()
        case("run-guard: nudge 1 with progress", "run-guard.sh", "{}", 0, '"decision":"block"')
        (runctx / "T-2.yaml").touch()
        case("run-guard: nudge 2 after growth", "run-guard.sh", "{}", 0, "nudge 2/3")
        r = run("run-guard.sh", "{}", proj); ran += 1   # no growth -> disarm, no block json
        if '"decision":"block"' in r.stdout or (flags / "run-active").exists():
            fails.append("run-guard: stagnation should disarm and allow the stop")
        case("run-guard: stop_hook_active bypass", "run-guard.sh",
             json.dumps({"stop_hook_active": True}), 0)

        # CB-144 (F-14): the message used to name one case — waiting on the
        # user — and prescribe disarming for it. Measured against a real run
        # it fired at a conductor waiting on two live specialists, where
        # disarming removes the floors that judge them when they return. No
        # host signal reports a live subagent, so the message must stop
        # assuming which case it is in.
        (flags / "run-active").touch()
        (runctx / "T-3.yaml").touch()
        r = run("run-guard.sh", "{}", proj); ran += 1
        msg = r.stdout
        for phrase, why in (
                ("SPECIALISTS STILL OUT", "the waiting case is not named"),
                ("WAITING ON THE USER", "the user case is not named"),
                ("NEITHER", "the stalled case is not named")):
            if phrase not in msg:
                fails.append(f"run-guard: {why} — CB-144 requires the nudge to "
                             f"distinguish waiting from stalling")
        # The disarm advice must be attached to the user case, never offered
        # unconditionally: a run whose specialists are still out must not be
        # told to remove the flag.
        head = msg.split("WAITING ON THE USER")[0]
        if "disarm" in head.lower() and "do NOT disarm" not in head:
            fails.append("run-guard: disarm is advised before the case that "
                         "justifies it — CB-144 forbids recommending it while "
                         "enforcement is still needed")
        for f in ("run-active", "run-active.nudged"):
            (flags / f).unlink(missing_ok=True)
        (runctx / "run-guard.state").unlink(missing_ok=True)

        # DigestCapHook (CB-094). The cap is a contract; these assert the
        # paths that matter: a return that fits, one that does not, the
        # nudge ceiling, identity resolution to the subagent's own
        # transcript rather than the conducting session's, and every
        # fail-open route. A guard that blocks when it cannot measure is
        # worse than one that does not run, so the fail-open cases are
        # not filler.
        def transcript(text, path=None):
            t = pathlib.Path(path) if path else proj / "t.jsonl"
            t.write_text(json.dumps({"message": {"role": "assistant",
                                                 "content": [{"type": "text", "text": text}]}}) + "\n")
            return str(t)

        def digest_input(text, agent="backend-agent", agent_id=None,
                         missing_sub=False, path=None,
                         main_text="conducting session text, never measured"):
            aid = agent_id or f"id-{agent}"
            if path == "":
                return json.dumps({"agent_type": agent, "agent_id": aid,
                                   "transcript_path": ""})
            main_tp = path if path is not None else transcript(main_text)
            sub_dir = pathlib.Path(main_tp).parent / "subagents"
            sub_dir.mkdir(exist_ok=True)
            if not missing_sub:
                (sub_dir / f"agent-{aid}.jsonl").write_text(
                    json.dumps({"message": {"role": "assistant",
                                            "content": [{"type": "text", "text": text}]}}) + "\n")
            return json.dumps({"agent_type": agent, "agent_id": aid,
                               "transcript_path": main_tp})

        short = "\n".join(f"line {i}" for i in range(1, 9))
        long_ = "\n".join(f"line {i}" for i in range(1, 26))

        case("digest-cap: within cap -> allow", "digest-cap.sh", digest_input(short), 0)
        case("digest-cap: over cap -> block", "digest-cap.sh", digest_input(long_), 2,
             "the cap is 10")
        # The defect this hook exists to fix: transcript_path names the
        # CONDUCTING session, not this subagent. A conductor fixture
        # carrying the long, over-cap text must not sway the decision —
        # only the sibling subagent transcript may.
        case("digest-cap: measures the subagent, not the conducting session",
             "digest-cap.sh",
             digest_input(short, agent="frontend-agent", main_text=long_), 0)
        # F-25: the target path was `{run}<task_id>.yaml` — a literal
        # placeholder with no separator before it, resolving outside any
        # run directory. Two specialists received it and both declined
        # to follow it, which is the right call made for the wrong
        # reason: the protocol should not need overriding.

        # F-25 rides on this case rather than adding a call: the nudge
        # counter is stateful, and a fourth invocation exhausts it
        # before the "nudge 2 still blocks" case runs.
        case("digest-cap: block names an actionable path", "digest-cap.sh",
             digest_input(long_, agent="qa-agent"), 2, "/<its task_id>.yaml")
        case("digest-cap: blank lines do not count", "digest-cap.sh",
             digest_input("\n\n".join(f"line {i}" for i in range(1, 10))), 0)
        case("digest-cap: stop_hook_active -> allow", "digest-cap.sh",
             json.dumps({"agent_type": "backend-agent", "stop_hook_active": True}), 0)
        case("digest-cap: subagent transcript unresolved -> fail open, silent",
             "digest-cap.sh",
             digest_input(long_, agent="docs-agent", missing_sub=True), 0)
        case("digest-cap: empty transcript_path -> fail open", "digest-cap.sh",
             digest_input(long_, agent="docs-agent2", path=""), 0)
        case("digest-cap: unparseable input -> fail open", "digest-cap.sh", "not-json", 0)
        case("digest-cap: no agent in input -> fail open", "digest-cap.sh",
             json.dumps({"transcript_path": transcript(long_)}), 0)

        # Nudge ceiling: backend-agent was blocked once above. A second
        # block is allowed, the third must let the stop through — an agent
        # that will not shorten is a question for the user, not a loop.
        case("digest-cap: nudge 2 still blocks", "digest-cap.sh", digest_input(long_), 2)
        case("digest-cap: nudge ceiling reached -> allow", "digest-cap.sh",
             digest_input(long_), 0)

        # ContextMonitorHook (CB-102). The hook turns an assumed number
        # into a measured one, so the cases that matter are the arithmetic
        # and the silence: never block, never speak below the checkpoint,
        # and count cached tokens as occupancy.
        def check(name, ok, detail=""):
            nonlocal ran; ran += 1
            if not ok:
                fails.append(f"{name}: {detail}")

        def usage_transcript(**usage):
            t = proj / "u.jsonl"
            t.write_text(json.dumps({"message": {"role": "assistant",
                                                 "content": [{"type": "text", "text": "ok"}],
                                                 "usage": usage}}) + "\n")
            return str(t)

        def mon(path, session="S-1", extra_env=None):
            return run("context-monitor.sh",
                       json.dumps({"session_id": session,
                                   "hook_event_name": "UserPromptSubmit",
                                   "transcript_path": path}), proj,
                       extra_env=extra_env)

        # capacity 168000, checkpoint 117600 per scripts/context-budget
        r = mon(usage_transcript(input_tokens=5000))
        check("context-monitor: below checkpoint is silent",
              r.returncode == 0 and r.stdout.strip() == "",
              f"rc={r.returncode} out={r.stdout[:60]!r}")

        tel = proj / ".claude/cereblnk/telemetry/context.log"
        check("context-monitor: samples every turn", tel.is_file(),
              "no telemetry line written below the checkpoint")
        if tel.is_file():
            body = tel.read_text()
            check("context-monitor: sample carries the numbers",
                  "occupancy=5000" in body and "capacity=168000" in body, body[:120])

        # Cache-warm turn: counting only input_tokens would read this as
        # nearly empty, which is the opposite of true.
        r = mon(usage_transcript(input_tokens=1200, cache_read_input_tokens=130000))
        check("context-monitor: cached tokens count as occupancy",
              r.returncode == 0 and "131200" in r.stdout, r.stdout[:120])
        check("context-monitor: warns via additionalContext, never blocks",
              r.returncode == 0 and "additionalContext" in r.stdout,
              f"rc={r.returncode} out={r.stdout[:80]!r}")
        # F-13: context-budget calls this window `source: assumed`; the
        # warning printed the derived percentage as fact. A session
        # reshaped its work around 101.8% of a denominator that was
        # never measured.
        check("context-monitor: an assumed window says so",
              "ASSUMED" in r.stdout and "guess" in r.stdout, r.stdout[:160])
        # The other half of F-13: once the window IS measured, the hedge
        # must go. A warning that cries `ASSUMED` at a figure the operator
        # supplied teaches the reader to ignore the word — which is how the
        # unmeasured case stops being heard.
        r_measured = mon(usage_transcript(input_tokens=1200,
                                          cache_read_input_tokens=130000),
                         session="S-2",
        # Window chosen so the same 131200-token turn sits ABOVE the
        # checkpoint: 180000 - 32000 = 148000 capacity, 70% = 103600.
        # A warning that never fires cannot be inspected for its hedge.
                         extra_env={"CLAUDE_CODE_AUTO_COMPACT_WINDOW": "180000",
                                    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "32000"})
        check("context-monitor: a measured window drops the hedge",
              "ASSUMED" not in r_measured.stdout and "148000" in r_measured.stdout,
              r_measured.stdout[:160])

        for label, arg in (("no usage field", usage_transcript()),
                           ("missing transcript", ""),
                           ("unparseable input", None)):
            r = (run("context-monitor.sh", "not-json", proj) if arg is None else mon(arg))
            check(f"context-monitor: {label} -> silent",
                  r.returncode == 0 and r.stdout.strip() == "",
                  f"rc={r.returncode} out={r.stdout[:60]!r}")

        # HistoryArchiveHook (CB-105). Runtime state belongs under CB_DIR
        # with everything else; this wrote beside it for one release. The
        # migration case matters more than the happy path — a user with
        # archives must not silently lose track of them.
        def archive(project, tpath):
            return run("history-archive.sh",
                       json.dumps({"transcript_path": tpath, "trigger": "auto",
                                   "session_id": "abcdef123456"}), project)

        hp = proj / "hist-src.jsonl"
        hp.write_text('{"message":{"role":"assistant"}}\n')
        archive(proj, str(hp))
        hist = proj / ".claude/cereblnk/history"
        check("history-archive: writes under CB_DIR",
              hist.is_dir() and len(list(hist.glob("*.jsonl"))) == 1,
              f"exists={hist.is_dir()}")
        check("history-archive: does not create the legacy directory",
              not (proj / ".claude/history").is_dir(), "legacy path recreated")

        with tempfile.TemporaryDirectory() as ltd:
            lp = pathlib.Path(ltd) / "p"
            legacy = lp / ".claude/history"
            legacy.mkdir(parents=True)
            (legacy / "20260101-auto-old.jsonl").write_text("older archive\n")
            src = lp / "s.jsonl"
            src.write_text('{"message":{"role":"assistant"}}\n')
            r = archive(lp, str(src))
            moved = sorted(x.name for x in (lp / ".claude/cereblnk/history").glob("*.jsonl"))
            check("history-archive: migrates existing archives once",
                  len(moved) == 2 and "20260101-auto-old.jsonl" in moved, str(moved))
            check("history-archive: legacy directory is gone after the move",
                  not legacy.is_dir(), "legacy directory survived")
            check("history-archive: the move is announced",
                  "moved existing archives" in r.stderr, r.stderr[:100])

        check("history-archive: missing transcript never blocks compaction",
              archive(proj, "").returncode == 0, "non-zero exit on a missing transcript")

        # ScratchGuardHook (CB-107). A run left debug.txt, debug2.txt and
        # medium.txt at the repository root. The signal is shape, not
        # name — a pattern list would have caught two of the three.
        def write_to(path, project=None):
            return run("scratch-guard.sh",
                       json.dumps({"tool_name": "Write",
                                   "tool_input": {"file_path": path}}),
                       project or proj)

        (proj / "src").mkdir(exist_ok=True)
        (proj / "README.md").write_text("# fixture\n")
        subprocess.run(["git", "init", "-q"], cwd=str(proj), capture_output=True)
        subprocess.run(["git", "add", "README.md"], cwd=str(proj), capture_output=True)

        check("scratch-guard: no active run -> allow",
              write_to(str(proj / "debug.txt")).returncode == 0, "blocked outside a run")

        (flags / "run-active").touch()
        check("scratch-guard: new root file blocked",
              write_to(str(proj / "debug.txt")).returncode == 2, "root scratch allowed")
        r = write_to("medium.txt")
        check("scratch-guard: a bare name is still root-level",
              r.returncode == 2, "relative path escaped the check")
        check("scratch-guard: names where notes belong",
              "scratch" in r.stderr, r.stderr[:90])
        check("scratch-guard: a subdirectory is real work",
              write_to(str(proj / "src/Main.java")).returncode == 0, "blocked src/")
        check("scratch-guard: a tracked root file is the project deciding",
              write_to(str(proj / "README.md")).returncode == 0, "blocked a tracked file")
        check("scratch-guard: CB_DIR is not the repository root",
              write_to(str(proj / ".claude/cereblnk/state.md")).returncode == 0,
              "blocked runtime state")
        check("scratch-guard: nudge ceiling releases",
              write_to(str(proj / "debug9.txt")).returncode == 0, "guard never yields")

        # DestructiveCommandHook (F-18, F-19). The hook had no suite at
        # all, which is how a pattern matching DATA inside the command
        # string survived: a heredoc that only DOCUMENTED destructive
        # commands was blocked, and with it every findings file, fixture
        # and log a security project writes. The two anchors of this
        # section are the false positive and the true positive — remove
        # the stripper and the first block fails; loosen it into a
        # bypass and the second block fails.
        careful = flags / "careful"

        def dc(cmd):
            return run("destructive-command.sh", bash(cmd), proj)

        check("destructive: flag absent -> allow",
              dc("rm -rf /tmp/anything").returncode == 0,
              "blocked while /cb-careful was off")

        careful.touch()

        heredoc = (
            "cat >> docs/findings.md <<'EOF'\n"
            "F-18: the hook blocked `rm -rf build`, `git push --force`\n"
            "and `DROP TABLE users` when they appeared as prose.\n"
            "EOF"
        )
        check("destructive: heredoc that only MENTIONS destructive commands -> allow",
              dc(heredoc).returncode == 0,
              "documentation about destructive commands is still blocked (F-18)")
        for label, cmd in (
            ("quoted commit message", 'git commit -m "explain why rm -rf is blocked"'),
            ("echoed prose", 'echo "never run git reset --hard here" > NOTES'),
            ("python string literal", "printf '%s' 'drop table t' > fixture.sql"),
        ):
            check(f"destructive: {label} -> allow",
                  dc(cmd).returncode == 0, f"data matched as a command (F-18): {cmd}")

        for label, cmd in (
            ("bare recursive delete", "rm -rf /var/data"),
            ("recursive delete of a quoted path", 'rm -rf "$HOME/data"'),
            ("force push", "git push origin main --force"),
            ("hard reset", "git reset --hard HEAD~3"),
            ("SQL through a client -c argument", 'psql -d app -c "DROP TABLE users"'),
            ("code through sh -c", "sh -c 'rm -rf /var/data'"),
            ("script body in an interpreted heredoc",
             "bash <<'EOF'\nrm -rf /var/data\nEOF"),
            # found while writing this suite: looking only at the text
            # LEFT of `<<` reads this as a harmless `cat`
            ("heredoc body piped into a shell",
             "cat <<EOF | bash\nrm -rf /var/data\nEOF"),
            ("eval of a quoted command", 'eval "rm -rf /var/data"'),
            ("xargs delete", "xargs rm -rf < list.txt"),
            ("remote delete over ssh", 'ssh host "rm -rf /var/data"'),
            ("find -exec delete", "find . -name x -exec rm -rf {} \\;"),
            ("SQL through a client -e argument", 'mysql -e "TRUNCATE TABLE users"'),
            ("delete chained after the disarm",
             "rm -f .claude/cereblnk/flags/careful && rm -rf /var/data"),
        ):
            r = dc(cmd)
            check(f"destructive: {label} -> block",
                  r.returncode == 2, f"NOT blocked (bypass): {cmd}")

        # F-19: the escape the block message prescribes must not be
        # blocked by the same hook. Both halves are asserted: the
        # message names the working route, and the route works.
        r = dc("rm -rf /var/data")
        msg = r.stderr + r.stdout
        check("destructive: block names /cb-careful off",
              "/cb-careful off" in msg, msg[:120])
        check("destructive: block names the disarm mechanism",
              "flag careful disarm" in msg, msg[:120])
        for label, cmd in (
            ("forced delete of the careful flag",
             "rm -f .claude/cereblnk/flags/careful"),
            ("recursive delete of the careful flag",
             'rm -rf "$CB_DIR/flags/careful"'),
            ("the run-flag mechanism itself",
             "plugins/cereblnk/scripts/run-flag flag careful disarm"),
        ):
            check(f"destructive: {label} -> allow (F-19)",
                  dc(cmd).returncode == 0, f"the documented escape is blocked: {cmd}")
        careful.unlink()

        # F-17: /cb-careful's direction is decided by run-flag, by exact
        # match, not by the model reading a sentence.
        rf = ROOT / "plugins/cereblnk/scripts/run-flag"

        def flag(arg):
            return subprocess.run(["bash", str(rf), "flag", "careful", arg,
                                   str(proj / ".claude/cereblnk")],
                                  capture_output=True, text=True)

        check("careful: 'on' arms", flag("on").returncode == 0 and careful.exists(),
              "on did not arm the flag")
        check("careful: 'off' disarms",
              flag("off").returncode == 0 and not careful.exists(),
              "off did not disarm the flag")
        careful.touch()
        r = flag("please turn careful mode on for this repo")
        check("careful: a sentence is refused, not guessed (F-17)",
              r.returncode == 2, f"rc={r.returncode} — the direction was inferred")
        check("careful: a refused direction changes nothing",
              careful.exists(), "the flag state moved on an unparsed argument")
        check("careful: the refusal says what is accepted",
              "on, off, arm, disarm, status" in (r.stderr + r.stdout), r.stderr[:120])
        careful.unlink()

        # ToolFloorHook (F-24). `disallowedTools` closes the tools it
        # names and not the shell, and the shell reaches the same
        # files: architect-agent, denied the edit tools, authored four
        # spec sections through `cat > file <<EOF`. The definition half
        # of that finding is fixed in the frontmatter (checker:
        # check-agent-skills A-7); this is the half that remains, the
        # in-place edit under a tool the denial never named.
        def floor(cmd, agent=None, tool="Bash"):
            payload = {"tool_name": tool, "tool_input": {"command": cmd}}
            if agent:
                payload["agent_type"] = agent
            return run("tool-floor.sh", json.dumps(payload), proj)

        ARCH = "architect-agent"
        r = floor("sed -i s/a/b/ src/F.java", ARCH)
        check("tool-floor: an in-place edit under a denial is blocked",
              r.returncode == 2, f"rc={r.returncode}")
        check("tool-floor: the block names the tool and the file",
              "disallowedTools" in r.stderr and "src/F.java" in r.stderr,
              r.stderr[:120])
        check("tool-floor: the block names the honest route",
              "Response Block" in r.stderr, r.stderr[:120])
        check("tool-floor: the qualified spawn name resolves too",
              floor("patch -p1 < d.diff",
                    "cereblnk:engineering:architect-agent").returncode == 2,
              "qualified identity did not resolve to the definition")
        # A write is not an edit: these agents hold Write, because
        # run-discipline SS1 makes every one of them write a Response
        # Block. Blocking `>` would be stricter than the grant, and a
        # guard that false-blocks is one the model routes around.
        check("tool-floor: a redirection is Write-shaped, not blocked",
              floor("cat > spec.md <<EOF\nx\nEOF", ARCH).returncode == 0,
              "a whole-file write was blocked")
        check("tool-floor: a read-only command is untouched",
              floor("grep -rn foo src/", ARCH).returncode == 0, "blocked a read")
        # Fail-open paths: a floor that cannot read the definition has
        # no grounds to block, only grounds to stay quiet.
        check("tool-floor: an unrestricted agent is untouched",
              floor("sed -i s/a/b/ src/F.java", "backend-agent").returncode == 0,
              "blocked an agent that denies no edit tool")
        check("tool-floor: no identity is the conductor, not this hook",
              floor("sed -i s/a/b/ src/F.java").returncode == 0,
              "took DelegationGuard's case")
        check("tool-floor: an opaque agent id cannot be judged",
              run("tool-floor.sh",
                  json.dumps({"tool_name": "Bash", "agent_id": "a9ca0309334d",
                              "tool_input": {"command": "sed -i s/a/b/ f"}}),
                  proj).returncode == 0,
              "blocked on an id it cannot resolve")
        check("tool-floor: a non-Bash payload is not its event",
              floor("x", ARCH, tool="Write").returncode == 0, "read a Write payload")
        check("tool-floor: unparseable input is silent",
              run("tool-floor.sh", "not-json", proj).returncode == 0,
              "blocked on garbage")

    if fails:
        print("\n".join("FAIL " + x for x in fails), file=sys.stderr)
        print(f"test-hooks: {len(fails)}/{ran} failed", file=sys.stderr); return 1
    print(f"test-hooks: {ran} checks passed (delegation, secret, boundary, run-guard, digest-cap, context-monitor, history-archive, scratch-guard, tool-floor, destructive-command)")
    return 0

if __name__ == "__main__":
    sys.exit(main())
