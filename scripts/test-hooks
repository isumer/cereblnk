#!/usr/bin/env python3
"""test-hooks — repeatable acceptance run for the four testable guards.

Usage: scripts/test-hooks        Exit: 0 all pass · 1 any failure
"""
import json, os, pathlib, shutil, subprocess, sys, tempfile, time

ROOT = pathlib.Path(__file__).resolve().parent.parent
H = ROOT / "plugins/cereblnk/hooks/scripts"

# F-30: inherited budget variables made four cases depend on the caller's shell.
# Strip them here; cases that need them supply them explicitly.
BUDGET_VARS = ("CLAUDE_CODE_AUTO_COMPACT_WINDOW",
               "CLAUDE_CODE_MAX_OUTPUT_TOKENS",
               "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE")


def run(script, stdin, proj, extra_env=None):
    env = dict(os.environ, CLAUDE_PROJECT_DIR=str(proj))
    for var in BUDGET_VARS:
        env.pop(var, None)
    if extra_env:
        env.update(extra_env)
    return subprocess.run(["bash", str(H / script)], input=stdin,
                          capture_output=True, text=True, env=env, cwd=str(proj))

def main():
    if shutil.which("bash") is None:
        print("test-hooks: bash not on PATH — skipping (hooks require bash)"); return 0
    fails, ran = [], 0
    with tempfile.TemporaryDirectory() as td:
        proj = pathlib.Path(td) / "proj"
        flags = proj / ".claude/cereblnk/flags"; flags.mkdir(parents=True)
        runctx = proj / ".claude/cereblnk/context/R-T"; runctx.mkdir(parents=True)
        (runctx / "plan.md").write_text(
            "task_id: metadata-is-not-a-plan-task\n"
            "- [ ] T-1\n- [x] T-2\n- [ ] T-3\n- [x] T-4\n- [ ] T-5\n")
        conductor = json.dumps({"tool_input": {"file_path": "a.md", "content": "x"}})
        bypass_try = json.dumps({"tool_input": {"file_path": "a.md",
                                 "content": 'docs mention "agent_id" and "agent_type"'}})
        subagent = json.dumps({"agent_id": "abc", "tool_input": {"file_path": "a.md"}})

        def case(name, script, stdin, want_rc, want_sub=""):
            nonlocal ran; ran += 1
            r = run(script, stdin, proj)
            if r.returncode != want_rc:
                fails.append(f"{name}: rc={r.returncode}, want {want_rc} ({(r.stderr or r.stdout).strip()[:80]})")
            elif want_sub and want_sub not in (r.stderr + r.stdout):
                fails.append(f"{name}: missing expected message {want_sub!r}")

        # DelegationGuard
        case("delegation: no run -> allow", "delegation-guard.sh", conductor, 0)
        (flags / "run-active").touch()
        case("delegation: armed conductor -> block", "delegation-guard.sh", conductor, 2, "surface specialist")
        case("delegation: content-bypass attempt -> block", "delegation-guard.sh", bypass_try, 2, "surface specialist")
        case("delegation: subagent -> allow", "delegation-guard.sh", subagent, 0)

        # CB-106: blocking conductor-owned plans wrongly told it to delegate them.
        def edit(path):
            return json.dumps({"tool_name": "Edit", "tool_input": {"file_path": path}})

        cbd = proj / ".claude/cereblnk"
        case("delegation: ARMED .claude backlog Write -> allow",
             "delegation-guard.sh", edit(str(proj / ".claude/BACKLOG.md")), 0)
        owned = [
            ("plan.md", str(cbd / "context/implement-2026-08-03/plan.md")),
            ("plan.md on Windows",
             r"C:\Users\me\.claude\cereblnk\context\implement-2026-08-03\plan.md"),
            ("state.md", str(cbd / "state.md")),
            ("run flag", str(cbd / "flags/run-active")),
            ("telemetry", str(cbd / "telemetry/context.log")),
            # Policy §3 requires the conductor to copy the selector block here.
            ("skills-required.yaml",
             str(cbd / "context/implement-2026-08-03/skills-required.yaml")),
            # F-06: run journals are conductor-held verdicts with no surface owner.
            ("run journal",
             str(cbd / "context/implement-2026-08-03/FINDINGS.md")),
        ]
        for label, path in owned:
            case(f"delegation: conductor owns {label} -> allow",
                 "delegation-guard.sh", edit(path), 0)

        # CB-122: a run self-armed conductor-override through the blanket flags exemption.
        # Response Blocks stay specialist-owned and the override stays human-owned.
        for label, path in (
            ("task ledger block", str(cbd / "context/implement-2026-08-03/T-3.yaml")),
            # still blocked: memory/specs is the technical writer's
            # surface, and the routing table says so
            ("authored spec", str(cbd / "memory/specs/design.md")),
            ("real source", str(proj / "src/Main.java")),
            ("self-armed override", str(cbd / "flags/conductor-override")),
            ("self-armed override on Windows",
             r"C:\Users\me\.claude\cereblnk\flags\conductor-override"),
        ):
            case(f"delegation: {label} still blocked",
                 "delegation-guard.sh", edit(path), 2, "surface specialist")
        case("delegation: unparseable while armed -> block", "delegation-guard.sh", "not-json", 2)

        # CB-123: shell redirection shares the edit boundary without blocking required scripts.
        def bash(cmd, **extra):
            return json.dumps(dict({"tool_name": "Bash",
                                    "tool_input": {"command": cmd}}, **extra))

        case("delegation: ARMED .claude backlog Bash -> allow",
             "delegation-guard.sh", bash("printf x > .claude/BACKLOG.md"), 0)

        for label, cmd in (
            ("git read", "git diff --name-only main..."),
            ("selector", "scripts/select-agents --text 'add idempotency'"),
            ("wrapped build", "scripts/run-quiet T-1 npm test"),
            ("stderr merge", "npm test 2>&1 | head -20"),
            ("redirect to sink", "ls -la > /dev/null"),
            ("quoted angle bracket", "grep -r 'a > b' src/"),
            ("arithmetic in python", 'python3 -c "print(1)"'),
            ("mkdir", "mkdir -p .claude/cereblnk/flags"),
            ("boundary flag via literal path",
             'echo "src/" > .claude/cereblnk/flags/boundary'),
            ("boundary flag via $CB_DIR", 'echo "src/" > $CB_DIR/flags/boundary'),
            # [[ ... ]] is bash's own comparison operator, not test(1):
            # > and < are string comparisons there, never redirection.
            ("double-bracket comparison", "[[ a > b ]]"),
        ):
            case(f"delegation: shell {label} -> allow", "delegation-guard.sh",
                 bash(cmd), 0)

        # Known limit: shlex cannot distinguish test(1)'s `>` from redirection.
        case("delegation: shell single-bracket comparison -> block (known residual)",
             "delegation-guard.sh", bash("[ a > b ]"), 2,
             "the same edit under another tool")

        # An unparseable command must not be mislabeled as a confirmed write.
        for label, cmd in (
            ("odd quote inside a substitution",
             """echo "$(echo 'a"b')\""""),
            ("read-only command with the same quoting shape",
             """printf "%s" "$(grep -o '"version": *"[^"]*"' f.json)\""""),
        ):
            r = run("delegation-guard.sh", bash(cmd), proj)
            ran += 1
            msg = r.stderr + r.stdout
            if r.returncode != 2:
                fails.append(f"delegation: shell {label} -> parse-block: "
                             f"rc={r.returncode}, want 2")
            elif "could not be parsed" not in msg or "whether it writes is unknown" not in msg:
                fails.append(f"delegation: shell {label} -> parse-block: "
                             f"missing the parse-failure message ({msg[:120]!r})")
            elif "surface specialist" in msg or "spawn" in msg:
                fails.append(f"delegation: shell {label} -> parse-block: "
                             f"wrongly told to spawn a specialist ({msg[:120]!r})")

        for label, cmd in (
            ("heredoc into a Response Block",
             "cat > .claude/cereblnk/context/R-1/T-001-planner.yaml <<'EOF'\nx: 1\nEOF"),
            ("in-place edit of source", "sed -i 's/a/b/' src/Main.java"),
            ("copy over source", "cp /tmp/staged src/Main.java"),
            ("tee into the tree", "npm run build | tee build.log"),
            ("self-armed override through the shell",
             "echo 1 > $CB_DIR/flags/conductor-override"),
            ("nested shell redirect", 'bash -c "echo x > src/a.txt"'),
            ("inline interpreter write", "python3 -c \"open('src/a','w')\""),
            ("opaque writer via git", "git apply /tmp/patch.diff"),
            ("opaque writer via patch", "patch -p1 < /tmp/d.diff"),
            # an owned target does not launder an unresolved one
            ("owned write chained to an opaque one",
             'echo "src/" > $CB_DIR/flags/boundary && git apply /tmp/p.diff'),
        ):
            case(f"delegation: shell {label} -> block", "delegation-guard.sh",
                 bash(cmd), 2, "the same edit under another tool")

        case("delegation: shell subagent -> allow", "delegation-guard.sh",
             bash("sed -i 's/a/b/' src/Main.java", agent_id="abc"), 0)

        # CB-168 removed inferred dead runs; flag presence now agrees with run-flag.
        stale = time.time() - 9 * 3600
        os.utime(flags / "run-active", (stale, stale))
        case("delegation: aged flag but live ledger -> block",
             "delegation-guard.sh", conductor, 2, "surface specialist")
        for q in (runctx / "plan.md", runctx, runctx.parent):
            os.utime(q, (stale, stale))
        case("delegation: aged flag, cold ledger is still ARMED",
             "delegation-guard.sh", conductor, 2, "surface specialist")
        now = time.time()
        for q in (runctx / "plan.md", runctx, runctx.parent):
            os.utime(q, (now, now))
        # CB-099: the block names its own handoff, and never a bypass
        r = run("delegation-guard.sh",
                json.dumps({"tool_input": {"file_path": "svc/Payment.java"}}), proj)
        ran += 1
        msg = r.stderr + r.stdout
        # CB-132: the handoff must name what the spawn API accepts. The
        # bare form was followed literally and rejected four times.
        if "NEXT ACTION: spawn cereblnk:engineering:backend-agent" not in msg:
            fails.append("delegation: block does not name a spawnable specialist")
        ran += 1
        if "Remove" in msg or "run-active" in msg.split("NEXT ACTION")[0]:
            fails.append("delegation: block still advertises its own bypass")

        # A deleted flag is IDLE, exactly as run-flag status reports. The
        # witness is evidence, not a fourth spelling of active state.
        (flags / "run-active").unlink()
        case("delegation: flag deleted while ledger live -> IDLE allow",
             "delegation-guard.sh", conductor, 0)
        (flags / "run-active").touch()
        (flags / "conductor-override").touch()
        case("delegation: explicit human override -> allow",
             "delegation-guard.sh", conductor, 0)
        (flags / "conductor-override").unlink()
        (flags / "run-active.witness").unlink()
        (flags / "run-active").touch()

        # A nudged marker is not run-active; status and the guard agree.
        (flags / "run-active").rename(flags / "run-active.nudged")
        case("delegation: nudged marker alone -> IDLE allow",
             "delegation-guard.sh", conductor, 0)
        (flags / "run-active.nudged").unlink()

        # CB-168: completion is never ARMED; follow-up routing covers only repository source.
        (flags / "run-completed").touch()
        completed_source = edit(str(proj / "src/Main.java"))
        case("delegation: COMPLETED Write source -> route",
             "delegation-guard.sh", completed_source, 2, "re-enter routing")
        case("delegation: COMPLETED Bash source -> same route",
             "delegation-guard.sh", bash("printf x > src/Main.java"), 2,
             "re-enter routing")
        for label, path in (
            (".claude backlog", str(proj / ".claude/BACKLOG.md")),
            ("run context note", str(runctx / "notes.md")),
            ("outside scratch", str(pathlib.Path(tempfile.gettempdir()) /
                                    "cb-168-notes.md")),
        ):
            case(f"delegation: COMPLETED Write {label} -> allow",
                 "delegation-guard.sh", edit(path), 0)
            case(f"delegation: COMPLETED Bash {label} -> allow",
                 "delegation-guard.sh", bash(f"printf x > {path}"), 0)
        case("delegation: subagent in window -> allow", "delegation-guard.sh", subagent, 0)
        # Sentinel presence, rather than a private hook TTL, is the shared
        # state contract used by run-flag status and both tool paths.
        old = time.time() - 9 * 3600
        os.utime(flags / "run-completed", (old, old))
        case("delegation: aged completed sentinel remains COMPLETED",
             "delegation-guard.sh", conductor, 2, "re-enter routing")
        (flags / "run-completed").unlink()
        case("delegation: IDLE Write source -> allow",
             "delegation-guard.sh", completed_source, 0)
        case("delegation: IDLE Bash source -> allow",
             "delegation-guard.sh", bash("printf x > src/Main.java"), 0)

        # SecretGuard (always on)
        secret = json.dumps({"tool_input": {"notebook_path": "n.ipynb",
                             "new_source": 'pat = "github_pat_11ABCDEFGH0123456789abcdefghij"'}})
        case("secret: PAT in notebook cell -> block", "secret-guard.sh", secret, 2, "likely secret")
        case("secret: AWS key in shell redirection -> block", "secret-guard.sh",
             bash("echo AWS_KEY=AKIAIOSFODNN7EXAMPLE > .env"), 2, "likely secret")
        case("secret: clean shell command -> allow", "secret-guard.sh",
             bash("printf '%s\\n' ready"), 0)
        case("secret: clean content -> allow", "secret-guard.sh",
             json.dumps({"tool_input": {"content": "const x = 1;"}}), 0)
        manifest = json.loads((ROOT / "plugins/cereblnk/hooks/hooks.json").read_text())
        bash_hooks = next(h["hooks"] for h in manifest["hooks"]["PreToolUse"]
                          if h.get("matcher") == "Bash")
        ran += 1
        if not any("secret-guard.sh" in h.get("command", "") for h in bash_hooks):
            fails.append("secret: Bash matcher does not register secret-guard")

        # EditBoundary
        (flags / "boundary").write_text("src\n")
        (proj / "src").mkdir()
        inside = json.dumps({"tool_input": {"file_path": str(proj / "src/a.js")}})
        outside = json.dumps({"tool_input": {"notebook_path": str(proj / "other/b.ipynb")}})
        case("boundary: inside -> allow", "edit-boundary.sh", inside, 0)
        case("boundary: notebook outside -> block", "edit-boundary.sh", outside, 2, "outside the declared")
        (flags / "boundary").unlink()

        # RunGuard counts stagnant Stops, not ledger growth or unrelated YAML.
        (flags / "run-active").touch()   # re-arm: CB-087 block above disarmed it
        (runctx / "request.yaml").write_text("kind: task\n")
        (runctx / "agents-required.yaml").write_text(
            "agents_required:\n"
            "  - agent: cereblnk:engineering:backend-agent\n"
            "    domain: \"server-side implementation\"\n"
            "  - agent: cereblnk:quality:qa-agent\n"
            "    domain: \"behavioral verification\"\n")
        (runctx / "T-1.yaml").write_text("kind: response\nrole: BackendAgent\n")
        r = run("run-guard.sh", "{}", proj); ran += 1
        if ('"decision":"block"' not in r.stdout or "nudge 1/3" not in r.stdout
                or "1/5 plan tasks have a response block" not in r.stdout
                or "mandated agents with no response or verification block: qa-agent" not in r.stdout):
            fails.append("run-guard: first nudge does not report one real "
                         "Response Block against five checklist tasks or the "
                         "mandated specialist still absent from the ledger")

        # More than MAX_NUDGES Stops are legitimate when each one observes a
        # new Response Block. They must all retain the same counter value.
        for task in range(2, 6):
            role = "QAAgent" if task == 2 else "BackendAgent"
            (runctx / f"T-{task}.yaml").write_text(
                f"kind: response\nrole: {role}\n")
            r = run("run-guard.sh", "{}", proj); ran += 1
            if (f"{task}/5 plan tasks have a response block" not in r.stdout
                    or "nudge 1/3" not in r.stdout
                    or "mandated agents with no response or verification block" in r.stdout):
                fails.append("run-guard: ledger growth advanced the stagnant-Stop "
                             f"counter, miscounted artifacts, or missed a responder at T-{task}")

        (runctx / "agents-required.yaml").write_text(
            (runctx / "agents-required.yaml").read_text()
            + "  - agent: cereblnk:core:verifier-agent\n"
              "    domain: \"independent verification\"\n")
        (runctx / "GATE-V.yaml").write_text(
            "kind: verification\n"
            "role: cereblnk:core:verifier-agent\n"
            "gate_verdict: pass-with-risk\n")
        r = run("run-guard.sh", "{}", proj); ran += 1
        if ("5/5 plan tasks have a response block" not in r.stdout
                or "nudge 1/3" not in r.stdout
                or "verifier-agent" in r.stdout):
            fails.append("run-guard: a mandated gate Verification Block was "
                         "not credited, did not count as ledger progress, or "
                         "inflated the Response Block task count")

        case("run-guard: first stagnant Stop advances to nudge 2",
             "run-guard.sh", "{}", 0, "nudge 2/3")
        case("run-guard: second stagnant Stop advances to nudge 3",
             "run-guard.sh", "{}", 0, "nudge 3/3")
        r = run("run-guard.sh", "{}", proj); ran += 1
        if '"decision":"block"' in r.stdout or (flags / "run-active").exists():
            fails.append("run-guard: repeated stagnation should hit the cap, "
                         "disarm, and allow the stop")

        # Without plan.md the message reports only the real Response Block
        # count; it must never manufacture the old N/0 denominator.
        (runctx / "plan.md").unlink()
        (runctx / "agents-required.yaml").write_text(
            (runctx / "agents-required.yaml").read_text()
            + "  - agent: cereblnk:security:security-agent\n"
              "    domain: \"security review\"\n")
        (flags / "run-active").touch()
        r = run("run-guard.sh", "{}", proj); ran += 1
        if ("5 response blocks in context/R-T/" not in r.stdout
                or "/0" in r.stdout
                or "mandated agents with no response or verification block: security-agent" not in r.stdout):
            fails.append("run-guard: absent plan.md should report only the "
                         "Response Block count and missing mandated responders")
        case("run-guard: stop_hook_active bypass", "run-guard.sh",
             json.dumps({"stop_hook_active": True}), 0)

        # CB-144/F-14: disarm advice fired while two specialists were live, removing their return floors.
        # The host exposes no live-subagent signal, so the message cannot infer that case.
        for f in ("run-active", "run-active.nudged", "run-active.state"):
            (flags / f).unlink(missing_ok=True)
        (runctx / "run-guard.last-progress").unlink(missing_ok=True)
        (flags / "run-active").touch()
        (runctx / "T-6.yaml").touch()
        r = run("run-guard.sh", "{}", proj); ran += 1
        msg = r.stdout
        for phrase, why in (
                ("SPECIALISTS STILL OUT", "the waiting case is not named"),
                ("WAITING ON THE USER", "the user case is not named"),
                ("NEITHER", "the stalled case is not named")):
            if phrase not in msg:
                fails.append(f"run-guard: {why} — CB-144 requires the nudge to "
                             f"distinguish waiting from stalling")
        # Offer disarm only for the explicit user-wait case, never unconditionally.
        head = msg.split("WAITING ON THE USER")[0]
        if "disarm" in head.lower() and "do NOT disarm" not in head:
            fails.append("run-guard: disarm is advised before the case that "
                         "justifies it — CB-144 forbids recommending it while "
                         "enforcement is still needed")
        for f in ("run-active", "run-active.nudged"):
            (flags / f).unlink(missing_ok=True)
        (flags / "run-active.state").unlink(missing_ok=True)
        (runctx / "run-guard.last-progress").unlink(missing_ok=True)

        # CB-094: DigestCap resolves the subagent transcript and fails open when unmeasurable.
        hook_manifest = json.loads(
            (ROOT / "plugins/cereblnk/hooks/hooks.json").read_text())
        stop_commands = [h["command"] for h in
                         hook_manifest["hooks"]["SubagentStop"][0]["hooks"]]
        ran += 1
        try:
            digest_pos = next(i for i, cmd in enumerate(stop_commands)
                              if "digest-cap.sh" in cmd)
            ground_pos = next(i for i, cmd in enumerate(stop_commands)
                              if "ground-floor.sh" in cmd)
            if digest_pos >= ground_pos:
                fails.append("digest-cap: persistence runs after ground-floor, "
                             "so recovered blocks miss same-stop grounding")
        except StopIteration:
            fails.append("digest-cap: SubagentStop manifest is missing the "
                         "digest or grounding hook")

        def transcript(text, path=None):
            t = pathlib.Path(path) if path else proj / "t.jsonl"
            t.write_text(json.dumps({"message": {"role": "assistant",
                                                 "content": [{"type": "text", "text": text}]}}) + "\n")
            return str(t)

        def digest_input(text, agent="backend-agent", agent_id=None,
                         missing_sub=False, path=None,
                         main_text="conducting session text, never measured"):
            aid = agent_id or f"id-{agent}"
            if path == "":
                return json.dumps({"agent_type": agent, "agent_id": aid,
                                   "transcript_path": ""})
            # Real layout: main.jsonl next to a directory named for the
            # session (main.jsonl minus its suffix), holding subagents/.
            main_tp = path if path is not None else transcript(main_text)
            main_path = pathlib.Path(main_tp)
            session_dir = main_path.with_name(main_path.stem)
            sub_dir = session_dir / "subagents"
            sub_dir.mkdir(parents=True, exist_ok=True)
            if not missing_sub:
                (sub_dir / f"agent-{aid}.jsonl").write_text(
                    json.dumps({"message": {"role": "assistant",
                                            "content": [{"type": "text", "text": text}]}}) + "\n")
            return json.dumps({"agent_type": agent, "agent_id": aid,
                               "transcript_path": main_tp})

        short = "\n".join(f"line {i}" for i in range(1, 9))
        long_ = "\n".join(f"line {i}" for i in range(1, 26))

        # CB-181: SubagentStop creates a missing task ledger only from an isolatable ACP block.
        # Agent-authored files always win.
        clean_acp = (
            'acp_version: "1.0"\n'
            "kind: response\n"
            "task_id: T-9\n"
            "role: APIDesignAgent\n"
            "status: completed\n"
            "decision: API review completed\n"
            "confidence: 0.9"
        )
        digests_before = set(runctx.glob("digest.*.txt"))
        r = run("digest-cap.sh", digest_input(clean_acp,
                agent="apidesign-agent"), proj); ran += 1
        persisted = runctx / "T-9.yaml"
        if (r.returncode != 0 or not persisted.is_file()
                or persisted.read_text() != clean_acp + "\n"):
            fails.append("digest-cap: clean ACP response was not persisted "
                         "as its task-id YAML body")
        if len(set(runctx.glob("digest.*.txt")) - digests_before) != 1:
            fails.append("digest-cap: ACP persistence changed digest retention")

        authored = runctx / "T-10.yaml"
        authored.write_text("agent-authored: true\n")
        no_clobber = clean_acp.replace("task_id: T-9", "task_id: T-10")
        r = run("digest-cap.sh", digest_input(no_clobber,
                agent="backend-owner-agent"), proj); ran += 1
        if r.returncode != 0 or authored.read_text() != "agent-authored: true\n":
            fails.append("digest-cap: existing agent-authored block was overwritten")

        yaml_before = set(runctx.glob("*.yaml"))
        digests_before = set(runctx.glob("digest.*.txt"))
        r = run("digest-cap.sh", digest_input(
                "Review completed; no ACP block was returned.",
                agent="prose-agent"), proj); ran += 1
        if r.returncode != 0 or set(runctx.glob("*.yaml")) != yaml_before:
            fails.append("digest-cap: plain prose created a YAML ledger file")
        if len(set(runctx.glob("digest.*.txt")) - digests_before) != 1:
            fails.append("digest-cap: plain prose was not retained as a digest")

        malformed = "kind: response\ntask_id: T-12\ntrailing prose is not YAML"
        digests_before = set(runctx.glob("digest.*.txt"))
        r = run("digest-cap.sh", digest_input(malformed,
                agent="malformed-agent"), proj); ran += 1
        if r.returncode != 0 or (runctx / "T-12.yaml").exists():
            fails.append("digest-cap: non-isolatable ACP-like text created YAML")
        if len(set(runctx.glob("digest.*.txt")) - digests_before) != 1:
            fails.append("digest-cap: malformed ACP-like text lost its digest")

        wrapped_body = clean_acp.replace("task_id: T-9", "task_id: T-11")
        wrapped = "Digest:\n```yaml\n" + wrapped_body + "\n```"
        r = run("digest-cap.sh", digest_input(wrapped,
                agent="wrapped-agent"), proj); ran += 1
        wrapped_file = runctx / "T-11.yaml"
        if (r.returncode != 0 or not wrapped_file.is_file()
                or wrapped_file.read_text() != wrapped_body + "\n"):
            fails.append("digest-cap: fenced ACP block did not strip its "
                         "Digest preamble and Markdown fences")

        case("digest-cap: within cap -> allow", "digest-cap.sh", digest_input(short), 0)
        case("digest-cap: over cap -> block", "digest-cap.sh", digest_input(long_), 2,
             "the cap is 10")
        # transcript_path names the conductor; only the sibling subagent transcript decides the cap.
        case("digest-cap: measures the subagent, not the conducting session",
             "digest-cap.sh",
             digest_input(short, agent="frontend-agent", main_text=long_), 0)
        # F-25: `{run}<task_id>.yaml` lacked a separator and resolved outside the run directory.

        # Reuse this stateful call so an extra invocation does not exhaust the nudge counter.
        case("digest-cap: block names an actionable path", "digest-cap.sh",
             digest_input(long_, agent="qa-agent"), 2, "/<its task_id>.yaml")
        case("digest-cap: blank lines do not count", "digest-cap.sh",
             digest_input("\n\n".join(f"line {i}" for i in range(1, 10))), 0)
        case("digest-cap: stop_hook_active -> allow", "digest-cap.sh",
             json.dumps({"agent_type": "backend-agent", "stop_hook_active": True}), 0)
        case("digest-cap: subagent transcript unresolved -> fail open, silent",
             "digest-cap.sh",
             digest_input(long_, agent="docs-agent", missing_sub=True), 0)
        case("digest-cap: empty transcript_path -> fail open", "digest-cap.sh",
             digest_input(long_, agent="docs-agent2", path=""), 0)
        case("digest-cap: unparseable input -> fail open", "digest-cap.sh", "not-json", 0)
        case("digest-cap: no agent in input -> fail open", "digest-cap.sh",
             json.dumps({"transcript_path": transcript(long_)}), 0)

        # After two blocks the stop passes; further shortening needs the user, not a loop.
        case("digest-cap: nudge 2 still blocks", "digest-cap.sh", digest_input(long_), 2)
        case("digest-cap: nudge ceiling reached -> allow", "digest-cap.sh",
             digest_input(long_), 0)

        # CB-102: ContextMonitor never blocks, stays quiet below threshold, and counts cached tokens.
        def check(name, ok, detail=""):
            nonlocal ran; ran += 1
            if not ok:
                fails.append(f"{name}: {detail}")

        def usage_transcript(**usage):
            t = proj / "u.jsonl"
            t.write_text(json.dumps({"message": {"role": "assistant",
                                                 "content": [{"type": "text", "text": "ok"}],
                                                 "usage": usage}}) + "\n")
            return str(t)

        def mon(path, session="S-1", extra_env=None):
            return run("context-monitor.sh",
                       json.dumps({"session_id": session,
                                   "hook_event_name": "UserPromptSubmit",
                                   "transcript_path": path}), proj,
                       extra_env=extra_env)

        # capacity 168000, checkpoint 117600 per scripts/context-budget
        r = mon(usage_transcript(input_tokens=5000))
        check("context-monitor: below checkpoint is silent",
              r.returncode == 0 and r.stdout.strip() == "",
              f"rc={r.returncode} out={r.stdout[:60]!r}")

        tel = proj / ".claude/cereblnk/telemetry/context.log"
        check("context-monitor: samples every turn", tel.is_file(),
              "no telemetry line written below the checkpoint")
        if tel.is_file():
            body = tel.read_text()
            check("context-monitor: sample carries the numbers",
                  "occupancy=5000" in body and "capacity=168000" in body, body[:120])

        # Cache-warm turn: counting only input_tokens would read this as
        # nearly empty, which is the opposite of true.
        r = mon(usage_transcript(input_tokens=1200, cache_read_input_tokens=130000))
        check("context-monitor: cached tokens count as occupancy",
              r.returncode == 0 and "131200" in r.stdout, r.stdout[:120])
        check("context-monitor: warns via additionalContext, never blocks",
              r.returncode == 0 and "additionalContext" in r.stdout,
              f"rc={r.returncode} out={r.stdout[:80]!r}")
        # F-13: a session acted on 101.8% from an assumed denominator presented as fact.
        check("context-monitor: an assumed window says so",
              "ASSUMED" in r.stdout and "guess" in r.stdout, r.stdout[:160])
        # A measured operator-supplied window must not retain the ASSUMED hedge.
        r_measured = mon(usage_transcript(input_tokens=1200,
                                          cache_read_input_tokens=130000),
                         session="S-2",
        # This window puts 131200 above its 103600 checkpoint so the warning is inspectable.
                         extra_env={"CLAUDE_CODE_AUTO_COMPACT_WINDOW": "180000",
                                    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "32000"})
        check("context-monitor: a measured window drops the hedge",
              "ASSUMED" not in r_measured.stdout and "148000" in r_measured.stdout,
              r_measured.stdout[:160])

        for label, arg in (("no usage field", usage_transcript()),
                           ("missing transcript", ""),
                           ("unparseable input", None)):
            r = (run("context-monitor.sh", "not-json", proj) if arg is None else mon(arg))
            check(f"context-monitor: {label} -> silent",
                  r.returncode == 0 and r.stdout.strip() == "",
                  f"rc={r.returncode} out={r.stdout[:60]!r}")

        # CB-105: archives wrote beside CB_DIR for one release; migration must retain them.
        def archive(project, tpath):
            return run("history-archive.sh",
                       json.dumps({"transcript_path": tpath, "trigger": "auto",
                                   "session_id": "abcdef123456"}), project)

        hp = proj / "hist-src.jsonl"
        hp.write_text('{"message":{"role":"assistant"}}\n')
        archive(proj, str(hp))
        hist = proj / ".claude/cereblnk/history"
        check("history-archive: writes under CB_DIR",
              hist.is_dir() and len(list(hist.glob("*.jsonl"))) == 1,
              f"exists={hist.is_dir()}")
        check("history-archive: does not create the legacy directory",
              not (proj / ".claude/history").is_dir(), "legacy path recreated")

        with tempfile.TemporaryDirectory() as ltd:
            lp = pathlib.Path(ltd) / "p"
            legacy = lp / ".claude/history"
            legacy.mkdir(parents=True)
            (legacy / "20260101-auto-old.jsonl").write_text("older archive\n")
            src = lp / "s.jsonl"
            src.write_text('{"message":{"role":"assistant"}}\n')
            r = archive(lp, str(src))
            moved = sorted(x.name for x in (lp / ".claude/cereblnk/history").glob("*.jsonl"))
            check("history-archive: migrates existing archives once",
                  len(moved) == 2 and "20260101-auto-old.jsonl" in moved, str(moved))
            check("history-archive: legacy directory is gone after the move",
                  not legacy.is_dir(), "legacy directory survived")
            check("history-archive: the move is announced",
                  "moved existing archives" in r.stderr, r.stderr[:100])

        check("history-archive: missing transcript never blocks compaction",
              archive(proj, "").returncode == 0, "non-zero exit on a missing transcript")

        # CB-171: stale-run may warn, but never infer another run, mutate the flag, or block startup.
        def stale_project(name, plan_body=None, hours_old=13,
                          pin="R-2026-08-31-001"):
            project = pathlib.Path(td) / name
            cbdir = project / ".claude/cereblnk"
            flagdir = cbdir / "flags"
            run_dir = cbdir / "context" / pin
            flagdir.mkdir(parents=True)
            run_dir.mkdir(parents=True)
            flag = flagdir / "run-active"
            flag.write_text(pin + "\n", encoding="utf-8")
            stamp = time.time() - hours_old * 3600
            if plan_body is None:
                os.utime(run_dir, (stamp, stamp))
            else:
                plan = run_dir / "plan.md"
                plan.write_text(plan_body, encoding="utf-8")
                os.utime(plan, (stamp, stamp))
            return project, flag, run_dir

        def stale(project, hours=None):
            extra = {"CB_STALE_RUN_HOURS": "12" if hours is None else str(hours)}
            return run("stale-run.sh", "", project, extra_env=extra)

        sp, stale_flag, _ = stale_project("stale-no-plan")
        before = (stale_flag.read_bytes(), stale_flag.stat().st_mtime_ns)
        r = stale(sp)
        lines = r.stderr.splitlines()
        check("stale-run: old pinned run without a plan prints one line",
              r.returncode == 0 and not r.stdout and len(lines) == 1,
              f"rc={r.returncode} stdout={r.stdout!r} stderr={r.stderr!r}")
        check("stale-run: notice names pin, date, and both cleanup commands",
              lines and lines[0].startswith(
                  "cereblnk: run-active pins R-2026-08-31-001 from ")
              and "ledger cold and no task closed" in lines[0]
              and "`/cb-resume`" in lines[0]
              and "`run-flag abandon \"\" R-2026-08-31-001`" in lines[0],
              r.stderr[:240])
        check("stale-run: notice never touches the flag",
              before == (stale_flag.read_bytes(), stale_flag.stat().st_mtime_ns),
              "flag content or timestamp changed")

        sp, _, _ = stale_project(
            "stale-open-plan", "# Plan\n\n- [ ] T-1\n- [ ] T-2\n")
        r = stale(sp)
        check("stale-run: old plan with no closed task is reported",
              r.returncode == 0 and len(r.stderr.splitlines()) == 1,
              f"rc={r.returncode} stderr={r.stderr!r}")

        sp, _, _ = stale_project(
            "stale-closed-plan", "# Plan\n\n- [ ] T-1\n- [x] T-2\n")
        r = stale(sp)
        check("stale-run: any closed plan task suppresses the notice",
              r.returncode == 0 and not r.stdout and not r.stderr,
              f"rc={r.returncode} stderr={r.stderr!r}")

        sp, _, old_dir = stale_project(
            "fresh-plan", "# Plan\n\n- [ ] T-1\n", hours_old=1)
        # The directory can be old while plan.md is fresh; plan activity is
        # the more precise timestamp when the ledger exists.
        old_stamp = time.time() - 24 * 3600
        os.utime(old_dir, (old_stamp, old_stamp))
        r = stale(sp)
        check("stale-run: fresh plan mtime wins over an old directory",
              r.returncode == 0 and not r.stdout and not r.stderr,
              f"rc={r.returncode} stderr={r.stderr!r}")

        sp, _, _ = stale_project("threshold-override", hours_old=13)
        r = stale(sp, hours=24)
        check("stale-run: threshold override suppresses a younger run",
              r.returncode == 0 and not r.stdout and not r.stderr,
              f"rc={r.returncode} stderr={r.stderr!r}")
        r = stale(sp, hours="not-a-number")
        check("stale-run: invalid threshold fails open and silent",
              r.returncode == 0 and not r.stdout and not r.stderr,
              f"rc={r.returncode} stderr={r.stderr!r}")

        sp, bad_flag, _ = stale_project("garbage-pin")
        bad_flag.write_text("../../etc\n", encoding="utf-8")
        r = stale(sp)
        check("stale-run: invalid pin fails open and silent",
              r.returncode == 0 and not r.stdout and not r.stderr,
              f"rc={r.returncode} stderr={r.stderr!r}")

        # CB-107: one run left three root scratch files; path shape, not filename, is the signal.
        def write_to(path, project=None):
            return run("scratch-guard.sh",
                       json.dumps({"tool_name": "Write",
                                   "tool_input": {"file_path": path}}),
                       project or proj)

        (proj / "src").mkdir(exist_ok=True)
        (proj / "README.md").write_text("# fixture\n")
        subprocess.run(["git", "init", "-q"], cwd=str(proj), capture_output=True)
        subprocess.run(["git", "add", "README.md"], cwd=str(proj), capture_output=True)

        check("scratch-guard: no active run -> allow",
              write_to(str(proj / "debug.txt")).returncode == 0, "blocked outside a run")

        (flags / "run-active").touch()
        check("scratch-guard: new root file blocked",
              write_to(str(proj / "debug.txt")).returncode == 2, "root scratch allowed")
        r = write_to("medium.txt")
        check("scratch-guard: a bare name is still root-level",
              r.returncode == 2, "relative path escaped the check")
        check("scratch-guard: names where notes belong",
              "scratch" in r.stderr, r.stderr[:90])
        check("scratch-guard: a subdirectory is real work",
              write_to(str(proj / "src/Main.java")).returncode == 0, "blocked src/")
        check("scratch-guard: a tracked root file is the project deciding",
              write_to(str(proj / "README.md")).returncode == 0, "blocked a tracked file")
        check("scratch-guard: CB_DIR is not the repository root",
              write_to(str(proj / ".claude/cereblnk/state.md")).returncode == 0,
              "blocked runtime state")
        check("scratch-guard: nudge ceiling releases",
              write_to(str(proj / "debug9.txt")).returncode == 0, "guard never yields")

        # F-18/F-19: destructive words inside heredoc data once blocked findings, fixtures, and logs.
        # Both false-positive and true-positive anchors protect the stripper from drift.
        careful = flags / "careful"

        def dc(cmd):
            return run("destructive-command.sh", bash(cmd), proj)

        check("destructive: flag absent -> allow",
              dc("rm -rf /tmp/anything").returncode == 0,
              "blocked while /cb-careful was off")

        careful.touch()

        heredoc = (
            "cat >> docs/findings.md <<'EOF'\n"
            "F-18: the hook blocked `rm -rf build`, `git push --force`\n"
            "and `DROP TABLE users` when they appeared as prose.\n"
            "EOF"
        )
        check("destructive: heredoc that only MENTIONS destructive commands -> allow",
              dc(heredoc).returncode == 0,
              "documentation about destructive commands is still blocked (F-18)")
        for label, cmd in (
            ("quoted commit message", 'git commit -m "explain why rm -rf is blocked"'),
            ("echoed prose", 'echo "never run git reset --hard here" > NOTES'),
            ("python string literal", "printf '%s' 'drop table t' > fixture.sql"),
        ):
            check(f"destructive: {label} -> allow",
                  dc(cmd).returncode == 0, f"data matched as a command (F-18): {cmd}")

        for label, cmd in (
            ("bare recursive delete", "rm -rf /var/data"),
            ("recursive delete of a quoted path", 'rm -rf "$HOME/data"'),
            ("force push", "git push origin main --force"),
            ("hard reset", "git reset --hard HEAD~3"),
            ("SQL through a client -c argument", 'psql -d app -c "DROP TABLE users"'),
            ("code through sh -c", "sh -c 'rm -rf /var/data'"),
            ("script body in an interpreted heredoc",
             "bash <<'EOF'\nrm -rf /var/data\nEOF"),
            # found while writing this suite: looking only at the text
            # LEFT of `<<` reads this as a harmless `cat`
            ("heredoc body piped into a shell",
             "cat <<EOF | bash\nrm -rf /var/data\nEOF"),
            ("eval of a quoted command", 'eval "rm -rf /var/data"'),
            ("xargs delete", "xargs rm -rf < list.txt"),
            ("remote delete over ssh", 'ssh host "rm -rf /var/data"'),
            ("find -exec delete", "find . -name x -exec rm -rf {} \\;"),
            ("SQL through a client -e argument", 'mysql -e "TRUNCATE TABLE users"'),
            ("delete chained after the disarm",
             "rm -f .claude/cereblnk/flags/careful && rm -rf /var/data"),
        ):
            r = dc(cmd)
            check(f"destructive: {label} -> block",
                  r.returncode == 2, f"NOT blocked (bypass): {cmd}")

        for label, cmd in (
            ("allowed build then recursive delete", "rm -rf build && rm -rf /var/data"),
            ("allowed dist then recursive delete", "rm -rf dist ; rm -rf /var/data"),
            ("allowed node_modules then root delete", "rm -rf node_modules && rm -rf /"),
            ("allowed target or docker volume delete", "rm -rf target || docker volume rm pgdata"),
        ):
            check(f"destructive: {label} -> block",
                  dc(cmd).returncode == 2, f"allowlisted segment laundered a destructive one: {cmd}")

        for label, cmd in (
            ("single allowlisted delete", "rm -rf build"),
            ("two allowlisted delete segments", "rm -rf node_modules && rm -rf dist"),
            ("multiple operands in one allowlisted delete", "rm -rf node_modules dist"),
        ):
            check(f"destructive: {label} -> allow",
                  dc(cmd).returncode == 0, f"allowlisted delete was blocked: {cmd}")

        # F-19: the escape named by the block message must work through the same hook.
        r = dc("rm -rf /var/data")
        msg = r.stderr + r.stdout
        check("destructive: block names /cb-careful off",
              "/cb-careful off" in msg, msg[:120])
        check("destructive: block names the disarm mechanism",
              "flag careful disarm" in msg, msg[:120])
        for label, cmd in (
            ("forced delete of the careful flag",
             "rm -f .claude/cereblnk/flags/careful"),
            ("recursive delete of the careful flag",
             'rm -rf "$CB_DIR/flags/careful"'),
            ("the run-flag mechanism itself",
             "plugins/cereblnk/scripts/run-flag flag careful disarm"),
        ):
            check(f"destructive: {label} -> allow (F-19)",
                  dc(cmd).returncode == 0, f"the documented escape is blocked: {cmd}")
        careful.unlink()

        # F-17: /cb-careful's direction is decided by run-flag, by exact
        # match, not by the model reading a sentence.
        rf = ROOT / "plugins/cereblnk/scripts/run-flag"

        def flag(arg):
            return subprocess.run(["bash", str(rf), "flag", "careful", arg,
                                   str(proj / ".claude/cereblnk")],
                                  capture_output=True, text=True)

        check("careful: 'on' arms", flag("on").returncode == 0 and careful.exists(),
              "on did not arm the flag")
        check("careful: 'off' disarms",
              flag("off").returncode == 0 and not careful.exists(),
              "off did not disarm the flag")
        careful.touch()
        r = flag("please turn careful mode on for this repo")
        check("careful: a sentence is refused, not guessed (F-17)",
              r.returncode == 2, f"rc={r.returncode} — the direction was inferred")
        check("careful: a refused direction changes nothing",
              careful.exists(), "the flag state moved on an unparsed argument")
        check("careful: the refusal says what is accepted",
              "on, off, arm, disarm, status" in (r.stderr + r.stdout), r.stderr[:120])
        careful.unlink()

        # F-24: an architect denied edit tools still authored four spec sections through shell writes.
        # This tests in-place edits; check-agent-skills A-7 checks the definition half.
        def floor(cmd, agent=None):
            payload = {"tool_name": "Bash", "tool_input": {"command": cmd}}
            if agent:
                payload["agent_type"] = agent
            return run("tool-floor.sh", json.dumps(payload), proj)

        def floor_write(path, agent=None):
            payload = {"tool_name": "Write",
                       "tool_input": {"file_path": str(path), "content": "replacement"}}
            if agent:
                payload["agent_type"] = agent
            return run("tool-floor.sh", json.dumps(payload), proj)

        ARCH = "architect-agent"
        r = floor("sed -i s/a/b/ src/F.java", ARCH)
        check("tool-floor: an in-place edit under a denial is blocked",
              r.returncode == 2, f"rc={r.returncode}")
        check("tool-floor: the block names the tool and the file",
              "disallowedTools" in r.stderr and "src/F.java" in r.stderr,
              r.stderr[:120])
        check("tool-floor: the block names the honest route",
              "Response Block" in r.stderr, r.stderr[:120])
        check("tool-floor: the qualified spawn name resolves too",
              floor("patch -p1 < d.diff",
                    "cereblnk:engineering:architect-agent").returncode == 2,
              "qualified identity did not resolve to the definition")
        # SS1 grants Write for Response Blocks, so blocking redirection would exceed the tool denial.
        check("tool-floor: a redirection is Write-shaped, not blocked",
              floor("cat > spec.md <<EOF\nx\nEOF", ARCH).returncode == 0,
              "a whole-file write was blocked")
        check("tool-floor: a read-only command is untouched",
              floor("grep -rn foo src/", ARCH).returncode == 0, "blocked a read")
        # Fail-open paths: a floor that cannot read the definition has
        # no grounds to block, only grounds to stay quiet.
        check("tool-floor: an unrestricted agent is untouched",
              floor("sed -i s/a/b/ src/F.java", "backend-agent").returncode == 0,
              "blocked an agent that denies no edit tool")
        check("tool-floor: no identity is the conductor, not this hook",
              floor("sed -i s/a/b/ src/F.java").returncode == 0,
              "took DelegationGuard's case")
        check("tool-floor: an opaque agent id cannot be judged",
              run("tool-floor.sh",
                  json.dumps({"tool_name": "Bash", "agent_id": "a9ca0309334d",
                              "tool_input": {"command": "sed -i s/a/b/ f"}}),
                  proj).returncode == 0,
              "blocked on an id it cannot resolve")
        memory_plan = proj / ".claude/cereblnk/memory/plans/x.md"
        memory_plan.parent.mkdir(parents=True)
        memory_plan.write_text("existing plan\n")
        source = proj / "src/Main.java"
        source.write_text("class Main {}\n")
        outside = pathlib.Path(td) / "outside.md"
        outside.write_text("scratch\n")

        check("tool-floor: planner may replace existing run plan",
              floor_write(".claude/cereblnk/context/R-T/plan.md",
                          "planner-agent").returncode == 0,
              "blocked the planner acceptance case")
        check("tool-floor: planner may replace existing memory plan",
              floor_write(".claude/cereblnk/memory/plans/x.md",
                          "planner-agent").returncode == 0,
              "blocked a legitimate memory write")
        verifier_write = floor_write("src/Main.java", "verifier-agent")
        check("tool-floor: verifier may not replace existing source",
              verifier_write.returncode == 2, f"rc={verifier_write.returncode}")
        qa_write = floor_write("src/Main.java", "qa-agent")
        check("tool-floor: qa may not replace existing source",
              qa_write.returncode == 2, f"rc={qa_write.returncode}")
        check("tool-floor: architect may create a new ADR",
              floor_write("docs/adr/0001-x.md", "architect-agent").returncode == 0,
              "blocked a new source file")
        check("tool-floor: unrestricted backend may replace existing source",
              floor_write("src/Main.java", "backend-agent").returncode == 0,
              "blocked an agent that denies no edit tool")
        check("tool-floor: conductor may replace existing source",
              floor_write("src/Main.java").returncode == 0,
              "took DelegationGuard's case")
        check("tool-floor: denied role may replace existing outside file",
              floor_write(outside, "verifier-agent").returncode == 0,
              "blocked scratch space outside the repository")
        check("tool-floor: Write block names the role and file",
              "verifier-agent" in verifier_write.stderr and
              "src/Main.java" in verifier_write.stderr,
              verifier_write.stderr[:160])

        editor_hooks = next(h["hooks"] for h in manifest["hooks"]["PreToolUse"]
                            if h.get("matcher") == "Write|Edit|MultiEdit|NotebookEdit")
        check("tool-floor: editor matcher registers tool-floor",
              any("tool-floor.sh" in h.get("command", "") for h in editor_hooks),
              "tool-floor is absent from the editor matcher")
        check("tool-floor: manifest description covers Write replacements",
              "Write replacements of existing repository source" in manifest["description"],
              "ToolFloor description still covers only shell edits")
        check("tool-floor: unparseable input is silent",
              run("tool-floor.sh", "not-json", proj).returncode == 0,
              "blocked on garbage")

    if fails:
        print("\n".join("FAIL " + x for x in fails), file=sys.stderr)
        print(f"test-hooks: {len(fails)}/{ran} failed", file=sys.stderr); return 1
    print(f"test-hooks: {ran} checks passed (delegation, secret, boundary, run-guard, digest-cap, context-monitor, history-archive, stale-run, scratch-guard, tool-floor, destructive-command)")
    return 0

if __name__ == "__main__":
    sys.exit(main())
