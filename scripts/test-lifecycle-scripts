#!/usr/bin/env python3
"""test-lifecycle-scripts (CB-086) — spec-assemble, run-status, ensure-gitignore.

spec-assemble:  good sections → head written, spec_version=1;
                reassemble → v2 head + v1 archived in history/;
                missing section → A-1, rc 1, nothing written;
                label-stripped section → A-2, rc 1;
                diagrams without fence → A-3, rc 1.
run-status:     no state.md → graceful line, rc 0;
                full state + plan + inbox → run/progress/inbox lines.
ensure-gitignore: adds when absent; idempotent second run;
                respects opt-out flag; respects pre-existing pattern.
plan-lint:      a direct run (/cb-do) has no spec, and its header says
                so — the field must stay present and admissible, or the
                spec-less entry point cannot write a resumable plan;
                a header still missing a field is still rejected.
"""
import os, pathlib, shutil, subprocess, sys, tempfile

ROOT = pathlib.Path(__file__).resolve().parent.parent
PS = ROOT / "plugins/cereblnk/scripts"

def run(script, args, cwd, env_extra=None):
    env = dict(os.environ); env.update(env_extra or {})
    return subprocess.run(["bash", str(PS / script)] + args, cwd=cwd,
                          capture_output=True, text=True, env=env)


def plan_lint_cases(tmp, case):
    """CB-101: the spec-less header must pass, an incomplete one must not."""
    plan = tmp / "direct-plan.md"
    body = ("### [ ] Task 1: store the key with the outcome\n"
            "- risk: HIGH\n"
            "- files: src/main/java/com/acme/pay/PaymentService.java\n"
            "- verify: a repeated key returns the first outcome\n")
    plan.write_text(
        "# Plan\n\n"
        "- spec: none — direct request (/cb-do)\n"
        "- goal: add an idempotency key to capture\n"
        "- out_of_scope: refunds, reporting\n"
        "- recomposition_check: ./gradlew test --tests '*CaptureTest'\n\n"
        + body, encoding="utf-8")
    r = run("plan-lint", [str(plan)], cwd=tmp)
    case("plan-lint: spec-less direct header is admissible", r.returncode == 0,
         r.stderr[:120])

    plan.write_text(
        "# Plan\n\n"
        "- spec: none — direct request (/cb-do)\n"
        "- goal: add an idempotency key to capture\n\n"
        + body, encoding="utf-8")
    r = run("plan-lint", [str(plan)], cwd=tmp)
    case("plan-lint: a header missing fields is still rejected",
         r.returncode == 1 and "R4" in r.stdout + r.stderr,
         "rc=%d" % r.returncode)

SEC = {
    "architecture": "Service split per bounded context. Known: current module graph.",
    "data-flow": "Ingress via API gateway. Derived: from architecture facts.",
    "state-transitions": "Draft -> Review -> Published. Known: status enum.",
    "failure-modes": "Queue backlog on burst. Estimated: 2x peak, basis: telemetry.",
    "trust-boundaries": "Gateway validates JWT. Assumed: no internal caller bypass.",
    "diagrams": "Known: component layout.\n```mermaid\ngraph TD; A-->B;\n```",
    "test-matrix": "publish x draft: expect 409. Known: handler contract.",
}

def write_sections(d, omit=None, strip_label=None, no_fence=False):
    d.mkdir(parents=True, exist_ok=True)
    for k, v in SEC.items():
        if k == omit: continue
        body = v
        if k == strip_label:
            for w in ("Known", "Derived", "Estimated", "Assumed", "Speculative"):
                body = body.replace(w, "noted")
        if no_fence and k == "diagrams":
            body = "Known: layout, described in words only."
        (d / f"{k}.md").write_text(body)

def main():
    bad = 0
    def check(name, ok, detail=""):
        nonlocal bad
        print(f"  {'ok' if ok else 'FAIL'}  {name}" + (f" — {detail}" if detail and not ok else ""))
        bad += 0 if ok else 1

    tmp = pathlib.Path(tempfile.mkdtemp(prefix="lc-test-"))
    try:
        # ---- spec-assemble
        cb = tmp / ".claude/cereblnk"
        specs = cb / "memory/specs"; specs.mkdir(parents=True)
        sec = tmp / "sections"; write_sections(sec)
        out = specs / "checkout.md"

        r = run("spec-assemble", [str(sec), str(out)], cwd=tmp)
        check("assemble v1", r.returncode == 0 and out.is_file(), r.stdout + r.stderr)
        check("v1 header", "spec_version: 1" in out.read_text())
        check("seven sections", out.read_text().count("\n## ") + out.read_text().startswith("## ") == 7
              or len([l for l in out.read_text().splitlines() if l.startswith("## ")]) == 7)

        r = run("spec-assemble", [str(sec), str(out)], cwd=tmp)
        hist = cb / "memory/history/spec-checkout-v1.md"
        check("v2 head after reassemble", "spec_version: 2" in out.read_text())
        check("v1 archived to history/", hist.is_file())

        bad_sec = tmp / "sections-missing"; write_sections(bad_sec, omit="test-matrix")
        out2 = specs / "other.md"
        r = run("spec-assemble", [str(bad_sec), str(out2)], cwd=tmp)
        check("missing section: A-1 rc1", r.returncode == 1 and "A-1" in r.stdout and not out2.exists())

        nl = tmp / "sections-nolabel"; write_sections(nl, strip_label="architecture")
        r = run("spec-assemble", [str(nl), str(out2)], cwd=tmp)
        check("stripped label: A-2 rc1", r.returncode == 1 and "A-2" in r.stdout)

        nf = tmp / "sections-nofence"; write_sections(nf, no_fence=True)
        r = run("spec-assemble", [str(nf), str(out2)], cwd=tmp)
        check("diagram fence: A-3 rc1", r.returncode == 1 and "A-3" in r.stdout)

        # ---- run-status
        r = run("run-status", [str(cb)], cwd=tmp)
        check("no state: graceful rc0", r.returncode == 0 and "no active run state" in r.stdout)

        (cb / "context/R-1").mkdir(parents=True)
        (cb / "state.md").write_text(
            "written_by: conductor\nrun_id: R-1\ndate: 2026-07-25\n"
            'acp_version: "1.0"\nstage: implement\n'
            "spec: memory/specs/checkout.md · v2\nplan: memory/plans/checkout.md · v2\n")
        plans = cb / "memory/plans"; plans.mkdir(parents=True)
        (plans / "checkout.md").write_text(
            "### [x] Task 1: Wire endpoint\n- risk: LOW\n"
            "### [ ] Task 2: Add validation\n- risk: HIGH\n")
        (cb / "context/R-1/inbox.md").write_text(
            "- [ ] 2026-07-25T14:02 · class: correction · \"use JSONB\"\n"
            "- [ ] 2026-07-25T14:05 · class: clarification · \"why slice 3?\"\n"
            "- [x] 2026-07-25T14:10 · class: correction · closed\n")
        r = run("run-status", [str(cb)], cwd=tmp)
        check("run line", "run: R-1" in r.stdout and "stage: implement" in r.stdout)
        check("progress line", "progress: 1/2 checked" in r.stdout and "Task 2" in r.stdout)
        check("inbox counts both", "inbox: 2 unresolved (1 blocking)" in r.stdout, r.stdout)

        # ---- ensure-gitignore
        repo = tmp / "repo"; repo.mkdir()
        subprocess.run(["git", "init", "-q"], cwd=repo, check=True)
        r = run("ensure-gitignore", [str(repo)], cwd=tmp)
        gi = repo / ".gitignore"
        check("adds .claude/", r.returncode == 0 and gi.is_file() and ".claude/" in gi.read_text())
        before = gi.read_text()
        r = run("ensure-gitignore", [str(repo)], cwd=tmp)
        check("idempotent", "already ignored" in r.stdout and gi.read_text() == before)

        repo2 = tmp / "repo2"; (repo2 / ".claude/cereblnk/flags").mkdir(parents=True)
        subprocess.run(["git", "init", "-q"], cwd=repo2, check=True)
        (repo2 / ".claude/cereblnk/flags/no-gitignore").touch()
        r = run("ensure-gitignore", [str(repo2)], cwd=tmp)
        check("opt-out respected", "opt-out" in r.stdout and not (repo2 / ".gitignore").exists())

        # ---- plan-lint, spec-less entry point (CB-101)
        plan_lint_cases(tmp, check)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)

    print("test-lifecycle-scripts:", "all green" if bad == 0 else f"{bad} FAILURES")
    return 1 if bad else 0

if __name__ == "__main__":
    sys.exit(main())
