#!/usr/bin/env python3
"""gen-bindings — a host's hook config, generated from the two-hop policy (CB-124).

Concept -> capability -> host binding. The middle hop is the whole point:
bound straight to one host's event names, a capability that is mechanical
there looks mechanical everywhere, and the first port inherits a claim
nobody checked.

The generated file is committed. It is not hand-edited — check-generated
regenerates every committed binding and goes red on any difference, which
is the only thing keeping a second host from becoming a second copy.

Usage:
  scripts/gen-bindings claude            print the binding to stdout
  scripts/gen-bindings claude --write    write it to its committed path
  scripts/gen-bindings --list            hosts with a binding file

Exit: 0 fine · 1 the policy could not be read or is inconsistent
"""
import json
import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
POLICY = ROOT / "plugins/cereblnk/policies"
# Codex and Cursor both load hooks/hooks.json by default, which is
# Claude's file, so each gets its own emitted beside it and its manifest
# points there.
OUT = {"claude": ROOT / "plugins/cereblnk/hooks/hooks.json",
       "codex": ROOT / "plugins/cereblnk/hooks/codex-hooks.json",
       "cursor": ROOT / "plugins/cereblnk/hooks/cursor-hooks.json",
       "gemini": ROOT / "plugins/cereblnk/hooks/gemini-hooks.json"}

# Per-host dialect. The binding says which event carries which capability;
# this says how that host wants it written down. Two hosts agreeing on an
# event name and disagreeing on the surrounding shape is the ordinary
# case, not the surprise — keeping both in one table is what stops the
# difference from being retyped into eighteen scripts.
#
#   nested  {"Event": [{"matcher": M, "hooks": [{"type","command"}]}]}
#   flat    {"event": [{"command", "matcher"}]}
DIALECT = {
    "claude": {"shape": "nested", "root": "${CLAUDE_PLUGIN_ROOT}"},
    "codex": {"shape": "nested", "root": "${CLAUDE_PLUGIN_ROOT}"},
    "cursor": {"shape": "flat", "root": "${PLUGIN_ROOT}"},
    # Gemini nests like Claude Code and shares its refusal contract —
    # exit 2 aborts the target action, stderr carries the reason — so
    # only the path variable differs.
    "gemini": {"shape": "nested", "root": "${extensionPath}"},
}


def read_blocks(path, first_key):
    """The restricted subset this repo already uses for policy files.

    Deliberately not general YAML: a plugin the user installs may not
    add a dependency, and the standard library carries no reader. The
    schema is a list of blocks with scalar values, which a few lines
    handle exactly and predictably.
    """
    blocks, errors, cur, header = [], [], None, {}
    if not path.exists():
        return [], {}, ["%s not found" % path]
    for n, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        m = re.match(r"^(\w+):\s*(.*)$", line)
        if m and not line.startswith(" "):
            key, val = m.group(1), m.group(2).strip()
            if val:
                header[key] = json.loads(val) if val.startswith('"') else val
            continue
        m = re.match(r"^\s*-\s*%s:\s*(.+?)\s*$" % first_key, line)
        if m:
            cur = {first_key: m.group(1), "line": n}
            blocks.append(cur)
            continue
        m = re.match(r"^\s+(\w+):\s*(.+?)\s*$", line)
        if not m:
            errors.append("line %d: unparsed: %s" % (n, line.strip()))
            continue
        if cur is None:
            errors.append("line %d: %s before any block" % (n, m.group(1)))
            continue
        cur[m.group(1)] = m.group(2).strip().strip("'")
    return blocks, header, errors


def build(host):
    caps, _, cap_err = read_blocks(POLICY / "capabilities.yaml", "capability")
    binds, header, bind_err = read_blocks(
        POLICY / ("hosts/%s.yaml" % host), "capability")
    errors = cap_err + bind_err
    if not binds and not errors:
        errors.append("no bindings for host %r" % host)

    known = {c["capability"]: c for c in caps}
    for b in binds:
        if b["capability"] not in known:
            errors.append("line %d: %s is not in capabilities.yaml"
                          % (b["line"], b["capability"]))
        cls = b.get("class", "")
        base = cls.split(":", 1)[1] if cls.startswith("declared:") else cls
        if base not in ("M", "D", "F"):
            errors.append(
                "line %d: %s has class %r. Expected M, D or F, optionally "
                "prefixed declared: for a class taken from a cited "
                "specification rather than a run."
                % (b["line"], b["capability"], cls))
    if errors:
        return None, errors

    dialect = DIALECT.get(host, DIALECT["claude"])
    root = dialect["root"]
    hooks = {}
    for b in binds:
        if b["class"].endswith("F"):
            continue  # absent on this host; nothing to emit
        event = b["event"]
        command = '"%s/hooks/scripts/%s"' % (root,
                                             known[b["capability"]]["script"])
        group = hooks.setdefault(event, [])
        matcher = b.get("matcher")

        if dialect["shape"] == "flat":
            entry = {"command": command}
            if matcher is not None:
                entry["matcher"] = matcher
            group.append(entry)
            continue

        entry = {"type": "command", "command": command}
        # consecutive rows sharing an event and matcher become one group,
        # which is how the generated file reproduces the hand-written one
        if group and group[-1].get("matcher") == matcher:
            group[-1]["hooks"].append(entry)
        else:
            block = {"hooks": [entry]}
            if matcher is not None:
                block = {"matcher": matcher, "hooks": [entry]}
            group.append(block)

    doc = {}
    if "description" in header:
        doc["description"] = header["description"]
    doc["hooks"] = hooks
    return json.dumps(doc, indent=2) + "\n", []


def main():
    argv = sys.argv[1:]
    if "--list" in argv:
        for p in sorted((POLICY / "hosts").glob("*.yaml")):
            print(p.stem)
        return 0
    if not argv:
        print(__doc__.strip().splitlines()[0], file=sys.stderr)
        return 1

    host = argv[0]
    text, errors = build(host)
    if errors:
        print("gen-bindings: %s: %d problem(s)" % (host, len(errors)),
              file=sys.stderr)
        for e in errors:
            print("  %s" % e, file=sys.stderr)
        return 1

    if "--write" in argv:
        target = OUT.get(host)
        if target is None:
            print("gen-bindings: no committed path for host %r — add one to "
                  "OUT before writing" % host, file=sys.stderr)
            return 1
        target.write_text(text, encoding="utf-8")
        print("gen-bindings: wrote %s" % target.relative_to(ROOT))
        return 0

    sys.stdout.write(text)
    return 0


if __name__ == "__main__":
    sys.exit(main())
