#!/usr/bin/env python3
"""check-exec-bit — a hook that cannot run fails silently.

Checks the index because that is what travels; imported files need no mode bit.

Exit: 0 clean · 1 a command cannot be executed (each named).
"""
import json
import pathlib
import re
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
HOOKS_JSON = ROOT / "plugins/cereblnk/hooks/hooks.json"


def index_modes():
    # One filesystem once cleared all 52 POSIX mode bits without changing file content.
    out = subprocess.run(["git", "ls-files", "-s"], cwd=str(ROOT),
                         capture_output=True, text=True, check=True).stdout
    modes = {}
    for line in out.splitlines():
        head, _, path = line.partition("\t")
        modes[path] = head.split()[0]
    return modes


def main():
    if not HOOKS_JSON.is_file():
        print("check-exec-bit: hooks.json missing", file=sys.stderr)
        return 1
    try:
        modes = index_modes()
    except Exception as e:
        print(f"check-exec-bit: cannot read the index ({e})", file=sys.stderr)
        return 1

    wanted = set()
    cfg = json.loads(HOOKS_JSON.read_text(encoding="utf-8"))
    for event in cfg.get("hooks", {}).values():
        for group in event:
            for hook in group.get("hooks", []):
                m = re.search(r"hooks/scripts/([\w.-]+)", hook.get("command", ""))
                if m:
                    wanted.add(f"plugins/cereblnk/hooks/scripts/{m.group(1)}")
    hook_count = len(wanted)
    wanted.add("scripts/verify")

    # X-3 (F-22): run-flag alone shipped non-executable in 1.3.5; ten
    # workflows then stopped at exit 126.
    script_paths = set()
    for f in sorted((ROOT / "plugins/cereblnk/scripts").iterdir()):
        if f.is_file():
            script_paths.add(f"plugins/cereblnk/scripts/{f.name}")
    wanted |= script_paths

    # X-4: bin/ files are reached by bare name, so a missing mode bit is silent.
    bin_dir = ROOT / "plugins/cereblnk/bin"
    bin_paths = set()
    if not bin_dir.is_dir():
        print("X-4 plugins/cereblnk/bin: an installed plugin puts this on "
              "PATH, and it is not in the tree. Restore it with its README, "
              "or remove this rule together with the claim it checks.")
        bad_bin = 1
    else:
        bad_bin = 0
        if not (bin_dir / "README.md").is_file():
            print("X-4 plugins/cereblnk/bin: no README recording why it is "
                  "empty — an empty directory with no note reads as an "
                  "accident, which is what F-12 found.")
            bad_bin += 1
        for f in sorted(bin_dir.iterdir()):
            if f.is_file() and f.name != "README.md":
                bin_paths.add(f"plugins/cereblnk/bin/{f.name}")
    wanted |= bin_paths

    bad = bad_bin
    for path in sorted(wanted):
        mode = modes.get(path)
        if path == "scripts/verify":
            rule = "X-2"
        elif path.startswith("plugins/cereblnk/scripts/"):
            rule = "X-3"
        elif path.startswith("plugins/cereblnk/bin/"):
            rule = "X-4"
        else:
            rule = "X-1"
        if mode is None:
            print(f"{rule} {path}: named as a command but not tracked")
            bad += 1
        elif mode != "100755":
            print(f"{rule} {path}: mode {mode} in the index — it cannot be executed, "
                  f"and nothing will say so at run time")
            bad += 1

    if bad:
        print(f"check-exec-bit: {bad} command(s) cannot run. Restore with "
              f"`git update-index --chmod=+x <path>` and commit.", file=sys.stderr)
        return 1
    print(f"check-exec-bit: {hook_count} hook(s), {len(script_paths)} script(s) and the verify entry point are executable; "
          f"bin/ is present with {len(bin_paths)} executable(s)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
