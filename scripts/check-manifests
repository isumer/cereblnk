#!/usr/bin/env python3
"""check-manifests — a manifest points at something that exists (CB-126).

Packaging fails quietly. A manifest naming a directory that is not there
installs cleanly and delivers nothing, and the first sign is a host that
loads the plugin and behaves as though it had not.

So every path a manifest declares is resolved against the tree, and the
version it advertises is compared with the one the plugin actually
carries. A manifest that agrees with itself and disagrees with the
repository is the failure worth catching.

Required and forbidden fields come from each host's published manifest
specification, and a specification is authoritative for a *format* in a
way no document is authoritative for runtime behaviour. That distinction
is the whole reason this checker can be strict while the capability
matrix stays cautious: whether `policy.installation` is required is a
fact about a schema, whether a hook actually blocks is a fact about two
programs meeting.

What this does NOT check: whether a host's own installer accepts the
file. That needs the host and belongs to CB-131. Passing here means the
manifest conforms to the published schema and its paths are real — not
that any host has ever read it.

Usage: scripts/check-manifests

Exit: 0 every manifest resolves · 1 at least one does not
"""
import json
import pathlib
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
PLUGIN = ROOT / "plugins/cereblnk"

# manifest -> (base directory its relative paths resolve against,
#              keys whose values are paths)
MANIFESTS = {
    ".claude-plugin/marketplace.json": (ROOT, ("source",)),
    "plugins/cereblnk/.claude-plugin/plugin.json": (PLUGIN, ()),
    ".agents/plugins/marketplace.json": (ROOT, ("path",)),
    ".cursor-plugin/marketplace.json": (ROOT, ("source",)),
    "plugins/cereblnk/.cursor-plugin/plugin.json": (PLUGIN, ("hooks",)),
    "plugins/cereblnk/gemini-extension.json": (PLUGIN, ("contextFileName",)),
    "plugins/cereblnk/.codex-plugin/plugin.json": (PLUGIN, ("skills", "agents")),
}

VERSIONED = ("plugins/cereblnk/.claude-plugin/plugin.json",
             "plugins/cereblnk/.codex-plugin/plugin.json",
             "plugins/cereblnk/.cursor-plugin/plugin.json",
             "plugins/cereblnk/gemini-extension.json")

# Per-manifest schema rules, each traceable to a published specification.
# `forbidden` is not pedantry: a field the schema does not define may be
# silently ignored, which reads in a diff as though a surface were wired
# when nothing wired it.
SCHEMA = {
    ".agents/plugins/marketplace.json": {
        "spec": "https://developers.openai.com/codex/plugins/build",
        "required": ("name", "interface.displayName"),
        "required_per_plugin": ("name", "source.path", "policy.installation",
                                "policy.authentication", "category"),
        "forbidden": (),
    },
    "plugins/cereblnk/gemini-extension.json": {
        "spec": "https://geminicli.com/docs/extensions/reference/",
        "required": ("name", "version"),
        "required_per_plugin": (),
        # the manifest carries mcpServers, contextFileName, excludeTools,
        # settings and themes; hooks, skills and agents are discovered by
        # folder and declaring them here would be read by nobody
        "forbidden": ("hooks", "skills", "agents", "commands"),
    },
    ".cursor-plugin/marketplace.json": {
        "spec": "https://cursor.com/docs/reference/plugins",
        "required": ("name", "owner.name"),
        "required_per_plugin": ("name", "source"),
        "forbidden": (),
    },
    "plugins/cereblnk/.cursor-plugin/plugin.json": {
        "spec": "https://cursor.com/docs/reference/plugins",
        "required": ("name", "displayName"),
        "required_per_plugin": (),
        "forbidden": (),
    },
    "plugins/cereblnk/.codex-plugin/plugin.json": {
        "spec": "https://developers.openai.com/codex/plugins/build",
        "required": ("name", "version", "description"),
        "required_per_plugin": (),
        # the manifest defines skills, mcpServers, apps and hooks; agents
        # is not among them.
        #
        # `hooks` is contested, and this checker does not resolve it. The
        # vendor's plugin-json spec documents the field, shows it in its
        # example manifest, and says string-valued skills/hooks/mcpServers
        # supplement default discovery — and the same file says validation
        # rejects unsupported manifest fields such as hooks, which is why
        # its scaffold omits them. Both readings are first-party.
        #
        # The field stays, because the default this repo would fall back
        # to is hooks/hooks.json, and that file is Claude Code's binding.
        # Omitting the field to satisfy one reading would load the wrong
        # hooks under the other. CB-148 settles it by running the vendor's
        # own validator and an install, which is the only thing that can:
        # a specification is authoritative for a format only while it
        # agrees with itself.
        "forbidden": ("agents", "commands"),
    },
}


def dig(node, dotted):
    for part in dotted.split("."):
        if not isinstance(node, dict) or part not in node:
            return None
        node = node[part]
    return node


def walk(node, keys, found):
    """Collect every value stored under one of `keys`, at any depth."""
    if isinstance(node, dict):
        for k, v in node.items():
            if k in keys and isinstance(v, str):
                found.append(v)
            walk(v, keys, found)
    elif isinstance(node, list):
        for item in node:
            walk(item, keys, found)


def main():
    problems, checked, versions = [], 0, {}

    for rel, (base, path_keys) in MANIFESTS.items():
        path = ROOT / rel
        if not path.exists():
            problems.append("%s: missing" % rel)
            continue
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
        except ValueError as exc:
            problems.append("%s: not valid JSON: %s" % (rel, exc))
            continue

        if not data.get("name"):
            problems.append("%s: no name" % rel)

        schema = SCHEMA.get(rel)
        if schema:
            for field in schema["required"]:
                if dig(data, field) in (None, "", {}, []):
                    problems.append("%s: %s is required by %s"
                                    % (rel, field, schema["spec"]))
            for field in schema["forbidden"]:
                if field in data:
                    problems.append(
                        "%s: %s is not a field in %s. An undefined field is "
                        "read by nobody, and a diff that adds one looks like "
                        "a surface was wired when nothing was."
                        % (rel, field, schema["spec"]))
            for entry in data.get("plugins", []):
                label = entry.get("name", "<unnamed>")
                for field in schema["required_per_plugin"]:
                    if dig(entry, field) in (None, "", {}, []):
                        problems.append(
                            "%s: plugin %s is missing %s, required by %s"
                            % (rel, label, field, schema["spec"]))

        refs = []
        walk(data, set(path_keys), refs)
        for ref in refs:
            if ref.startswith(("http://", "https://")) or ref == "local":
                continue
            if not (base / ref).exists():
                problems.append("%s: declares %s, which does not exist "
                                "relative to %s"
                                % (rel, ref, base.relative_to(ROOT) or "."))

        if rel in VERSIONED:
            versions[rel] = data.get("version")
        checked += 1

    stated = {r: v for r, v in versions.items() if v}
    if len(set(stated.values())) > 1:
        problems.append(
            "manifests advertise different versions: "
            + "; ".join("%s=%s" % (r, v) for r, v in sorted(stated.items()))
            + ". One plugin ships one version, whichever host is asking.")
    for rel, v in versions.items():
        if not v:
            problems.append("%s: no version" % rel)

    if not (ROOT / "AGENTS.md").exists():
        problems.append("AGENTS.md: missing from the repository root — the "
                        "one instruction file every host reads")

    if problems:
        print("check-manifests: %d problem(s)" % len(problems),
              file=sys.stderr)
        for p in problems:
            print("  %s" % p, file=sys.stderr)
        return 1

    print("check-manifests: %d manifest(s) resolve, all at version %s"
          % (checked, sorted(set(stated.values()))[0] if stated else "?"))
    return 0


if __name__ == "__main__":
    sys.exit(main())
