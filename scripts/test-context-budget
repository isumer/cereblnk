#!/usr/bin/env python3
"""test-context-budget (CB-094) — the budget must follow the window.

The failure this guards: a number written into a policy while the
window was 128K, still there when the window became 96K. Every
assertion below is about the figures moving with their inputs, and
about a default never being mistaken for a measurement.
"""
import json, os, pathlib, shutil, subprocess, sys, tempfile

ROOT = pathlib.Path(__file__).resolve().parent.parent
CB = ROOT / "plugins/cereblnk/scripts/context-budget"


def run(args, env_extra=None, cwd=None):
    env = dict(os.environ)
    for k in ("CLAUDE_CODE_AUTO_COMPACT_WINDOW", "CLAUDE_CODE_MAX_OUTPUT_TOKENS",
              "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE", "CB_DIR"):
        env.pop(k, None)
    env.update(env_extra or {})
    return subprocess.run([sys.executable, str(CB)] + args,
                          capture_output=True, text=True, env=env, cwd=cwd)


def field(out, name):
    for line in out.splitlines():
        if line.strip().startswith(f"{name}:"):
            return line.split(":", 1)[1].split("#")[0].strip()
    return None


def main():
    bad = 0

    def check(name, ok, detail=""):
        nonlocal bad
        print(f"  {'ok' if ok else 'FAIL'}  {name}" + (f" — {detail}" if detail and not ok else ""))
        bad += 0 if ok else 1

    # capacity follows the window, not a constant
    a = run(["--window", "96000", "--output-reserve", "32000"])
    b = run(["--window", "200000", "--output-reserve", "32000"])
    check("capacity follows the window",
          field(a.stdout, "input_capacity") == "64000"
          and field(b.stdout, "input_capacity") == "168000",
          f"{field(a.stdout,'input_capacity')} / {field(b.stdout,'input_capacity')}")

    # a smaller reserve raises capacity
    c = run(["--window", "96000", "--output-reserve", "16000"])
    check("a smaller reserve raises capacity",
          int(field(c.stdout, "input_capacity")) > int(field(a.stdout, "input_capacity")))

    # wave size shrinks with capacity — the observed failure would have split
    check("wave size shrinks with capacity",
          int(field(a.stdout, "wave_size")) < int(field(b.stdout, "wave_size")),
          f"{field(a.stdout,'wave_size')} vs {field(b.stdout,'wave_size')}")

    d = run(["--window", "96000", "--output-reserve", "32000", "--agents", "5"])
    check("five agents at 64K split into two waves", field(d.stdout, "waves") == "2",
          field(d.stdout, "waves"))

    # environment is read, and is not reported as assumed
    e = run([], {"CLAUDE_CODE_AUTO_COMPACT_WINDOW": "96000",
                 "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "32000"})
    check("environment is read", field(e.stdout, "input_capacity") == "64000")
    check("measured input is not labelled assumed", "labelled: assumed" not in e.stdout)

    # a default announces itself
    f = run([])
    check("a default is labelled assumed", "labelled: assumed" in f.stdout)

    # settings.json is read when the environment is silent
    tmp = pathlib.Path(tempfile.mkdtemp(prefix="cb-budget-"))
    try:
        claude = tmp / ".claude"
        (claude / "cereblnk").mkdir(parents=True)
        (claude / "settings.json").write_text(json.dumps(
            {"env": {"CLAUDE_CODE_AUTO_COMPACT_WINDOW": "96000",
                     "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "16000"}}))
        g = run(["--cb-dir", str(claude / "cereblnk")])
        check("settings.json is read", field(g.stdout, "input_capacity") == "80000",
              field(g.stdout, "input_capacity"))
    finally:
        shutil.rmtree(tmp, ignore_errors=True)

    # settings wins over the shell, as Claude Code resolves them
    tmp2 = pathlib.Path(tempfile.mkdtemp(prefix="cb-prec-"))
    try:
        claude2 = tmp2 / ".claude"
        (claude2 / "cereblnk").mkdir(parents=True)
        (claude2 / "settings.json").write_text(json.dumps(
            {"env": {"CLAUDE_CODE_AUTO_COMPACT_WINDOW": "96000",
                     "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "32000"}}))
        k = run(["--cb-dir", str(claude2 / "cereblnk")],
                {"CLAUDE_CODE_AUTO_COMPACT_WINDOW": "200000",
                 "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "32000"})
        check("settings wins over the shell",
              field(k.stdout, "input_capacity") == "64000",
              field(k.stdout, "input_capacity"))
    finally:
        shutil.rmtree(tmp2, ignore_errors=True)

    # a reserve that swallows the window is refused, not silently clamped
    h = run(["--window", "32000", "--output-reserve", "32000"])
    check("an impossible reserve is refused", h.returncode == 2, f"rc={h.returncode}")

    # the platform's own compaction percentage is honoured
    i = run(["--window", "96000", "--output-reserve", "32000"],
            {"CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "50"})
    check("platform compaction percent is honoured",
          field(i.stdout, "checkpoint_at") == "32000", field(i.stdout, "checkpoint_at"))

    j = run(["--window", "96000", "--output-reserve", "32000", "--checkpoint-pct", "150"])
    check("an impossible percent is refused", j.returncode == 2, f"rc={j.returncode}")

    print("test-context-budget:", "all green" if bad == 0 else f"{bad} FAILURES")
    return 1 if bad else 0


if __name__ == "__main__":
    sys.exit(main())
