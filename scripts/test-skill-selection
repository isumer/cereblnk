#!/usr/bin/env python3
"""test-skill-selection — CB-097 acceptance, mechanical half.

Covers the three things that must hold for task-scoped skills to be
worth their complexity:
  1. the floor is computed from paths AND from request text
  2. the stack profile subtracts skills this project cannot use
  3. an agent that skips its floor cannot finish (SubagentStop, exit 2)

The hook cases assert the failure path too: a hook that never blocks
is a hook that enforces nothing (Part II trap #8 applied to hooks).

Usage: scripts/test-skill-selection
Exit:  0 all green · 1 any failure
"""
import os
import pathlib
import shutil
import subprocess
import sys
import tempfile

ROOT = pathlib.Path(__file__).resolve().parent.parent
PS = ROOT / "plugins/cereblnk/scripts"
HS = ROOT / "plugins/cereblnk/hooks/scripts"


def sh(cmd, stdin=None, env=None):
    e = dict(os.environ)
    if env:
        e.update(env)
    return subprocess.run(cmd, input=stdin, capture_output=True, text=True, env=e)


def main():
    results, bad = [], 0

    def case(name, ok, detail=""):
        nonlocal bad
        results.append(("  PASS  " if ok else "  FAIL  ") + name +
                       ("" if ok else " — " + detail))
        bad += 0 if ok else 1

    # ---- 1. path floor -------------------------------------------------
    r = sh(["bash", str(PS / "select-agents"),
            "src/main/java/com/acme/pay/PaymentService.java",
            "src/main/resources/db/changelog/v12-idempotency.xml"])
    case("path floor: java to backend, liquibase to database",
         r.returncode == 0
         and "backend-agent: [java" in r.stdout
         and "liquibase-migrations" in r.stdout
         and "gate_level: 3" in r.stdout,
         r.stdout[-200:])

    # a role never receives another role's skill
    case("path floor: database-agent does not receive java",
         "database-agent: [java" not in r.stdout, "role scoping leaked")

    # ---- 2. text floor -------------------------------------------------
    r = sh(["bash", str(PS / "select-agents"), "--text",
            "add idempotency to the payment service, java spring boot"])
    case("text floor: request alone selects java and spring-boot",
         r.returncode == 0 and "java" in r.stdout and "spring-boot" in r.stdout,
         r.stdout[-200:])

    # ---- 3. unresolved is a handoff, and never a silent guess ---------
    # T-DISC-21 reverses CB-133's exit-0 default. Nothing matched, so
    # the floor has nothing to force: the selector exits 3, names no
    # guessed specialist, and hands the roster to the conductor.
    r = sh(["bash", str(PS / "select-agents"), "--text", "good morning"])
    case("unresolved: exits 3 rather than guessing a specialist",
         r.returncode == 3, "rc=%d" % r.returncode)
    case("unresolved: the state is marked on stdout",
         "unresolved: true" in r.stdout, r.stdout[:80])
    case("unresolved: the roster is emitted in place of a guess",
         "roster:" in r.stdout and "cereblnk:engineering:architect-agent:" in r.stdout,
         r.stdout[-200:])
    case("unresolved: no specialists block is printed",
         "specialists:" not in r.stdout, r.stdout[:80])
    # the gap the risk gate would have existed for, closed at the rule
    r = sh(["bash", str(PS / "select-agents"), "--text", "rotate the secret"])
    case("secret rotation routes to security, not to the fallback",
         "security-agent" in r.stdout and "unresolved: true" not in r.stdout,
         r.stdout[:100])

    # ---- 4. stack gate -------------------------------------------------
    tmp = pathlib.Path(tempfile.mkdtemp(prefix="cb-skill-"))
    try:
        cb = tmp / ".claude/cereblnk"
        (cb / "context").mkdir(parents=True)
        (cb / "context/stack-profile.yaml").write_text(
            "tokens:\n  - java\n  - angular\nmanifests:\n  - pom.xml\n",
            encoding="utf-8")
        env = {"CLAUDE_PROJECT_DIR": str(tmp)}
        r = sh(["bash", str(PS / "select-agents"), "src/app/x.component.ts",
                "src/ui/Widget.jsx"], env=env)
        case("stack gate: angular selected, react withheld (not in stack)",
             r.returncode == 0 and "angular" in r.stdout and "react" not in r.stdout,
             r.stdout[-200:])

        # ---- 5. skill floor hook ---------------------------------------
        run = cb / "context/R-test"
        run.mkdir(parents=True)
        (run / "skills-required.yaml").write_text(
            "  backend-agent: [java, spring-boot]\n  qa-agent: [test-strategy]\n",
            encoding="utf-8")
        payload = '{"agent_type":"backend-agent","stop_hook_active":false}'

        r = sh(["bash", str(HS / "skill-floor.sh")], stdin=payload, env=env)
        case("floor hook: unmet floor blocks the stop (exit 2)",
             r.returncode == 2 and "java" in r.stderr and "spring-boot" in r.stderr,
             "rc=%d err=%s" % (r.returncode, r.stderr[:120]))

        r = sh(["bash", str(HS / "skill-floor.sh")],
               stdin='{"agent_type":"backend-agent","stop_hook_active":true}',
               env=env)
        case("floor hook: stop_hook_active always allows the stop",
             r.returncode == 0, "rc=%d" % r.returncode)

        # ledger records a load, then the floor is met
        for skill in ("java", "spring-boot"):
            r = sh(["bash", str(HS / "skill-ledger.sh")],
                   stdin='{"agent_type":"backend-agent","tool_input":{"skill":"cereblnk:%s"}}' % skill,
                   env=env)
        log = run / "skills-loaded.log"
        case("ledger hook: records agent and skill, never blocks",
             log.exists() and "backend-agent\tjava" in log.read_text(encoding="utf-8"),
             "log missing or unrecorded")

        r = sh(["bash", str(HS / "skill-floor.sh")], stdin=payload, env=env)
        case("floor hook: met floor allows the stop",
             r.returncode == 0, "rc=%d err=%s" % (r.returncode, r.stderr[:120]))

        # an agent with no required entry is not the hook's business
        r = sh(["bash", str(HS / "skill-floor.sh")],
               stdin='{"agent_type":"architect-agent"}', env=env)
        case("floor hook: no floor declared, no interference",
             r.returncode == 0, "rc=%d" % r.returncode)

        # cap: repeated failures disarm rather than loop
        (run / "skills-loaded.log").unlink()
        (run / "skill-floor.backend-agent.state").write_text("2", encoding="utf-8")
        r = sh(["bash", str(HS / "skill-floor.sh")], stdin=payload, env=env)
        case("floor hook: nudge cap reached, stop allowed (no loop)",
             r.returncode == 0, "rc=%d" % r.returncode)

        # ---- 6. detect-stack -------------------------------------------
        (tmp / "pom.xml").write_text(
            "<project><dependency><artifactId>spring-boot-starter-web"
            "</artifactId></dependency><dependency><artifactId>liquibase-core"
            "</artifactId></dependency></project>", encoding="utf-8")
        r = sh(["bash", str(PS / "detect-stack"), "--force", str(tmp)], env=env)
        case("detect-stack: manifest content yields spring-boot and liquibase",
             r.returncode == 0 and "- spring-boot" in r.stdout
             and "- liquibase" in r.stdout and "- java" in r.stdout,
             r.stdout[-200:])
    finally:
        shutil.rmtree(tmp, ignore_errors=True)

    # ---- 7. CB-143 / F-07: the surface specialist and its stack skills --
    # The measured failure: in a repository whose profile carries the
    # four Spring tokens, a request naming server-side behaviour
    # returned exactly what an empty repository returned —
    # apidesign-agent alone, api-design alone. The contract designer
    # was selected and the implementer was not, because no TEXT rule
    # carried request semantics for the server surface and because a
    # stack token could only ever subtract.
    #
    # This fixture pins both halves of the floor and the bound that
    # keeps the fix from becoming "any Java repository loads java":
    # the docs-only request in the SAME repository must stay clean.
    tmp = pathlib.Path(tempfile.mkdtemp(prefix="cb-f07-"))
    try:
        ctx = tmp / ".claude/cereblnk/context"
        ctx.mkdir(parents=True)
        (ctx / "stack-profile.yaml").write_text(
            "tokens:\n  - java\n  - maven\n  - spring-boot\n"
            "  - hibernate-jpa\nmanifests:\n  - pom.xml\n",
            encoding="utf-8")
        env = {"CLAUDE_PROJECT_DIR": str(tmp)}

        r = sh(["bash", str(PS / "select-agents"), "--text",
                "add a REST endpoint for user registration"], env=env)
        out = r.stdout
        case("F-07: server-side behaviour selects the implementer",
             r.returncode == 0 and "backend-agent" in out, out[:300])
        case("F-07: the contract designer is still selected",
             "apidesign-agent" in out and "api-design" in out, out[:300])
        backend_line = next((l for l in out.splitlines()
                             if l.strip().startswith("cereblnk:engineering:backend-agent:")), "")
        case("F-07: the implementer arrives with its stack skills",
             all(k in backend_line for k in ("java", "spring-boot", "hibernate-jpa")),
             "skills_required line was %r" % backend_line)
        case("F-07: a routed floor is never marked inferred",
             "inferred: true" not in out, out[:120])

        # the bound: stack completion adds skills to a routed role, it
        # never routes a role. A docs request in a Spring repository
        # gets neither backend-agent nor the java skill.
        r = sh(["bash", str(PS / "select-agents"), "--text",
                "update the README and the contributing guide"], env=env)
        case("F-07 bound: a docs request pulls no backend-agent",
             "backend-agent" not in r.stdout, r.stdout[:200])
        case("F-07 bound: a docs request pulls no stack skill",
             "java" not in r.stdout and "spring-boot" not in r.stdout,
             r.stdout[:200])

        # the other bound: an unroutable request gets the roster, never
        # a completed guess — stack completion must not resurrect a
        # silent default under a new name.
        r = sh(["bash", str(PS / "select-agents"), "--text", "good morning"],
               env=env)
        case("F-07 bound: the unresolved handoff gains no stack skills",
             "unresolved: true" in r.stdout and "skills_required:" not in r.stdout,
             r.stdout[:200])
    finally:
        shutil.rmtree(tmp, ignore_errors=True)

    print("test-skill-selection:")
    print("\n".join(results))
    if bad:
        print("test-skill-selection: %d case(s) failed" % bad, file=sys.stderr)
        return 1
    print("test-skill-selection: all green")
    return 0


if __name__ == "__main__":
    sys.exit(main())
