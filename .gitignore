__pycache__/
*.pyc
.claude/cereblnk/
.idea/
# CB-108: the leakage wordlist is never committed — a tracked wordlist
# publishes exactly the strings it exists to catch (check-leakage L-3).
.leakage-wordlist
*.iml
# host-probe recordings: evidence in progress, not a committed artefact
.cb-probe/

# runtime evidence: reproduced, never committed. The repository stores how
# to produce it; a particular run's results belong in CI artifacts, where
# they cannot become stale truth nobody re-derives.
tests/runtime/**/*.log
tests/runtime/**/summary.json
tests/runtime/**/evidence/
